// Hanken Grotesk is bundled rather than assumed: a desktop binary should look
// the same on a machine that has never installed it. It is published as one
// variable font, which Slint cannot load, so these are the static instances
// at the weights the design uses - Regular for body, Medium for titles,
// SemiBold and Bold for the headings, Italic for the one look that asks for
// it. The files live with the title painter (concat-text/fonts), which
// embeds the same five so a title is set in the face the interface is.
// Licensed under the SIL Open Font License; see LICENSE-HankenGrotesk.txt.
import { I18n } from "i18n.slint";
import "../../concat-text/fonts/HankenGrotesk-Regular.ttf";
import "../../concat-text/fonts/HankenGrotesk-Medium.ttf";
import "../../concat-text/fonts/HankenGrotesk-SemiBold.ttf";
import "../../concat-text/fonts/HankenGrotesk-Bold.ttf";
import "../../concat-text/fonts/HankenGrotesk-Italic.ttf";

import { Theme } from "theme/theme.slint";
import { Neon } from "theme/neon.slint";
import { Skins, SkinSpec } from "theme/skins.slint";
import { Bezier, Curves, Fmt, Focus, Payload } from "util.slint";
import { EffectData } from "demo/effects-panel.slint";
import {
    MediaFilter,
