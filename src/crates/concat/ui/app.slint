    TrackData,
    TrackSize,
} from "timeline/model.slint";

// Re-exported so main.rs can reach the globals and the struct.
import {
    KeyEditor,
    KeyMarkData,
    KeyRowData,
} from "workspace/keyframes-pane.slint";
import { SpeedRamp } from "inspector/speed-ramp.slint";

export {
    Curves,
    Fmt,
    Focus,
    Payload,
    Theme,
    Skins,
    SkinSpec,
    Bezier,
    Editor,
    I18n,
    AppliedEntryData,
    AppliedParamData,
    CatalogueEntryData,
    Library,
    LibraryViewData,
    ParamFormat,
    ChainChoiceData,
    TransitionChoiceData,
    DockDivider,
    DockSide,
    PaneKind,
    SeatBox,
    EffectData,
    FontSearch,
    CaptionStyles,
    Meters,
    MotionPose,
    MotionTile,
    MotionTiles,
    MediaFilter,
    MediaItemData,
    MediaKind,
    SourcePreview,
    TextPresetData,
    Backdrop,
    AssetCardData,
    Assets,
    BackdropData,
    ClipData,
    ClipField,
    ClipKeyData,
    ClipKind,
    ClipTextField,
    DropData,
    Keyframes,
    KeyEditor,
    KeyMarkData,
    KeyRowData,
    SpeedRamp,
    SelectedClipData,
    SelectedTransitionData,
    StageGuideData,
    StageItemData,
    TextAlignment,
    TimelineTabData,
    TimelineTool,
    TrackData,
    TrackSize,
    MenuItemData,
    MenuRow,
    ExportData,
    ExportPhase,
    ModelData,
    SettingsData,
    ChipOption,
    RecentProjectData,
    StartData,
    SystemFactData,
    ToastData,
    ProjectSheetData,
    CaptionsSheetData,
    SpeechSheetData,
    VoiceoverData,
    SoundCardData,
    Sounds,
    VoiceCardData,
    NewVoiceData,
    CloudData,
    CloudItem,
    AiData,
    AiPluginItem,
    AiVoiceItem,
}
export component App inherits Window {
    title: "鏄熺眮鍓緫 XingLai Cut";
    // The taskbar's and Alt-Tab's picture on Windows, and the window
    // list's on X11. A Mac takes its Dock icon from the bundle and ignores
    // this; the .exe's own, for Explorer, is embedded by build.rs.
    icon: @image-url("../../../../assets/icons/concat_logo_256.png");
    // Where the strip carries its own window buttons the platform's
    // decorations are not wanted, and this is the property Slint keeps
    // them off with: the winit backend re-applies `no-frame` to the
    // window after it is made, over whatever the attributes asked for, so
    // a hook alone left GNOME drawing its bar above ours:
    // https://github.com/jub0t/Concat/issues/97
    // https://github.com/jub0t/Concat/issues/145
    // Not for the phone shell on a desk, which draws no buttons of its own
    // and keeps the platform's bar above the phone's screen; see platform.rs.
    no-frame: root.own-window-buttons && !root.phone;
    background: Theme.page;
    default-font-family: Theme.font;
    default-font-size: Theme.fs;
    // One line rather than a weight on every Text: everything inherits the
    // compensated body weight, and only titles override it. See theme.slint.
    default-font-weight: Theme.weight-body;
    // A phone's window is its screen, whatever these say; on a desk asked
    // for the phone shell (CONCAT_PHONE, see platform.rs) they are a
    // phone's shape, so the layout is seen as a phone would show it.
    preferred-width: root.phone ? 420px : 1400px;
    preferred-height: root.phone ? 880px : 900px;
    // Below this the three columns cannot all hold their minimum and the panes
    // start eating each other. The phone shell has no columns, and a phone
    // is narrower than this on every side.
    min-width: root.phone ? 320px : 900px;
    min-height: root.phone ? 480px : 560px;
    // So the shortcuts work before anything has been clicked. Without it the
    // window opens with nothing focused, and a key would have nowhere to be
    // delivered from until the first press landed somewhere.
    forward-focus: keys;

    // The same hole opens again later, and `forward-focus` does not close
    // it: it is read once, when the window first focuses. Slint delivers a
    // key to the focused item and its ancestors, and when that item has
    // been torn down - the launch screen's name field once a project opens,
    // a sheet's field once the sheet closes - there is no item and the key
    // is dropped. Nothing walks up to `keys`, so every shortcut is dead
    // until a press lands on a pane's floor. Each of those teardowns hands
    // the focus back here on the way out.
    changed on-start => {
        if (!root.on-start) {
            keys.focus();
        }
    }
    property <bool> sheet-open: root.export.open || root.settings.open
        || root.project-sheet.open || root.captions.open || root.speech.open
        || root.start.composing || root.new-voice.open
        || root.ai.open || root.ai.wizard-open;
    changed sheet-open => {
        if (!root.sheet-open) {
            keys.focus();
        }
    }

    // The editor's own state and actions live on the Editor global rather
    // than here 鈥?see editor.slint. What is left on the window is the window:
    // its title bar, its menus, and the two sheets that cover everything.

    // 鈹€鈹€ the launch screen 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
    //
    // Which screen the window is showing. The editor is not built until a
    // project exists, so nothing behind this is instantiated meanwhile 鈥?and
    // the workspace, when it does arrive, arrives with every callback already
    // bound rather than during the window's own construction.
    in property <bool> on-start: true;
    in property <StartData> start;
    in property <[ChipOption]> start-aspects;
    in property <[ChipOption]> start-sizes;
    in property <[ChipOption]> start-rates;
    in property <[RecentProjectData]> recents;

    /// Put up the new-project sheet, and take it down again.
    callback start-compose();
    callback start-dismiss();
    callback start-name-edited(name: string);
    callback start-location-edited(path: string);
    callback start-browse();
    callback start-aspect-changed(index: int);
    callback start-size-changed(index: int);
    callback start-rate-changed(index: int);
    callback start-custom-width-edited(width: float);
    callback start-custom-height-edited(height: float);
    callback start-custom-fps-edited(fps: float);
    callback start-canvas-changed(value: color);
    callback start-create();
    /// Open a project that already exists, picked from disk.
    callback start-open();
    /// Make a project of a CapCut draft (#477).
    callback start-import-capcut();
    callback start-open-recent(path: string);
    callback start-forget-recent(path: string);
    callback start-reveal-recent(path: string);
    callback start-search-edited(query: string);
    callback start-sort-changed(sort: int);
    /// One of the launch screen's links, by name; see `start::link`.
    callback start-link(name: string);
    callback start-dismiss-error();
    /// How many projects the recents list holds, before the search: the
    /// grid's search and sort come up past a page of them.
    in property <int> recents-total;
    /// "0.2.7", for the launch screen's version line.
    in property <string> app-version;
    /// A file can be dragged in from the system: a desk, not a phone.
    in property <bool> can-drop;
    /// CapCut keeps drafts on this machine; see `concat_host::capcut`.
    in property <bool> capcut;

    // 鏄熺眮 AI 璐﹀彿锛岃 concat_host::account锛氱櫥褰曚簡娌℃湁锛屽彨璋侊紝浠€涔堝椁愶紝
    // 鍒版湡鍝ぉ锛屽嚭閿欒浠€涔堛€傜櫥褰曞湪鍚庡彴绾跨▼閲屽仛锛屽洖鏉ョ殑璺笂鎶婅繖鍑犳牱鍐欏ソ銆?
    in property <bool> account-signed-in;
    in property <string> account-name;
    in property <string> account-plan;
    in property <string> account-expire;
    in property <string> account-error;
    in property <bool> account-busy;
    /// 璐﹀彿鐧诲綍寮圭獥锛欰I 闈㈡澘鐨勩€屽幓鐧诲綍銆嶆垨浜戠鏈櫥褰曟椂鐨勫紩瀵兼妸瀹冩墦寮€锛?
    /// 棣栧睆鍙充笂瑙掔殑璐﹀彿 chip 鑷繁杩樻湁涓€寮狅紙瑙?start.slint锛夈€?
    in property <bool> account-sheet;
    callback account-sign-in(phone: string, password: string);
    callback account-sign-out();
    callback account-sheet-closed();
    /// AI 闈㈡澘閲岀殑銆屽幓鐧诲綍銆嶃€?
    callback ai-login();

    // Title bar. The drag/maximize pair must be handled in main.rs 鈥?a window
    // cannot drag itself from inside the scene graph; the rest are seams like
    // the library callbacks above.
    in property <string> project-name: I18n.t("common.untitledProject");
    in property <string> project-status: I18n.t("common.saved");

    // 宸ョ▼浜戝悓姝ワ細闈㈡澘鐨勭姸鎬佷笌鍒楄〃锛岀敱 Rust 鍦ㄥ悗鍙板彇鍥炲悗鍐欒繘鏉ャ€?
    in property <[CloudItem]> cloud-items;
    in property <bool> cloud-open;
    in property <bool> cloud-busy;
    in property <string> cloud-status;
    in property <string> cloud-url;
    callback cloud-closed();
    callback cloud-refresh();
    callback cloud-save();
    callback cloud-open-pid(pid: string, name: string);
    callback cloud-open-url();

    // 剪映草稿互通与 XML 导出：文件菜单的几行，与「导出为可编辑草稿」一表。
    in property <bool> interop-open;
    in property <bool> interop-busy;
    in property <bool> interop-jianying;
    in property <string> interop-status;
    in property <string> interop-folder;
    in property <string> interop-hint;
    callback interop-closed();
    callback interop-export-jianying();
    callback interop-export-xml();
    callback interop-reveal();
    callback interop-sync();

    // 专业后期底座（0.3.6）：示波器 / 色彩管理 / QC / 媒体校验 / 快照 /
    // 交付包。数据全由 Rust 写进 PostData 与四张表；动作合成一条
    // post-action 回调，接线方式与电影向导相同。
    in property <PostData> post;
    in property <[PostLutItem]> post-luts;
    in property <[PostRow]> post-qc-rows;
    in property <[PostRow]> post-check-rows;
    in property <[PostRow]> post-snapshot-rows;
    in property <[CommandItem]> command-items;
    in property <string> command-first;
    in property <bool> palette-open;
    callback post-closed();
    callback post-action(action: string, index: int, text: string);
    /// 示波器 / 调色预览的定时取帧：面板开着才由 Slint 的 Timer 打过来。
    callback post-tick();
    callback palette-closed();
    callback palette-query-edited(text: string);
    callback palette-chosen(id: string);

    // 影视专业面板（0.3.7）：九块原生面板。启动路径上只有一份空的 ProData，
    // 面板打开后才按当前页取数；动作合成一条 pro-action 回调。
    in property <ProData> pro;
    in property <[ProShotRow]> pro-text-shots;
    in property <[ProPlanShot]> pro-plan-shots;
    in property <[ProModelRow]> pro-models;
    in property <[ProTierRow]> pro-tiers;
    in property <[ProRow]> pro-mon-types;
    in property <[ProRow]> pro-mon-episodes;
    in property <[ProBoardShot]> pro-board;
    in property <[ProRow]> pro-takes;
    in property <[ProRow]> pro-notes;
    in property <[ProRow]> pro-cont-rows;
    in property <[ProRow]> pro-retake-reasons;
    in property <[ProRow]> pro-retake-queue;
    in property <[ProRow]> pro-audit-rows;
    in property <[ProRow]> pro-dramas;
    in property <[ProRow]> pro-dists;
    in property <[ProRow]> pro-dist-files;
    in property <[ProRow]> pro-dist-steps;
    in property <[string]> pro-dist-drama-labels;
    in property <[ProRow]> pro-pass-rows;
    in property <[ProRow]> pro-pass-verify-rows;
    in property <[ProRow]> pro-pass-recent;
    in property <[ProFinding]> pro-findings;
    in property <[ProRow]> pro-sb-platforms;
    in property <[ProRow]> pro-sb-history;
    in property <[ProPluginRow]> pro-plugins;
    in property <[ProRow]> pro-plugin-mine;
    in property <[ProTemplateRow]> pro-templates;
    in property <[string]> pro-tpl-industries;
    in property <[string]> pro-tpl-scenes;
    in property <[ProTaskRow]> pro-tasks;
    callback pro-action(action: string, index: int, text: string);
    /// 面板定时拍：轮询进行中的导演 / 模板任务与任务中心。
    callback pro-tick();
    callback pro-closed();

    // 鏄熺眮 AI锛氭湰鍦颁紭鍏堢殑绠楀姏閫夋嫨銆佹湰鍦伴厤闊筹紙Piper 鎻掍欢锛夈€佺収鐗囨暟瀛椾汉銆?
    // 鎻掍欢绠＄悊锛屼互鍙婇粯璁ゅ叧闂殑浜戠鍏滃簳銆傜姸鎬佷笌涓ゅ垪鐢?Rust 鍐欏ソ锛涜繖閲屽彧杞彂銆?
    in property <AiData> ai;
    /// AI 鐢熻棰戯紙AI 闈㈡澘绗?4 椤碉級鐨勭姸鎬併€?
    in property <AiVideoData> ai-video;
    in property <[string]> ai-video-models;
    in property <[string]> ai-video-locals;
    // AI 工作室（0.3.0）：一键成片 / 动态解说 / 爆款复刻。面板懒加载：
    // 清单只在打开时取，启动路径上没有它的网络工作。
    in property <AiStudioData> ai-studio;
    in property <[string]> ai-studio-persons;
    in property <[string]> ai-studio-pages;
    in property <[string]> ai-studio-shots;
    in property <[string]> ai-studio-slots;
    in property <[string]> ai-studio-versions;
    callback ai-studio-action(action: string, index: int, text: string);
    // AI 短剧（0.3.1）：多集剧本 / 分镜 / 逐集成片。桌面为主，网页仅备用。
    // 面板懒加载：后端状态只在打开时探一次，启动路径上没有它的网络工作。
    in property <AiDramaData> ai-drama;
    in property <[string]> ai-drama-episodes;
    in property <[string]> ai-drama-scenes;
    in property <[string]> ai-drama-characters;
    in property <[string]> ai-drama-outputs;
    in property <[string]> ai-drama-history;
    callback ai-drama-action(action: string, index: int, text: string);
    // 电影 / 剧集制作向导（0.3.5）：15 步傻瓜式流程 + 两条生成链。面板懒加载：
    // 类型表只在打开时取一次，启动路径上没有它的网络工作。
    in property <MovieData> movie;
    in property <[string]> movie-types;
    in property <[string]> movie-shots;
    in property <[string]> movie-chars;
    in property <[string]> movie-scenes;
    in property <[string]> movie-tasks;
    in property <[string]> movie-takes;
    in property <[string]> movie-delivery;
    in property <[int]> movie-done;
    callback movie-action(action: string, index: int, text: string);
    // 左侧 AI 助手常驻栏（0.3.1，简版）：建议类对话 + 快捷指令。
    in property <AssistantData> assistant;
    in property <[string]> assistant-messages;
    callback assistant-toggle();
    callback assistant-send(text: string);
    callback assistant-quick(command: string);
    callback assistant-input(text: string);
    callback assistant-mode(index: int);
    in property <[AiVoiceItem]> ai-voices;
    in property <[string]> ai-voice-names;
    in property <[AiPluginItem]> ai-plugins;
    in property <image> ai-photo;
    callback ai-closed();
    callback ai-tab-changed(tab: int);
    callback ai-text-edited(text: string);
    callback ai-voice-changed(index: int);
    callback ai-rate-changed(value: float);
    callback ai-engine-changed(engine: int);
    callback ai-generate();
    callback ai-preview();
    callback ai-cancel();
    callback ai-mode-changed(index: int);
    callback ai-redetect();
    callback ai-wizard-local();
    callback ai-wizard-cloud();
    callback ai-wizard-close();
    callback ai-plugin-import();
    callback ai-plugin-download(id: string);
    callback ai-plugin-open(id: string);
    callback ai-plugin-remove(id: string);
    callback ai-plugin-refresh();
    callback ai-photo-pick();
    callback ai-photo-clear();
    callback ai-confirm-yes();
    /// AI 鐢熻棰戦〉鐨勪竴涓姩浣滐細action + 涓嬫媺涓嬫爣 + 鏂囨湰銆?
    callback ai-video-action(action: string, index: int, text: string);
    callback ai-confirm-no();
    in property <bool> macos;
    /// The window is a phone's: one screen, held upright, driven by a
    /// finger. The editor is then the phone shell (ui/phone/) - no title
    /// strip, no dock - and the launch screen carries its own verbs, as it
    /// does whenever it is narrow. Set once from Rust; see platform::phone.
    in property <bool> phone;
    /// A sheet with pages of its own is the whole window, inside its safe
    /// area, on a phone and in any window too narrow for it to float as a
    /// card with room around it.
    property <bool> sheets-fill: root.phone || root.width < 600px;
    /// Where the sheets start. Under the strip wherever the strip carries
    /// the window's own buttons: a sheet over the whole window covered
    /// them, and an export left a window that could not be minimised,
    /// moved or closed until it was done (#751). Over it on a Mac, whose
    /// traffic lights are the window's and float over any sheet, and on a
    /// phone, which has no strip.
    property <length> sheets-top: !root.phone && root.own-window-buttons ? 32px : 0px;
    /// A sheet is up. The strip keeps the window's buttons and its drag
    /// then, and nothing that acts on what the sheet covers.
    property <bool> sheet-up: root.start.composing || root.export.open || root.settings.open
        || root.project-sheet.open || root.new-voice.open || root.relink.open
        || root.confirm.open || root.ai.open || root.ai-studio.open
        || root.ai-drama.open || root.movie.open || root.ai.wizard-open || root.account-sheet
        || root.post.open || root.palette-open;
    /// Which floating tool card is in front: "captions" or "speech". The
    /// one opened or grabbed last; Escape closes it first.
    property <string> front-tool: "captions";

    /// The File / Edit / View menus. Built in Rust like every other menu here,
    /// because what belongs on them depends on the project.
    in property <int> open-menu: -1;
    in property <[MenuItemData]> app-menu-items;
    in property <length> app-menu-height;
    in property <int> app-menu-token;
    callback menu-opened(index: int);
    callback app-menu-selected(id: string);

    callback titlebar-begin-drag();
    callback titlebar-toggle-maximize();
    /// The strip's own window buttons, where the platform's decorations were
    /// taken off; see platform.rs.
    callback titlebar-minimize();
    callback titlebar-close();
    /// Draw minimise / maximise / close on the strip. False on macOS, where
    /// the traffic lights are the window's own.
    in property <bool> own-window-buttons;
    /// Read back from the platform on every resize, so the strip can show
    /// restore rather than maximise - whichever route maximised it.
    in-out property <bool> window-maximized;
    callback window-resized();
    changed width => { root.window-resized(); }
    // The height goes to the Panes global as well: the menus hung under the
    // pane buttons measure the room beneath them against it, and nothing
    // below the Window can read the Window.
    changed height => {
        Panes.window-height = self.height;
        root.window-resized();
    }
    init => { Panes.window-height = self.height; }
    // The dialogs. Both are held at the root because Slint has no portal: a
    // modal has to be declared where it is drawn, and it is drawn over
    // everything.
    in property <ExportData> export;
    in property <SettingsData> settings;
    in property <[ModelData]> transcribers;
    in property <[ModelData]> voices;
    in property <[string]> versions;
    in property <[string]> version-details;
    in property <[string]> languages;
    /// Settings > About's copyable block. Gathered once in main.rs and
    /// never republished 鈥?every line of it is fixed for the life of the
    /// process.
    in property <[SystemFactData]> system-facts;
    in property <string> system-report;
    /// The last few launches, phase by phase: what Settings > About's
    /// "launch diagnostics" block draws. See startup_report.rs.
    in property <[SystemFactData]> startup-facts;

    callback export-closed();
    callback export-name-edited(name: string);
    callback export-browse();
    callback export-rate-changed(index: int);
    callback export-codec-changed(index: int);
    callback export-ten-bit-changed(on: bool);
    callback export-hdr-changed(on: bool);
    callback export-bitrate-changed(mbps: float);
    callback export-start();
    callback export-cancel();
    callback export-reveal();
    callback export-enable-ai-badge();
    callback export-quality-changed(index: int);
    callback export-matrix-toggled(on: bool);
    callback export-matrix-count-changed(delta: int);
    /// AI 成片 4K 超分（0.3.5）：打开时按 4K 导出，标注「超分非原生」。
    callback export-upscale-changed(on: bool);
    callback export-again();

    callback settings-closed();
    callback settings-page-changed(index: int);
    callback settings-ai-badge-changed(on: bool);
    callback settings-watermark-changed(on: bool);
    callback settings-watermark-pick();
    callback settings-watermark-remove();
    callback settings-watermark-position-changed(index: int);
    callback settings-watermark-opacity-changed(value: float);
    callback settings-watermark-size-changed(value: float);
    /// 鎵撳紑 AGPL 璁稿彲璇佹垨婧愮爜椤甸潰銆?
    callback settings-open-license(url: string);
    callback settings-show-log();
    callback settings-clear-asset-cache();
    callback settings-clear-plugin-cache();
    callback settings-language-changed(index: int);
    callback settings-log-level-changed(index: int);
    callback settings-theme-changed(dark: bool);
    /// 主题皮肤：gallery 选中的下标（Theme.skins）。
    callback settings-skin-changed(index: int);
    /// 图库分组 / 搜索词（Rust 过滤 `Theme.skin-filtered`）。
    callback settings-skin-group-changed(index: int);
    callback settings-skin-query-changed(text: string);
    /// 动态背景开关。
    callback settings-motion-changed(on: bool);
    /// 低配模式（风景静态）。
    callback settings-low-power-changed(on: bool);
    /// 首页两侧装饰：0 关 / 1 动态 / 2 低配静态。
    callback settings-side-art-changed(index: int);
    /// 面板流光边框：总开关 / 强度 / 风格。
    callback settings-neon-changed(on: bool);
    callback settings-neon-intensity-changed(index: int);
    callback settings-neon-style-changed(index: int);
    callback settings-accent-changed(index: int);
    callback settings-accent-custom-changed(colour: color);
    callback settings-playhead-changed(colour: color);
    callback settings-playhead-chosen(index: int);
    callback settings-scale-changed(index: int);
    callback settings-playhead-stops-changed(on: bool);
    callback settings-proxies-changed(on: bool);
    callback settings-remember-layout-changed(on: bool);
    callback settings-gpu-changed(on: bool);
    callback settings-ai-mode-changed(index: int);
    callback settings-ai-redetect();
    callback settings-magnetic-changed(on: bool);
    callback settings-download-source-changed(index: int);
    callback settings-download-base-edited(text: string);
    callback settings-server-enabled-changed(on: bool);
    callback settings-server-host-edited(text: string);
    callback settings-server-port-edited(port: int);
    callback settings-server-token-edited(text: string);
    callback settings-server-token-generated();
    callback settings-check-updates();
    callback settings-version-chosen(index: int);
    callback settings-install-version();
    callback settings-install-cancel();
    /// The Shortcuts page: a row asked to capture the next keys, and the
    /// two ways out of a change 鈥?put one row back, or put them all back.
    callback settings-shortcut-capture(id: string);
    callback settings-shortcut-reset(id: string);
    callback settings-shortcut-reset-all();
    callback model-activated(id: string);
    callback model-download(id: string);
    callback model-cancel(id: string);
    callback model-remove(id: string);
    callback model-open-link(id: string);
    callback model-choose-file(id: string);

    callback open-settings();
    callback export-clicked();

    /// The project sheet, opened from the Details panel.
    in property <ProjectSheetData> project-sheet;
    callback project-closed();
    callback project-name-edited(name: string);
    callback project-size-changed(index: int);
    callback project-rate-changed(index: int);
    callback project-custom-width-edited(width: float);
    callback project-custom-height-edited(height: float);
    callback project-custom-fps-edited(fps: float);
    callback project-color-space-changed(index: int);
    callback project-canvas-changed(value: color);
    callback project-apply();

    /// The two speech sheets: captions from a clip's sound, and a title's
    /// words - or any words - read aloud. Their option lists come from what
    /// is installed, so they are handed over as models.
    in property <CaptionsSheetData> captions;
    in property <[string]> caption-models;
    in property <[string]> caption-languages;
    callback captions-closed();
    callback captions-voice-toggled(on: bool);
    callback captions-source-changed(index: int);
    callback captions-text-edited(text: string);
    callback captions-model-changed(index: int);
    callback captions-language-changed(index: int);
    callback captions-placement-changed(index: int);
    callback captions-size-changed(index: int);
    callback captions-begin();
    callback captions-cancel();
    callback captions-import-srt();
    callback captions-export-srt();
    callback captions-find-edited(text: string);
    callback captions-replace-edited(text: string);
    callback captions-replace-scope-changed(index: int);
    callback captions-replace-pressed();

    in property <SpeechSheetData> speech;
    in property <[string]> speech-models;
    in property <[string]> speech-model-details;
    in property <[string]> speech-voices;
    in property <[string]> speech-voice-details;
    /// Each voice's avatar; see Avatar.
    in property <[AvatarData]> speech-voice-avatars;
    /// The recordings in the bin a voice can be taken from: their names,
    /// their waveforms as path commands, and their lengths.
    in property <[string]> speech-samples;
    in property <[string]> speech-sample-waves;
    in property <[string]> speech-sample-details;
    callback speech-closed();
    callback speech-text-edited(text: string);
    callback speech-voice-changed(index: int);
    callback speech-model-changed(index: int);
    callback speech-speed-changed(value: float);
    callback speech-reference-start-changed(seconds: float);
    callback speech-use-sample-changed(on: bool);
    callback speech-sample-changed(index: int);
    /// See SpeechDialog.insert-tag: a string cut Rust does for the sheet.
    pure callback speech-insert-tag(text: string, tag: string, at: int) -> string;
    callback speech-begin();
    callback speech-cancel();
    callback speech-save-name-edited(name: string);
    callback speech-pick-picture();
    callback speech-save-voice();
    callback speech-clear-style();

    /// The Voices shelf's New voice sheet: a recording picked to be kept
    /// as a voice; see NewVoiceDialog.
    in property <NewVoiceData> new-voice;
    callback new-voice-closed();
    callback new-voice-name-edited(name: string);
    callback new-voice-description-edited(text: string);
    callback new-voice-start-changed(seconds: float);
    callback new-voice-pick-picture();
    callback new-voice-save();

    /// The voiceover panel; see VoiceoverPanel. Its meter and clock come
    /// on the Editor global, from a timer.
    in property <VoiceoverData> voiceover;
    in property <[string]> voiceover-devices;
    callback voiceover-closed();
    callback voiceover-action(verb: string);
    callback voiceover-device-changed(index: int);
    callback voiceover-countdown-changed(on: bool);
    callback voiceover-mute-changed(on: bool);
    callback voiceover-gain-changed(db: float);
    callback voiceover-prompt-edited(text: string);
    callback voiceover-prompt-speed-changed(index: int);

    /// Takes focus back from whatever field holds it. The keyboard scope is
    /// where focus rests when nothing is being typed into, so giving it the
    /// focus is what "click beside the field" means. Rust calls this for
    /// every press a pane reports through Editor.blur, and - from the raw
    /// window events, before Slint routes the press (platform.rs) - for
    /// every press that is not on the text input holding the focus, so a
    /// click on a clip, a knob or the monitor ends the editing too.
    public function blur() {
        keys.focus();
    }

    // The strip's menus from the keyboard, the way Windows and Linux reach
    // a menu bar: F10 opens File, Alt with a menu's letter opens that one,
    // and in an open menu the arrows, Return and Escape do the rest. A Mac
    // has its own conventions for this and none of them are these.
    property <int> keyboard-menu: -1;
    property <int> keyboard-menu-token;
    property <bool> menu-by-keyboard;
    function open-menu-from-keys(index: int) {
        root.keyboard-menu = index;
        root.keyboard-menu-token += 1;
    }

    /// The bottom-right notice: what just happened, said once. Set from Rust
    /// and watched by its token 鈥?see ToastLayer, which owns the timing.
    in property <ToastData> toast;
    /// The notice with this token has gone from the screen.
    callback toast-gone(int);

    // The level feed is a Rust timer, and a property cannot reach across to
    // stop it, so the hover edge is forwarded as a callback: Rust arms the
    // timer on the way in and disarms it on the way out. Idle then costs
    // nothing, because nothing is dirtying a property.
    callback meter-watched-changed(watched: bool);
    changed meter-watched => {
        root.meter-watched-changed(root.meter-watched);
    }
    // Left unbound. A seat may hold two ConfigPanes or none, so there is no
    // single hover flag for this to read. Nothing sets it, so the level timer
    // in main.rs stays disarmed.
    out property <bool> meter-watched;
    /// The same seam, and just as idle. main.rs reads it on every tick.
    out property <bool> muted;

    // The window's keyboard, and the thing focus falls back to.
    //
    // It wraps the content rather than sitting beside it, and both of its jobs
    // come out of that:
    //
    //   - Clicking anything that is not a control blurs the one that had
    //     focus, the way a browser does. Slint holds focus until something
    //     else takes it, so without somewhere for it to land a number field
    //     stays in its editing state 鈥?ring and all 鈥?for the rest of the
    //     session. Every real control is inside this and takes its own press
    //     first; what reaches here is a press on nothing, and a FocusScope
    //     takes focus on one.
    //   - A key goes to the focused element first and walks up the ancestors
    //     with whatever that one rejects, so the bindings below only fire when
    //     nothing in the window wanted the keystroke. A field that is being
    //     typed into keeps its keys, and that comes from the delivery order
    //     rather than from a check on the target.
    //
    // `Control` in a binding is the platform's own command modifier: Slint
    // remaps it to 鈱?on macOS and leaves it Ctrl on Windows and Linux, and
    // the menu row beside it is written from the same keys (platform.rs,
    // `keys`), so what a row says is what works on the machine it is on.
    //
    // What still lives in bindings here is the window's own: the menu
    // bar's F10 and Alt+F/E/V/A, and opening, closing and quitting. A
    // binding on this scope is matched before `key-pressed` below runs,
    // so these hold their keys whatever the keymap says 鈥?which is why
    // Settings 鈥?Shortcuts turns those chords away rather than letting a
    // row claim a key that would not answer to it. Every other shortcut
    // is one table in Rust now (src/keymap.rs), rebindable there and
    // reached through `key-pressed`.
    keys := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-tab-navigation: false;

        // The editor's chords were bound here, one KeyBinding apiece 鈥?
        // save, undo, redo, split, copy and the rest. They are the
        // keymap's now: a person moves one in Settings 鈥?Shortcuts, and
        // the key, the menu row's label and the dispatch all follow it.
        KeyBinding {
            keys: @keys(F10);
            enabled: !root.on-start && !root.macos && !root.phone;
            activated => { root.open-menu-from-keys(0); }
        }

        KeyBinding {
            keys: @keys(Alt + F);
            enabled: !root.on-start && !root.macos && !root.phone;
            activated => { root.open-menu-from-keys(0); }
        }

        KeyBinding {
            keys: @keys(Alt + E);
            enabled: !root.on-start && !root.macos && !root.phone;
            activated => { root.open-menu-from-keys(1); }
        }

        KeyBinding {
            keys: @keys(Alt + V);
            enabled: !root.on-start && !root.macos && !root.phone;
            activated => { root.open-menu-from-keys(2); }
        }

        KeyBinding {
            keys: @keys(Alt + A);
            enabled: !root.on-start && !root.macos && !root.phone;
            activated => { root.open-menu-from-keys(3); }
        }
        // Open and leaving work from the launch screen too: it opens
        // projects, and it is a window.
        KeyBinding {
            keys: @keys(Control + O);
            activated => { root.app-menu-selected("open"); }
        }
        // 鈱榃 closes the window on a Mac. Elsewhere Ctrl+W closes the
        // document - the project - and Ctrl+Q quits; Windows' Alt+F4 is
        // the system's, and arrives as the window's close request.
        KeyBinding {
            keys: @keys(Control + W);
            enabled: root.macos || !root.on-start;
            activated => {
                root.app-menu-selected(root.macos ? "close-window" : "close-project");
            }
        }

        KeyBinding {
            keys: @keys(Control + Q);
            enabled: !root.macos;
            activated => { root.app-menu-selected("close-window"); }
        }
        // Everything the keymap owns lands here only when nothing else
        // took it - a field being typed into consumes its own letters and
        // spaces before a key can walk up to this scope, which is what
        // keeps typing a title from cutting a clip, and the bindings above
        // take theirs before this runs. The event crosses raw: the text
        // and the modifier flags, because the chord, the action it names
        // and where that dispatches are one table in Rust (keymap.rs),
        // and the capture field in Settings > Shortcuts listens on this
        // same callback. False lets the key go on up, so Escape still
        // closes a popup and Tab still moves focus.
        key-pressed(event) => {
            // Escape closes the sheet on top, as its 脳 does. A sheet busy
            // with a job keeps itself - its 脳 is gone then too - and the
            // key is spent on it, not passed to the editor underneath.
            // Android's Back is the same key on a phone: unhandled, Slint
            // finishes the activity, so Back with Export or a sheet open
            // quit the app, a running export with it.
            if (event.text == Key.Escape || event.text == Key.Back) {
                if (root.confirm.open) { root.confirm-dismissed(); return accept; }
                if (root.relink.open) { root.relink-dismiss(); return accept; }
                if (root.new-voice.open) {
                    if (!root.new-voice.saving) { root.new-voice-closed(); }
                    return accept;
                }
                if (root.project-sheet.open) { root.project-closed(); return accept; }
                if (root.settings.open) { root.settings-closed(); return accept; }
                if (root.export.open) {
                    if (root.export.phase != ExportPhase.running) { root.export-closed(); }
                    return accept;
                }
                if (root.start.composing) {
                    if (!root.start.busy) { root.start-dismiss(); }
                    return accept;
                }
                // The tool cards, under the sheets: the one in front first.
                // A floating card closes with its job running, which goes
                // on and is there again when it is opened; a phone's sheet
                // busy with a job keeps itself, as its 脳 is gone.
                if (root.speech.open && (root.front-tool == "speech" || !root.captions.open)) {
                    if (!root.sheets-fill || !root.speech.running) { root.speech-closed(); }
                    return accept;
                }
                if (root.captions.open) {
                    if (!root.sheets-fill || !root.captions.running) { root.captions-closed(); }
                    return accept;
                }
                // A look being shown over the picture, and nothing above it.
                if (Editor.library-audition != "") {
                    Editor.library-audition-filter(Editor.library-audition);
                    return accept;
                }
            }
            // The phone editor's own sheet - Effects, Text, a clip's tools -
            // comes down before Back leaves the project.
            if ((event.text == Key.Back || event.text == Key.Escape) && root.phone && PhoneSheets.open) {
                PhoneSheets.close-asked += 1;
                return accept;
            }
            // Back with nothing on top: the editor saves and goes back to
            // the launch screen, as a phone editor's Back returns to its
            // projects. On the launch screen it goes on up, and Android
            // leaves the app.
            if (event.text == Key.Back) {
                if (!root.on-start) {
                    root.app-menu-selected("close-project");
                    return accept;
                }
                return reject;
            }
            if (Editor.key-chord(event.text, event.modifiers.shift, event.modifiers.alt,
                    event.modifiers.control, event.modifiers.meta, root.on-start)) {
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            // Inside the system's own bars. A phone or a tablet draws the
            // window edge to edge, under the status bar and the home
            // indicator, and the window says how far each reaches in; the
            // title strip and everything under it start below it, and the
            // ground shows through behind the bars. Zero on a desktop.
            padding-top: root.safe-area-insets.top;
            padding-bottom: root.safe-area-insets.bottom;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;

            // No strip on a phone: its menus, its window buttons and its
            // drag region are all a desk's, and the phone shell's top bar
            // carries the two verbs that are not.
            if !root.phone: TitleBar {
                macos: root.macos;
                minimal: root.on-start;
                deep: root.on-start;
                project-name: root.project-name;
                status: root.project-status;

                menu: root.open-menu;
                keyboard-menu: root.keyboard-menu;
                keyboard-token: root.keyboard-menu-token;
                menu-opened(index, at-x, keyboard) => {
                    // Under the strip, which is 32px tall - both measured
                    // from the window's corner, past the system's bars.
                    appmenu.request-x = at-x + root.safe-area-insets.left;
                    appmenu.request-y = 32px + root.safe-area-insets.top;
                    root.menu-by-keyboard = keyboard;
                    root.menu-opened(index);
                }

                own-buttons: root.own-window-buttons;
                covered: root.sheets-top > 0 && root.sheet-up;
                // A close goes the way every close does: the project is
                // saved and a running export is cancelled. One click on the
                // corner is not a way to lose a long export, so Close
                // waits for it, as the sheet's own 脳 does.
                can-close: root.export.phase != ExportPhase.running;
                maximized: root.window-maximized;
                begin-drag => { root.titlebar-begin-drag(); }
                toggle-maximize => { root.titlebar-toggle-maximize(); }
                minimize => { root.titlebar-minimize(); }
                close => { root.titlebar-close(); }
                open-settings => { root.open-settings(); }
                add-pane(kind) => { Editor.dock-add(kind); }
                export-clicked => { root.export-clicked(); }
            }

            if root.on-start: StartScreen {
                vertical-stretch: 1;

                recents: root.recents;
                recents-total: root.recents-total;
                query: root.start.query;
                sort: root.start.sort;
                busy: root.start.busy;
                phone: root.phone;
                version: root.app-version;
                can-drop: root.can-drop;
                capcut: root.capcut;
                signed-in: root.account-signed-in;
                account-name: root.account-name;
                account-plan: root.account-plan;
                account-expire: root.account-expire;
                account-error: root.account-error;
                account-busy: root.account-busy;
                sign-in(phone, password) => { root.account-sign-in(phone, password); }
                sign-out => { root.account-sign-out(); }

                compose => { root.start-compose(); }
                open => { root.start-open(); }
                import-capcut => { root.start-import-capcut(); }
                open-settings => { root.open-settings(); }
                open-recent(path) => { root.start-open-recent(path); }
                forget-recent(path) => { root.start-forget-recent(path); }
                reveal-recent(path) => { root.start-reveal-recent(path); }
                search-edited(query) => { root.start-search-edited(query); }
                sort-changed(sort) => { root.start-sort-changed(sort); }
                link(name) => { root.start-link(name); }
            }

            // 星籁 0.3.1：剪映 11.9 的「助手常驻」结构——左侧一条 AI 助手栏，
            // 收起时只有一条窄边，点开是对话 + 快捷指令。它只给建议：不自动改
            // 时间线，生成类动作交给 AI 工作室 / AI 短剧让人确认。
            if !root.on-start && !root.phone: HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                AssistantRail {
                    vertical-stretch: 1;
                    data: root.assistant;
                    messages: root.assistant-messages;
                    toggle => { root.assistant-toggle(); }
                    send(text) => { root.assistant-send(text); }
                    quick(command) => { root.assistant-quick(command); }
                    input-edited(text) => { root.assistant-input(text); }
                    mode-changed(index) => { root.assistant-mode(index); }
                }

                Workspace { horizontal-stretch: 1; }
            }

            // The phone's editor reads the same global; only the shell round
            // it differs. Its three verbs that are the window's - export,
            // settings, closing the project - go where the strip's went.
            if !root.on-start && root.phone: PhoneEditor {
                vertical-stretch: 1;
                project-name: root.project-name;
                status: root.project-status;

                export-clicked => { root.export-clicked(); }
                open-settings => { root.open-settings(); }
                close-project => { root.app-menu-selected("close-project"); }
            }
        }
    }

    // The voiceover panel floats over the editor and under every sheet:
    // it has no scrim, so the work beside it carries on, and a sheet put up
    // while it is open - Export, Settings - covers it like the rest.
    if !root.on-start: VoiceoverPanel {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        phone: root.phone;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        data: root.voiceover;
        devices: root.voiceover-devices;
        level: Editor.record-level;
        rms: Editor.record-rms;
        clipped: Editor.record-clipped;
        seconds: Editor.record-seconds;
        silent: Editor.record-silent;

        closed => { root.voiceover-closed(); }
        action(verb) => { root.voiceover-action(verb); }
        device-changed(index) => { root.voiceover-device-changed(index); }
        countdown-changed(on) => { root.voiceover-countdown-changed(on); }
        mute-changed(on) => { root.voiceover-mute-changed(on); }
        gain-changed(db) => { root.voiceover-gain-changed(db); }
        prompt-edited(text) => { root.voiceover-prompt-edited(text); }
        prompt-speed-changed(index) => { root.voiceover-prompt-speed-changed(index); }
    }

    // Captions and Text to speech: cards floating over the editor on a
    // desk, like the voiceover panel and under every sheet, so the
    // timeline, the playhead and the selection stay in reach while they
    // are open and a job runs. Whichever was opened or grabbed last is in
    // front, and is the one Escape closes. On a phone, or a window too
    // narrow for a card beside the work, they stay the sheets they were,
    // over everything.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        z: root.sheets-fill ? 1 : 0;

        CaptionsDialog {
            fill: root.sheets-fill;
            floating: !root.sheets-fill;
            z: root.front-tool == "captions" ? 1 : 0;
            raised => { root.front-tool = "captions"; }
            inset-top: root.safe-area-insets.top;
            inset-bottom: root.safe-area-insets.bottom;
            inset-left: root.safe-area-insets.left;
            inset-right: root.safe-area-insets.right;
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            data: root.captions;
            models: root.caption-models;
            languages: root.caption-languages;

            closed => { root.captions-closed(); }
            voice-toggled(on) => { root.captions-voice-toggled(on); }
            source-changed(index) => { root.captions-source-changed(index); }
            text-edited(text) => { root.captions-text-edited(text); }
            model-changed(index) => { root.captions-model-changed(index); }
            language-changed(index) => { root.captions-language-changed(index); }
            placement-changed(index) => { root.captions-placement-changed(index); }
            size-changed(index) => { root.captions-size-changed(index); }
            begin => { root.captions-begin(); }
            cancel => { root.captions-cancel(); }
            import-srt => { root.captions-import-srt(); }
            export-srt => { root.captions-export-srt(); }
            find-edited(text) => { root.captions-find-edited(text); }
            replace-edited(text) => { root.captions-replace-edited(text); }
            replace-scope-changed(index) => { root.captions-replace-scope-changed(index); }
            replace-pressed => { root.captions-replace-pressed(); }
        }

        SpeechDialog {
            fill: root.sheets-fill;
            floating: !root.sheets-fill;
            // Its own home, a step in from the captions card's, so the two
            // do not open exactly on top of each other.
            home-right: 44px;
            home-top: 76px;
            z: root.front-tool == "speech" ? 1 : 0;
            raised => { root.front-tool = "speech"; }
            inset-top: root.safe-area-insets.top;
            inset-bottom: root.safe-area-insets.bottom;
            inset-left: root.safe-area-insets.left;
            inset-right: root.safe-area-insets.right;
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            data: root.speech;
            models: root.speech-models;
            model-details: root.speech-model-details;
            voices: root.speech-voices;
            voice-details: root.speech-voice-details;
            voice-avatars: root.speech-voice-avatars;
            samples: root.speech-samples;
            sample-waves: root.speech-sample-waves;
            sample-details: root.speech-sample-details;

            closed => { root.speech-closed(); }
            text-edited(text) => { root.speech-text-edited(text); }
            voice-changed(index) => { root.speech-voice-changed(index); }
            model-changed(index) => { root.speech-model-changed(index); }
            speed-changed(value) => { root.speech-speed-changed(value); }
            reference-start-changed(seconds) => { root.speech-reference-start-changed(seconds); }
            use-sample-changed(on) => { root.speech-use-sample-changed(on); }
            sample-changed(index) => { root.speech-sample-changed(index); }
            insert-tag(text, tag, at) => { return root.speech-insert-tag(text, tag, at); }
            begin => { root.speech-begin(); }
            cancel => { root.speech-cancel(); }
            save-name-edited(name) => { root.speech-save-name-edited(name); }
            pick-picture => { root.speech-pick-picture(); }
            save-voice => { root.speech-save-voice(); }
            clear-style => { root.speech-clear-style(); }
        }
    }

    // Declared last, and that is load-bearing: Slint paints siblings in
    // declaration order, so a modal placed above the workspace in the file is
    // painted *under* it on screen 鈥?open, correct, and completely hidden.
    //
    // The launch screen's sheet first among them. Settings is the only other
    // sheet the launch screen can put up, and never at the same time 鈥?the
    // scrim keeps the rail from being pressed 鈥?so the order between the two
    // decides nothing and this one reads first because it comes first.
    NewProjectDialog {
        fill: root.sheets-fill;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        data: root.start;
        phone: root.phone;
        aspects: root.start-aspects;
        sizes: root.start-sizes;
        rates: root.start-rates;

        closed => { root.start-dismiss(); }
        name-edited(name) => { root.start-name-edited(name); }
        location-edited(path) => { root.start-location-edited(path); }
        browse => { root.start-browse(); }
        aspect-changed(index) => { root.start-aspect-changed(index); }
        size-changed(index) => { root.start-size-changed(index); }
        rate-changed(index) => { root.start-rate-changed(index); }
        custom-width-edited(width) => { root.start-custom-width-edited(width); }
        custom-height-edited(height) => { root.start-custom-height-edited(height); }
        custom-fps-edited(fps) => { root.start-custom-fps-edited(fps); }
        canvas-changed(value) => { root.start-canvas-changed(value); }
        create => { root.start-create(); }
        dismiss-error => { root.start-dismiss-error(); }
    }

    ExportDialog {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        phone: root.phone;
        data: root.export;
        preview-frame: Editor.preview-frame;
        playhead: Editor.playhead;
        duration-seconds: Editor.duration-seconds;
        frame-rate: Editor.frame-rate;
        seek(seconds) => { Editor.seek(seconds); }

        closed => { root.export-closed(); }
        name-edited(name) => { root.export-name-edited(name); }
        browse => { root.export-browse(); }
        rate-changed(index) => { root.export-rate-changed(index); }
        codec-changed(index) => { root.export-codec-changed(index); }
        ten-bit-changed(on) => { root.export-ten-bit-changed(on); }
        hdr-changed(on) => { root.export-hdr-changed(on); }
        bitrate-changed(mbps) => { root.export-bitrate-changed(mbps); }
        begin => { root.export-start(); }
        cancel => { root.export-cancel(); }
        reveal => { root.export-reveal(); }
        again => { root.export-again(); }
        enable-ai-badge => { root.export-enable-ai-badge(); }
        quality-changed(index) => { root.export-quality-changed(index); }
        matrix-toggled(on) => { root.export-matrix-toggled(on); }
        matrix-count-changed(delta) => { root.export-matrix-count-changed(delta); }
        upscale-changed(on) => { root.export-upscale-changed(on); }
    }

    SettingsDialog {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        phone: root.phone;
        data: root.settings;
        transcribers: root.transcribers;
        voices: root.voices;
        versions: root.versions;
        version-details: root.version-details;
        languages: root.languages;
        system-facts: root.system-facts;
        system-report: root.system-report;
        startup-facts: root.startup-facts;
        on-start: root.on-start;

        // Focus hands itself back to the window's own scope, which is
        // where the keymap listens and what the bindings above live on.
        focus-keys => { keys.focus(); }
        closed => { root.settings-closed(); }
        page-changed(index) => { root.settings-page-changed(index); }
        ai-badge-changed(on) => { root.settings-ai-badge-changed(on); }
        watermark-changed(on) => { root.settings-watermark-changed(on); }
        watermark-pick => { root.settings-watermark-pick(); }
        watermark-remove => { root.settings-watermark-remove(); }
        watermark-position-changed(index) => { root.settings-watermark-position-changed(index); }
        watermark-opacity-changed(value) => { root.settings-watermark-opacity-changed(value); }
        watermark-size-changed(value) => { root.settings-watermark-size-changed(value); }
        open-license(url) => { root.settings-open-license(url); }
        shortcut-capture(id) => { root.settings-shortcut-capture(id); }
        shortcut-reset(id) => { root.settings-shortcut-reset(id); }
        shortcut-reset-all => { root.settings-shortcut-reset-all(); }
        show-log => { root.settings-show-log(); }
        clear-asset-cache => { root.settings-clear-asset-cache(); }
        clear-plugin-cache => { root.settings-clear-plugin-cache(); }
        language-changed(index) => { root.settings-language-changed(index); }
        log-level-changed(index) => { root.settings-log-level-changed(index); }
        theme-changed(dark) => { root.settings-theme-changed(dark); }
        skin-changed(index) => { root.settings-skin-changed(index); }
        skin-group-changed(index) => { root.settings-skin-group-changed(index); }
        skin-query-changed(text) => { root.settings-skin-query-changed(text); }
        motion-changed(on) => { root.settings-motion-changed(on); }
        low-power-changed(on) => { root.settings-low-power-changed(on); }
        side-art-changed(index) => { root.settings-side-art-changed(index); }
        neon-changed(on) => { root.settings-neon-changed(on); }
        neon-intensity-changed(index) => { root.settings-neon-intensity-changed(index); }
        neon-style-changed(index) => { root.settings-neon-style-changed(index); }
        accent-changed(index) => { root.settings-accent-changed(index); }
        accent-custom-changed(colour) => { root.settings-accent-custom-changed(colour); }
        playhead-changed(colour) => { root.settings-playhead-changed(colour); }
        playhead-chosen(index) => { root.settings-playhead-chosen(index); }
        scale-changed(index) => { root.settings-scale-changed(index); }
        playhead-stops-changed(on) => { root.settings-playhead-stops-changed(on); }
        proxies-changed(on) => { root.settings-proxies-changed(on); }
        remember-layout-changed(on) => { root.settings-remember-layout-changed(on); }
        gpu-changed(on) => { root.settings-gpu-changed(on); }
        ai-mode-changed(index) => { root.settings-ai-mode-changed(index); }
        ai-redetect => { root.settings-ai-redetect(); }
        magnetic-changed(on) => { root.settings-magnetic-changed(on); }
        download-source-changed(index) => { root.settings-download-source-changed(index); }
        download-base-edited(text) => { root.settings-download-base-edited(text); }
        server-enabled-changed(on) => { root.settings-server-enabled-changed(on); }
        server-host-edited(text) => { root.settings-server-host-edited(text); }
        server-port-edited(port) => { root.settings-server-port-edited(port); }
        server-token-edited(text) => { root.settings-server-token-edited(text); }
        server-token-generated => { root.settings-server-token-generated(); }
        check-updates => { root.settings-check-updates(); }
        version-chosen(index) => { root.settings-version-chosen(index); }
        install-version => { root.settings-install-version(); }
        install-cancel => { root.settings-install-cancel(); }
        model-activated(id) => { root.model-activated(id); }
        model-download(id) => { root.model-download(id); }
        model-cancel(id) => { root.model-cancel(id); }
        model-remove(id) => { root.model-remove(id); }
        model-open-link(id) => { root.model-open-link(id); }
        model-choose-file(id) => { root.model-choose-file(id); }
    }

    in property <RelinkData> relink;
    callback relink-all();
    callback relink-locate(id: string);
    callback relink-remove(id: string);
    callback relink-dismiss();

    ProjectDialog {
        fill: root.sheets-fill;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        data: root.project-sheet;

        closed => { root.project-closed(); }
        name-edited(name) => { root.project-name-edited(name); }
        size-changed(index) => { root.project-size-changed(index); }
        rate-changed(index) => { root.project-rate-changed(index); }
        custom-width-edited(width) => { root.project-custom-width-edited(width); }
        custom-height-edited(height) => { root.project-custom-height-edited(height); }
        custom-fps-edited(fps) => { root.project-custom-fps-edited(fps); }
        color-space-changed(index) => { root.project-color-space-changed(index); }
        canvas-changed(value) => { root.project-canvas-changed(value); }
        apply => { root.project-apply(); }
    }

    // Over the Audio page it was opened from, and over the tool cards,
    // which may be open beside the page on a desk.
    NewVoiceDialog {
        fill: root.sheets-fill;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        data: root.new-voice;

        closed => { root.new-voice-closed(); }
        name-edited(name) => { root.new-voice-name-edited(name); }
        description-edited(text) => { root.new-voice-description-edited(text); }
        start-changed(seconds) => { root.new-voice-start-changed(seconds); }
        pick-picture => { root.new-voice-pick-picture(); }
        save => { root.new-voice-save(); }
    }

    RelinkDialog {
        fill: root.sheets-fill;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        data: root.relink;
        relink-all => { root.relink-all(); }
        locate(id) => { root.relink-locate(id); }
        remove(id) => { root.relink-remove(id); }
        dismiss => { root.relink-dismiss(); }
    }

    // A question before something is thrown away, over the workspace;
    // nothing asks it while another sheet is up.
    in property <ConfirmData> confirm;
    callback confirm-accepted();
    callback confirm-dismissed();

    ConfirmDialog {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        data: root.confirm;
        confirmed => { root.confirm-accepted(); }
        dismissed => { root.confirm-dismissed(); }
    }

    // 宸ョ▼浜戝悓姝ワ細鏂囦欢鑿滃崟鐨勪繚瀛?鎵撳紑/涓婁紶閮借惤鍦ㄨ繖寮犺〃涓娿€?
    CloudDialog {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        data: {
            open: root.cloud-open,
            busy: root.cloud-busy,
            status: root.cloud-status,
            url: root.cloud-url,
        };
        items: root.cloud-items;

        closed => { root.cloud-closed(); }
        refresh => { root.cloud-refresh(); }
        save => { root.cloud-save(); }
        open-pid(pid, name) => { root.cloud-open-pid(pid, name); }
        open-url => { root.cloud-open-url(); }
        dismiss => { root.cloud-closed(); }
    }

    // 剪映草稿互通与 XML 导出：文件菜单「导出剪映草稿（JSON）」「导出
    // FCPXML / Premiere XML」「导入剪映草稿」都落在这张表上。
    InteropDialog {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        open: root.interop-open;
        busy: root.interop-busy;
        jianying: root.interop-jianying;
        status: root.interop-status;
        folder: root.interop-folder;
        hint: root.interop-hint;

        closed => { root.interop-closed(); }
        export-jianying => { root.interop-export-jianying(); }
        export-xml => { root.interop-export-xml(); }
        reveal => { root.interop-reveal(); }
        sync => { root.interop-sync(); }
        dismiss => { root.interop-closed(); }
    }

    // 专业后期底座（0.3.6）：示波器 / 调色 / QC / 校验 / 快照 / 交付。
    // 一张大表，左侧六页；页签与按钮都收成 post-action 一条回调。整张表
    // 只在开着时实例化：启动路径上没有它。
    if root.post.open: PostDialog {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        data: root.post;
        luts: root.post-luts;
        qc-rows: root.post-qc-rows;
        check-rows: root.post-check-rows;
        snapshot-rows: root.post-snapshot-rows;

        action(action, index, text) => { root.post-action(action, index, text); }
        tick => { root.post-tick(); }
        closed => { root.post-closed(); }
    }

    // 影视专业面板（0.3.7）：九页一张大表，左侧竖排导航。只在打开时实例化：
    // 启动路径上没有它，也没有它的网络工作。
    if root.pro.open: ProDialog {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        data: root.pro;
        text-shots: root.pro-text-shots;
        plan-shots: root.pro-plan-shots;
        models: root.pro-models;
        tiers: root.pro-tiers;
        mon-types: root.pro-mon-types;
        mon-episodes: root.pro-mon-episodes;
        board: root.pro-board;
        takes: root.pro-takes;
        notes: root.pro-notes;
        cont-rows: root.pro-cont-rows;
        retake-reasons: root.pro-retake-reasons;
        retake-queue: root.pro-retake-queue;
        audit-rows: root.pro-audit-rows;
        dramas: root.pro-dramas;
        dists: root.pro-dists;
        dist-files: root.pro-dist-files;
        dist-steps: root.pro-dist-steps;
        dist-drama-labels: root.pro-dist-drama-labels;
        pass-rows: root.pro-pass-rows;
        pass-verify-rows: root.pro-pass-verify-rows;
        pass-recent: root.pro-pass-recent;
        findings: root.pro-findings;
        sb-platforms: root.pro-sb-platforms;
        sb-history: root.pro-sb-history;
        plugins: root.pro-plugins;
        plugin-mine: root.pro-plugin-mine;
        templates: root.pro-templates;
        tpl-industries: root.pro-tpl-industries;
        tpl-scenes: root.pro-tpl-scenes;
        tasks: root.pro-tasks;

        action(action, index, text) => { root.pro-action(action, index, text); }
        tick => { root.pro-tick(); }
        closed => { root.pro-closed(); }
    }

    // 命令面板（Ctrl+K）：同样按需实例化，浮在后期面板上面。
    if root.palette-open: CommandPalette {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        visible-flag: true;
        items: root.command-items;
        first: root.command-first;

        query-edited(text) => { root.palette-query-edited(text); }
        chosen(id) => { root.palette-chosen(id); }
        dismissed => { root.palette-closed(); }
    }

    // 鏄熺眮 AI 闈㈡澘锛氭湰鍦颁紭鍏堬紝浜戠鍏滃簳銆傛诞鍦ㄧ紪杈戝櫒鍜屽凡鏈夐潰鏉夸箣涓婏紱鍚戝
    // 澹版槑鍦ㄥ畠鍚庨潰锛岀涓€娆＄敤 AI 鏃跺悜瀵兼槸鏇磋鐪嬪埌鐨勯偅寮犮€?
    AiDialog {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        data: root.ai;
        video: root.ai-video;
        video-models: root.ai-video-models;
        video-locals: root.ai-video-locals;
        voices: root.ai-voices;
        voice-names: root.ai-voice-names;
        plugins: root.ai-plugins;
        photo: root.ai-photo;

        closed => { root.ai-closed(); }
        tab-changed(tab) => { root.ai-tab-changed(tab); }
        text-edited(text) => { root.ai-text-edited(text); }
        voice-changed(index) => { root.ai-voice-changed(index); }
        rate-changed(value) => { root.ai-rate-changed(value); }
        engine-changed(index) => { root.ai-engine-changed(index); }
        generate => { root.ai-generate(); }
        preview => { root.ai-preview(); }
        cancel => { root.ai-cancel(); }
        mode-changed(index) => { root.ai-mode-changed(index); }
        redetect => { root.ai-redetect(); }
        plugin-import => { root.ai-plugin-import(); }
        plugin-download(id) => { root.ai-plugin-download(id); }
        plugin-open(id) => { root.ai-plugin-open(id); }
        plugin-remove(id) => { root.ai-plugin-remove(id); }
        plugin-refresh => { root.ai-plugin-refresh(); }
        photo-pick => { root.ai-photo-pick(); }
        photo-clear => { root.ai-photo-clear(); }
        confirm-yes => { root.ai-confirm-yes(); }
        confirm-no => { root.ai-confirm-no(); }
        login => { root.ai-login(); }
        video-action(action, index, text) => { root.ai-video-action(action, index, text); }
    }

    // AI 工作室（0.3.0）：AI 菜单里的「AI 一键成片 / 动态解说片 / 爆款复刻」
    // 三行都落在这一张表上。清单与列表由 Rust 在打开面板后取回。
    AiStudioDialog {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        data: root.ai-studio;
        persons: root.ai-studio-persons;
        pages: root.ai-studio-pages;
        shots: root.ai-studio-shots;
        slots: root.ai-studio-slots;
        versions: root.ai-studio-versions;

        action(action, index, text) => {
            root.ai-studio-action(action, index, text);
        }

        closed => { root.ai-studio-action("close", 0, ""); }
    }

    // 电影 / 剧集制作向导（0.3.5）：15 步（真实剧组 SOP）＋简单/专业模式。
    // 生成走导演编排器（可单镜重拍 = DAG）或电影成片管线（2.39:1 + QC + 工程包）。
    MovieDialog {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        data: root.movie;
        type-labels: root.movie-types;
        shot-rows: root.movie-shots;
        char-rows: root.movie-chars;
        scene-rows: root.movie-scenes;
        task-rows: root.movie-tasks;
        take-rows: root.movie-takes;
        delivery-rows: root.movie-delivery;
        done: root.movie-done;

        action(action, index, text) => {
            root.movie-action(action, index, text);
        }

        closed => { root.movie-action("close", 0, ""); }
    }

    // AI 短剧（0.3.1）：桌面内的多集短剧工作台。设定 → 剧本（可逐集逐镜编辑）
    // → 分镜配素材 → 逐集/整剧成片 → 插入时间轴 / 导出剧本 JSON。
    AiDramaDialog {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        data: root.ai-drama;
        episodes: root.ai-drama-episodes;
        scenes: root.ai-drama-scenes;
        characters: root.ai-drama-characters;
        outputs: root.ai-drama-outputs;
        history: root.ai-drama-history;

        action(action, index, text) => {
            root.ai-drama-action(action, index, text);
        }

        closed => { root.ai-drama-action("close", 0, ""); }
    }

    // 鏄熺眮璐﹀彿鐧诲綍鍗★細AI 闈㈡澘閲岀殑銆屽幓鐧诲綍銆嶃€佷互鍙婁簯绔湭鐧诲綍鏃剁殑寮曞閮藉紑
    // 杩欎竴寮狅紙棣栧睆鍙充笂瑙掔殑璐﹀彿 chip 鑷繁涔熸湁涓€寮狅紝瑙?start.slint锛夈€?
    AccountDialog {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        open: root.account-sheet;
        signed-in: root.account-signed-in;
        name: root.account-name;
        plan: root.account-plan;
        expire: root.account-expire;
        error: root.account-error;
        busy: root.account-busy;
        submit(phone, password) => { root.account-sign-in(phone, password); }
        leave => { root.account-sign-out(); root.account-sheet-closed(); }
        closed => { root.account-sheet-closed(); }
    }

    AiWizard {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: root.sheets-top;
        width: root.width;
        height: root.height - root.sheets-top;
        data: root.ai;

        closed => { root.ai-wizard-close(); }
        pick-local => { root.ai-wizard-local(); }
        pick-cloud => { root.ai-wizard-cloud(); }
        dismiss => { root.ai-wizard-close(); }
    }

    // Over everything but the tooltips and the menus, the sheets included:
    // an export that failed behind a dialog is exactly the case a notice is
    // for. Only its card takes events, so covering the window costs the
    // window nothing; and it is under the tooltip layer so the card's own
    // close button can be named over it.
    ToastLayer {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        data: root.toast;
        phone: root.phone;
        shares-log: root.settings.shares-log;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        gone(token) => { root.toast-gone(token); }
        // The same action as Settings 鈥?About's, by the same callback.
        show-log => { root.settings-show-log(); }
    }

    // Over the workspace and both sheets, under the menus. A tooltip has to
    // clear the pane it belongs to 鈥?panes clip 鈥?and it has no business over
    // an open menu, which is the one surface that would rather not be
    // explained at. A PopupWindow is its own layer above all of this anyway,
    // so the menus win without having to be declared after it.
    TooltipLayer {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    // Above the dialogs as well as the workspace. A PopupWindow is its own
    // layer so the order does not strictly decide the outcome, but the
    // element that places it still measures against this one's box, and this
    // one is the whole window.
    appmenu := ContextMenu {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        items: root.app-menu-items;
        menu-height: root.app-menu-height;
        token: root.app-menu-token;
        keyboard: root.menu-by-keyboard;
        selected(id) => { root.app-menu-selected(id); }
        // The arrows walk the strip: File, Edit, View, AI and round again.
        neighbour(by) => { root.open-menu-from-keys(Math.mod(root.open-menu + by, 4)); }
    }

}
