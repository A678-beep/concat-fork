import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button } from "../primitives/modal.slint";
import { Field } from "../primitives/modal.slint";
import { Select } from "../primitives/select.slint";

// 星籁免费商用素材库（0.2.20 起）。
//
// 与「媒体」页同一块面板：左侧分类列选类型与行业，右侧工具条搜索，网格
// 显示缩略图。0.2.26 起卡片只显示中文信息：缩略图占主视觉，下面一行中文
// 标题（行业 · 子类标签）、一行「类型 · 分辨率/时长」和来源小字；「可商用」
// 是右上角半透明小角标，「需署名」是中性色小角标，来源与许可全称只在悬停
// 时露出来。平台英文标题不上卡片。下载缓存在
// `%APPDATA%\app.concat.editor\asset-cache`，缓存好了按钮变成「插入时间轴」。
// 数据全部来自平台 `/assets/*` 真实接口，不用 mock。
//
// 0.2.21 的卡顿修复在这里：网格只实例化可视区域里的卡片（虚拟化），
// 滚动到哪一行就把 `visible-range(first, last)` 报给 Rust，只给这些卡片下载
// 缩略图；加载中显示骨架屏而不是空白。

export struct AssetCardData {
    id: string,
    /// 卡片主标题：中文（行业 · 子类标签 / 分类 / 字体名），绝不放平台英文标题。
    title: string,
    /// 副信息一行：类型 · 分辨率/时长。
    detail: string,
    /// 来源小字：Pixabay / ccMixter / 官方字体源 …（只做小字，不抢主视觉）。
    source: string,
    /// 悬停才露出的中文标签行。
    tags: string,
    /// 悬停才露出的来源与许可全称：`Pixabay · Pixabay Content License`。
    license: string,
    /// 0 视频 / 1 图片 / 2 音乐 / 3 音效 / 4 字体
    kind: int,
    /// 类型角标上的字：视频/图片/音乐/音效/字体。
    kind-label: string,
    thumb: image,
    has-thumb: bool,
    commercial: bool,
    /// 授权要求署名（CC BY 一类）。
    needs-attribution: bool,
    /// 0 未下载 / 1 下载中 / 2 已缓存 / 3 失败
    state: int,
    progress: float,
    /// 按钮上的字：下载 / 下载中 xx% / 插入时间轴 / 重试
    action: string,
    /// 悬停预览：0 无 / 1 准备中 / 2 视频帧循环 / 3 试听中 / 4 字体示例 / 5 不可用
    preview-state: int,
    /// 视频预览帧（3–5 秒循环）或空。
    preview-frames: [image],
    /// 字体预览注册进窗口字体集合后的 family 名；不是字体卡时为空。
    font-family: string,
}

export global Assets {
    /// 当前类型 tab，0..4。
    in property <int> kind: 0;
    in property <[string]> kinds;
    /// 0 是「全部行业」，其余是 industries 的下标 + 1。
    in property <int> industry: 0;
    in property <[string]> industries;
    /// 0 = 全部分类，其余是 categories 的下标 + 1。
    in property <int> category: 0;
    in property <[string]> categories;
    in property <string> query;
    in property <[AssetCardData]> items;
    in property <bool> loading;
    in property <string> message;
    /// 「共 N 条 · 已显示 M 条」
    in property <string> stats;

    callback kind-changed(index: int);
    callback industry-changed(index: int);
    callback category-changed(index: int);
    callback query-edited(text: string);
    callback search();
    callback load-more();
    callback action(id: string);
    callback shown(on: bool);
    /// 网格可视区域：`first`..`last` 是 items 的下标（含）。滚动时才会变，
    /// 用来只给看得见的卡片下载缩略图。
    callback visible-range(first: int, last: int);
    /// 悬停预览起停：鼠标在卡片缩略图上停留 400ms 起，移开即停。
    callback hover-start(id: string);
    callback hover-end(id: string);
}

// 悬停感知：TouchArea 的 has-hover 变成一条回调。Slint 没有悬停回调，
// 但能监听一个绑定到 has-hover 的属性的变化；进出卡片各说一次。
component HoverArea inherits TouchArea {
    callback hover(on: bool);
    property <bool> now-hover: root.has-hover;
    changed now-hover => { root.hover(root.now-hover); }
}

// 缩略图上的一枚小徽标：小字号、半透明底，跟着字宽走，不会铺成一条色带。
component TinyTag inherits Rectangle {
    in property <string> label;
    in property <color> ink: Theme.fg-muted;
    in property <color> ground: Theme.scrim;

    height: 16px;
    width: tag.preferred-width + 12px;
    border-radius: 4px;
    background: root.ground;

    tag := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.ink;
        font-size: 9px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// 一张素材卡。
component AssetCard inherits Rectangle {
    in property <AssetCardData> data;
    in property <length> thumb-height;

    callback act();
    /// 悬停 400ms 后向素材库面板要预览；移开时收回。
    callback ask-preview();
    callback end-preview();

    /// 视频预览循环到第几帧。
    property <int> preview-index: 0;
    /// 整卡悬停：缩略图和信息区各有一个 TouchArea，合起来算。
    property <bool> hot: thumb-hover.has-hover || info-hover.has-hover;
    hover-timer := Timer {
        interval: 400ms;
        running: false;
        triggered => { self.running = false; root.ask-preview(); }
    }
    frames-timer := Timer {
        interval: 125ms;
        running: root.data.preview-state == 2 && root.data.preview-frames.length > 1;
        triggered => {
            root.preview-index = Math.mod(root.preview-index + 1, Math.max(1, root.data.preview-frames.length));
        }
    }

    border-radius: Theme.r-lg;
    background: Theme.raised;
    border-width: 1px;
    border-color: root.hot ? Theme.line-strong : Theme.line;
    drop-shadow-blur: root.hot ? 18px : 10px;
    drop-shadow-offset-y: root.hot ? 4px : 2px;
    drop-shadow-color: #00000059;
    clip: true;
    animate border-color, drop-shadow-blur, drop-shadow-offset-y { duration: 120ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    // 信息区的悬停垫在按钮下面：鼠标停在标题/副信息上也整卡高亮。
    info-hover := TouchArea {
        y: root.thumb-height;
        width: parent.width;
        height: parent.height - root.thumb-height;
    }

    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: root.thumb-height;
            background: Theme.well;
            clip: true;

            Image {
                visible: root.data.has-thumb;
                width: 100%;
                height: 100%;
                source: root.data.thumb;
                // 16:9 的图正好铺满；9:16 的图两边留黑边，不裁掉主体。
                image-fit: contain;
            }

            // 悬停预览：视频放后台解好的 3–5 秒循环帧；字体用该字体渲染示例。
            if root.data.preview-state == 2 && root.data.preview-frames.length > 0: Image {
                width: 100%;
                height: 100%;
                source: root.data.preview-frames[Math.min(root.preview-index, root.data.preview-frames.length - 1)];
                image-fit: contain;
            }

            if root.data.preview-state == 4: Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.field;

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;

                    Text {
                        text: "星籁剪辑";
                        font-family: root.data.font-family;
                        color: Theme.fg;
                        font-size: 21px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "让好内容被看见";
                        font-family: root.data.font-family;
                        color: Theme.fg;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: I18n.t("assets.previewFont");
                        color: Theme.fg-dim;
                        font-size: Theme.fs-xs;
                        horizontal-alignment: center;
                    }
                }
            }

            if !root.data.has-thumb && root.data.preview-state != 4: VerticalLayout {
                alignment: center;
                Icon {
                    glyph: root.data.kind == 1 ? Glyph.image
                        : root.data.kind == 2 ? Glyph.music
                        : root.data.kind == 3 ? Glyph.music
                        : root.data.kind == 4 ? Glyph.text-mark
                        : Glyph.film;
                    size: 22px;
                    tint: Theme.fg-dim;
                }
            }

            // 合规角标：右上角，小字号、半透明，不再是一条大绿杠。
            HorizontalLayout {
                x: parent.width - self.preferred-width - 8px;
                y: 8px;
                width: self.preferred-width;
                height: 16px;
                spacing: 4px;

                if root.data.needs-attribution: TinyTag {
                    label: I18n.t("assets.needsCredit");
                    ink: Theme.fg;
                }
                if root.data.commercial: TinyTag {
                    label: I18n.t("assets.commercial");
                    ink: Theme.accent;
                }
            }

            // 悬停预览状态：左上角的小字，和合规角标分开。
            if root.data.preview-state == 1 || root.data.preview-state == 3
                || root.data.preview-state == 5 || root.data.preview-state == 6: TinyTag {
                x: 8px;
                y: 8px;
                label: root.data.preview-state == 1 ? I18n.t("assets.previewPreparing")
                    : root.data.preview-state == 3 ? I18n.t("assets.previewAudio")
                    : root.data.preview-state == 6 ? I18n.t("assets.previewNoAudio")
                    : I18n.t("assets.previewUnavailable");
                ink: Theme.fg;
            }

            // 下载进度贴着缩略图底边，不占卡片高度，也不整块变色。
            if root.data.state == 1: Rectangle {
                y: parent.height - self.height;
                height: 3px;
                background: #000000a0;

                Rectangle {
                    width: parent.width * Math.min(1.0, Math.max(0.0, root.data.progress));
                    height: parent.height;
                    background: Theme.accent;
                }
            }

            // 悬停：中文标签 + 来源/许可全称。许可全称不在主视觉上。
            if thumb-hover.has-hover && (root.data.tags != "" || root.data.license != ""): Rectangle {
                y: parent.height - self.height;
                height: 34px;
                background: #000000b8;

                VerticalLayout {
                    x: 8px;
                    y: 4px;
                    width: parent.width - 16px;
                    spacing: 0;

                    if root.data.tags != "": Text {
                        text: root.data.tags;
                        color: Theme.on-scrim;
                        font-size: Theme.fs-xs;
                        overflow: elide;
                    }
                    if root.data.license != "": Text {
                        text: root.data.license;
                        color: Theme.on-scrim.with-alpha(0.72);
                        font-size: Theme.fs-xs;
                        overflow: elide;
                    }
                }
            }

            // 悬停感知盖在缩略图上：停留 400ms 起预览，移开就停；试听中
            // 点一下画面也可以停（任务卡允许点击暂停）。
            thumb-hover := HoverArea {
                hover(on) => {
                    if (on) {
                        hover-timer.running = true;
                    } else {
                        hover-timer.running = false;
                        root.end-preview();
                    }
                }
                clicked => {
                    if (root.data.preview-state == 3) { root.end-preview(); }
                }
            }
        }

        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 5px;

            Text {
                text: root.data.title;
                color: Theme.fg;
                font-size: Theme.fs;
                font-weight: Theme.weight-title;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 6px;

                Text {
                    horizontal-stretch: 1;
                    text: root.data.detail;
                    color: Theme.fg-muted;
                    font-family: Theme.font-technical;
                    font-size: Theme.fs-xs;
                    overflow: elide;
                    vertical-alignment: center;
                }

                if root.data.source != "": Text {
                    text: root.data.source;
                    color: Theme.fg-dim;
                    font-size: 9px;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }

            Button {
                height: 28px;
                block: true;
                glyph: root.data.state == 2 ? Glyph.plus : Glyph.import;
                label: root.data.action;
                clicked => { root.act(); }
            }
        }
    }
}

// 加载时的骨架卡：和真卡一样高，网格不跳。
component AssetSkeleton inherits Rectangle {
    in property <length> thumb-height;

    border-radius: Theme.r-lg;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;

    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: root.thumb-height;
            background: Theme.well;
        }

        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 5px;

            Rectangle { height: 12px; border-radius: 3px; background: Theme.well; width: 62%; }
            Rectangle { height: 9px; border-radius: 3px; background: Theme.well; width: 84%; }
            Rectangle { height: 28px; border-radius: Theme.r; background: Theme.well; }
        }
    }
}

// 加载中的骨架网格：两行假卡，位置和真网格同一套算术，加载完不跳。
component AssetSkeletonGrid inherits Rectangle {
    property <length> gap: 10px;
    property <length> min-card: 190px;
    property <int> cols: Math.max(1,
        Math.floor((root.width + root.gap) / (root.min-card + root.gap)));
    property <length> card-w: (root.width - (root.cols - 1) * root.gap) / root.cols;
    property <length> thumb-h: root.card-w * 9 / 16;
    property <length> card-h: root.thumb-h + 86px;

    height: 2 * (root.card-h + root.gap) - root.gap;

    for index in 2 * root.cols: AssetSkeleton {
        x: Math.mod(index, root.cols) * (root.card-w + root.gap);
        y: Math.floor(index / root.cols) * (root.card-h + root.gap);
        width: root.card-w;
        height: root.card-h;
        thumb-height: root.thumb-h;
    }
}

// 网格：Slint 没有 auto-fill grid，按列数算坐标（和媒体页同一套算术）。
//
// 虚拟化：只实例化可视行（上下各多一行）。`scroll-top` 是整页滚了多少，
// `page-top` 是 AssetPage 的绝对 y，两者相减得到网格在页面里的位置，
// 于是可视范围不用 Rust 参与就能算出来。
component AssetGrid inherits Rectangle {
    in property <[AssetCardData]> items;
    /// 页面可视高度。
    in property <length> viewport;
    /// 整页已经滚了多少（0 = 顶部）。
    in property <length> scroll-top;
    /// AssetPage 的绝对 y：算网格自己相对页面滚动了多少。
    in property <length> page-top;
    callback action(id: string);
    callback visible-range(first: int, last: int);
    /// 卡片悬停起停（缩略图停 400ms 后起预览，移开停）。
    callback hover-start(id: string);
    callback hover-end(id: string);

    property <length> gap: 10px;
    property <length> min-card: 190px;
    property <int> cols: Math.max(1,
        Math.floor((root.width + root.gap) / (root.min-card + root.gap)));
    property <length> card-w: (root.width - (root.cols - 1) * root.gap) / root.cols;
    property <length> thumb-h: root.card-w * 9 / 16;
    // 缩略图 + 标题/副信息/按钮三行（Rust 侧的卡片文案固定两行）。
    property <length> card-h: root.thumb-h + 86px;
    property <length> row-h: root.card-h + root.gap;
    property <int> rows: Math.ceil(root.items.length / root.cols);

    height: root.rows > 0 ? root.rows * root.row-h - root.gap : 0px;

    // 网格顶边相对页面内容顶边的位移，和页面滚动量一起算可视首行。
    property <length> grid-top: root.absolute-position.y - root.page-top;
    property <length> first-y: root.scroll-top - root.grid-top;
    property <int> first-row: Math.max(0,
        Math.min(root.rows - 1, Math.floor((root.first-y - root.row-h) / root.row-h)));
    property <int> last-row: Math.max(root.first-row,
        Math.min(root.rows - 1,
            Math.floor((root.first-y + root.viewport) / root.row-h) + 1));
    property <int> first-index: root.first-row * root.cols;
    property <int> last-index: Math.min(root.items.length - 1,
        (root.last-row + 1) * root.cols - 1);

    // 可视范围变了才告诉 Rust：滚一整行才变一次，不是每个像素。
    changed first-index => { root.visible-range(root.first-index, root.last-index); }
    changed last-index => { root.visible-range(root.first-index, root.last-index); }

    for item[index] in root.items: Rectangle {
        x: Math.mod(index, root.cols) * (root.card-w + root.gap);
        y: Math.floor(index / root.cols) * root.row-h;
        width: root.card-w;
        height: root.card-h;
        background: Colors.transparent;

        // 真正的卡片只在可视区域里建：400+ 张也只画看得见的十几张。
        if index >= root.first-index && index <= root.last-index: AssetCard {
            width: 100%;
            height: 100%;
            thumb-height: root.thumb-h;
            data: item;
            act => { root.action(item.id); }
            ask-preview => { root.hover-start(item.id); }
            end-preview => { root.hover-end(item.id); }
        }
    }
}

// 素材库的一页：类型 tab、搜索、网格、加载更多、授权说明。
export component AssetPage inherits VerticalLayout {
    spacing: 4px;

    /// 页面滚到哪了，由 media-pane 的 PaneScroll 传进来；网格虚拟化用。
    in property <length> scroll-top: 0px;
    /// 页面可视高度。
    in property <length> viewport: 0px;

    // ── 类型 tab ──
    Rectangle {
        height: 40px;
        background: Theme.panel;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 4px;
            alignment: start;

            for label[index] in Assets.kinds: Button {
                label: label;
                primary: Assets.kind == index;
                ghost: Assets.kind != index;
                clicked => { Assets.kind-changed(index); }
            }
        }
    }

    // ── 搜索 ──
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Field {
            horizontal-stretch: 1;
            placeholder: I18n.t("assets.searchPlaceholder");
            value: Assets.query;
            edited(text) => { Assets.query-edited(text); }
        }

        if Assets.categories.length > 1: Select {
            horizontal-stretch: 0;
            width: self.natural-width;
            options: Assets.categories;
            current: Assets.category;
            changed(index) => { Assets.category-changed(index); }
        }

        Button {
            label: I18n.t("assets.search");
            glyph: Glyph.search;
            clicked => { Assets.search(); }
        }

        Text {
            text: Assets.stats;
            color: Theme.fg-dim;
            font-family: Theme.font-technical;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
    }

    // ── 加载中：骨架屏（只在还没有列表时；翻页时旧列表留着）──
    if Assets.loading && Assets.items.length == 0: AssetSkeletonGrid { }

    if Assets.loading: Text {
        text: I18n.t("assets.loading");
        color: Theme.fg-muted;
        font-size: Theme.fs-sm;
    }

    if Assets.message != "": Text {
        text: Assets.message;
        color: Theme.fg-muted;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }

    if !Assets.loading && Assets.items.length == 0 && Assets.message == "": VerticalLayout {
        padding: 24px;
        alignment: center;
        Text {
            text: I18n.t("assets.empty");
            color: Theme.fg-dim;
            font-size: Theme.fs;
            horizontal-alignment: center;
        }
        Text {
            text: I18n.t("assets.emptyHint");
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    // ── 网格 ──
    if Assets.items.length > 0: VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;

        AssetGrid {
            items: Assets.items;
            viewport: root.viewport;
            scroll-top: root.scroll-top;
            page-top: root.absolute-position.y;
            action(id) => { Assets.action(id); }
            visible-range(first, last) => { Assets.visible-range(first, last); }
            hover-start(id) => { Assets.hover-start(id); }
            hover-end(id) => { Assets.hover-end(id); }
        }
    }

    // ── 加载更多 + 授权说明 ──
    if Assets.items.length > 0 && Assets.stats != "": HorizontalLayout {
        padding: 8px;
        spacing: 8px;
        alignment: start;

        Button {
            label: I18n.t("assets.loadMore");
            ghost: true;
            clicked => { Assets.load-more(); }
        }

        Text {
            horizontal-stretch: 1;
            text: I18n.t("assets.licenseHint");
            color: Theme.fg-dim;
            font-size: Theme.fs-xs;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}
