        x: root.width * SideArt.mx(root.side, 0.36 + i * 0.22) - self.width / 2
            + Math.sin((root.phase * 360 + i * 130) * 1deg) * root.width * 0.03;
        y: root.height * (0.12 + i * 0.42);
    }

    for i in 8: Rectangle {
        width: 1.8px;
        height: 1.8px;
        border-radius: 0.9px;
        x: root.width * SideArt.rnd(i, 147);
        y: Math.mod(SideArt.rnd(i, 149) - root.phase * 0.05, 1.0) * root.height;
        opacity: 0.14 + 0.28 * SideArt.breathe(root.phase, i, 0.7);
        background: root.gold;
    }
}

// ── 23 · 竹林清风 ───────────────────────────────────────────────────────────

component SceneBamboo inherits Rectangle {
    in property <int> side: 0;
    in property <float> phase: 0;

    width: 100%;
    height: 100%;
    background: Colors.transparent;

    property <color> bamboo: Theme.dark ? (#9fd8a8) : (#2f6a48);

    // 中景：四根竹子，粗细分远近，随风轻摆。
    for i in 4: Rectangle {
        width: root.width * (0.036 + (3 - i) * 0.010);
        height: root.height * 1.06;
        x: root.width * (0.18 + i * 0.22)
            + Math.sin((root.phase * 360 + i * 74) * 1deg) * root.width * 0.035;
        y: -root.height * 0.03;
        border-radius: self.width / 2;
        background: @linear-gradient(90deg,
            root.bamboo.with-alpha(0.10) 0%,
            root.bamboo.with-alpha(0.20) 46%,
            root.bamboo.with-alpha(0.06) 100%);

        // 竹节
        for j in 5: Rectangle {
            width: 100%;
            height: 2px;
            y: parent.height * (0.14 + j * 0.19);
            background: root.bamboo.with-alpha(0.26);
        }
    }

    // 竹叶：细长的三角，横向飘出。
    for i in 12: Path {
        width: root.width * 0.30;
        height: root.width * 0.14;
        x: root.width * SideArt.mx(root.side, 0.20 + 0.62 * SideArt.rnd(i, 151))
            + Math.sin((root.phase * 360 + i * 83) * 1deg) * root.width * 0.05;
        y: root.height * (0.08 + 0.82 * SideArt.rnd(i, 153));
        viewbox-width: 30;
        viewbox-height: 14;
        fit: fill;
        fill: root.bamboo.with-alpha(0.10 + 0.14 * SideArt.rnd(i, 155));
        commands: "M 1 12 C 10 4 22 2 29 1 C 24 7 12 12 1 12 Z";
    }

    for i in 7: Rectangle {
        width: 1.6px;
        height: 1.6px;
        border-radius: 0.8px;
        x: root.width * SideArt.rnd(i, 157);
        y: Math.mod(SideArt.rnd(i, 159) - root.phase * 0.05, 1.0) * root.height;
        opacity: 0.14 + 0.28 * SideArt.breathe(root.phase, i, 0.8);
        background: (#d8ffe0);
    }
}

// ── 24 · 折扇屏风 ───────────────────────────────────────────────────────────

component Fan inherits Rectangle {
    in property <length> size: 110px;
    in property <float> alpha: 1.0;
    in property <color> paper: #f2e2c4;
    in property <color> gold: #e8b04b;

    width: root.size;
    height: root.size * 0.62;
    background: Colors.transparent;

    // 扇面
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 62;
        fit: fill;
        fill: @linear-gradient(180deg,
            root.paper.with-alpha(0.32 * root.alpha) 0%,
            root.paper.with-alpha(0.10 * root.alpha) 100%);
        stroke: root.gold.with-alpha(0.40 * root.alpha);
        stroke-width: 1.2px;
        commands: "M 4 58 C 10 22 34 4 50 4 C 66 4 90 22 96 58 Z";
    }
    // 扇骨
    for i in 5: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 62;
        fit: fill;
        stroke: root.gold.with-alpha(0.26 * root.alpha);
        stroke-width: 1px;
        commands: i == 0 ? "M 50 58 L 8 54"
            : i == 1 ? "M 50 58 L 26 30"
            : i == 2 ? "M 50 58 L 50 6"
            : i == 3 ? "M 50 58 L 74 30"
            : "M 50 58 L 92 54";
    }
    // 扇轴
    Rectangle {
        x: root.width * 0.47;
        y: root.height * 0.88;
        width: root.width * 0.06;
        height: self.width;
        border-radius: self.width / 2;
        background: root.gold.with-alpha(0.80 * root.alpha);
    }
}

component SceneFan inherits Rectangle {
    in property <int> side: 0;
    in property <float> phase: 0;

    width: 100%;
    height: 100%;
    background: Colors.transparent;

    property <color> gold: #e8b04b;

    // 两把扇：一前一后，轻轻开合。
    for i in 2: Fan {
        size: root.width * (i == 0 ? 0.94 : 0.62);
        alpha: i == 0 ? 1.0 : 0.62;
        x: root.width * SideArt.mx(root.side, 0.34 + i * 0.26) - self.width / 2
            + Math.sin((root.phase * 360 + i * 120) * 1deg) * root.width * 0.03;
        y: root.height * (0.52 + i * 0.16);
    }

    // 前景：几点金色浮尘。
    for i in 9: Rectangle {
        width: (1.6 + 1.6 * SideArt.rnd(i, 161)) * 1px;
        height: self.width;
        border-radius: self.width / 2;
        x: root.width * SideArt.rnd(i, 163);
        y: Math.mod(SideArt.rnd(i, 165) - root.phase * 0.06, 1.0) * root.height;
        opacity: 0.14 + 0.32 * SideArt.breathe(root.phase, i, 0.7);
        background: root.gold;
    }
}

// ── 25 · 龙舟竞渡 ───────────────────────────────────────────────────────────

component SceneBoat inherits Rectangle {
    in property <int> side: 0;
    in property <float> phase: 0;

    width: 100%;
    height: 100%;
    background: Colors.transparent;

    property <color> wave: Theme.dark ? (#6fb8d8) : (#2a5a78);
    property <color> gold: Theme.skin.signature;

    // 后景：月光
    Rectangle {
        width: root.width * 0.34;
        height: self.width;
        border-radius: self.width / 2;
        x: root.width * SideArt.mx(root.side, 0.34);
        y: root.height * 0.08;
        background: @radial-gradient(circle,
            (#fff2cf).with-alpha(0.28) 0%,
            Colors.transparent 70%);
    }

    // 中景：三条水波，从后往前。
    for i in 3: Path {
        width: root.width * 1.2;
        height: root.height * 0.10;
        x: (Math.mod(root.phase * (0.08 + i * 0.05) + i * 0.23, 1.2) - 0.1) * root.width
            - root.width * 0.05;
        y: root.height * (0.60 + i * 0.11);
        viewbox-width: 100;
        viewbox-height: 16;
        fit: fill;
        fill: @linear-gradient(180deg,
            root.wave.with-alpha(0.20 + i * 0.06) 0%,
            root.wave.with-alpha(0.04) 100%);
        commands: "M 0 10 C 10 4 20 14 30 10 C 40 4 50 14 60 10 C 70 4 80 14 90 10 C 96 7 100 6 100 6 L 100 16 L 0 16 Z";
    }

    // 龙舟：船身 + 龙头 + 一排短桨
    for i in 2: Rectangle {
        width: root.width * (i == 0 ? 0.86 : 0.56);
        height: root.width * (i == 0 ? 0.30 : 0.20);
        x: root.width * SideArt.mx(root.side, i == 0 ? 0.28 : 0.58) - self.width / 2;
        y: root.height * (i == 0 ? 0.62 : 0.53)
            + Math.sin((root.phase * 360 + i * 90) * 1deg) * 5px;
        opacity: i == 0 ? 1.0 : 0.60;

        // 船身
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 35;
            fit: fill;
            fill: @linear-gradient(180deg,
                (#7a2a1a).with-alpha(0.75) 0%,
                (#3a100c).with-alpha(0.90) 100%);
            stroke: root.gold.with-alpha(0.45);
            stroke-width: 1.2px;
            commands: "M 2 12 L 20 8 L 80 8 L 98 12 C 88 30 70 34 50 34 C 30 34 12 30 2 12 Z";
        }
        // 龙头
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 35;
            fit: fill;
            fill: root.gold.with-alpha(0.80);
            stroke: (root.gold.mix(#ffffff, 0.4)).with-alpha(0.6);
            stroke-width: 1px;
            commands: "M 3 12 C 2 4 8 0 14 2 C 18 4 18 10 14 12 Z";
        }
        // 桨
        for j in 4: Rectangle {
            x: parent.width * (0.24 + j * 0.17);
            y: parent.height * 0.55;
            width: 1.6px;
            height: parent.height * 0.75;
            background: root.gold.with-alpha(0.30);
        }
    }

    // 前景：水花与光点。
    for i in 9: Rectangle {
        width: 2px;
        height: 2px;
        border-radius: 1px;
        x: root.width * SideArt.rnd(i, 167)
            + Math.sin((root.phase * 360 + i * 67) * 1deg) * root.width * 0.05;
        y: Math.mod(SideArt.rnd(i, 169) - root.phase * 0.09, 1.0) * root.height;
        opacity: 0.16 + 0.34 * SideArt.breathe(root.phase, i, 0.9);
        background: (#dff2ff);
    }
}

// ── 26 · 福字铜钱 ───────────────────────────────────────────────────────────

component SceneCoin inherits Rectangle {
    in property <int> side: 0;
    in property <float> phase: 0;

    width: 100%;
    height: 100%;
    background: Colors.transparent;

    property <color> gold: Theme.skin.signature;
    property <color> warm: #fff0c8;
    property <color> red: (#d8402e);

    // 中景：一串会翻面的铜钱往下落。
    for i in 9: Rectangle {
        width: root.width * (0.24 + 0.12 * SideArt.rnd(i, 171))
            * (0.42 + 0.58 * Math.abs(Math.sin((root.phase * 360 * (0.7 + 0.5 * SideArt.rnd(i, 173)) + i * 73) * 1deg)));
        height: self.width;
        x: root.width * SideArt.mx(root.side, 0.18 + 0.64 * SideArt.rnd(i, 175)) - self.width / 2
            + Math.sin((root.phase * 360 + i * 87) * 1deg) * root.width * 0.04;
        y: Math.mod(SideArt.rnd(i, 177) - root.phase * (0.05 + 0.04 * SideArt.rnd(i, 179)), 1.0)
            * (root.height + root.width * 0.4) - root.width * 0.2;

        // 钱面
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: self.width / 2;
            background: @radial-gradient(circle,
                root.warm.with-alpha(0.80) 0%,
                root.gold.with-alpha(0.70) 58%,
                root.gold.mix(#7a5a18, 0.5).with-alpha(0.72) 100%);
        }
        // 方孔
        Rectangle {
            width: parent.width * 0.30;
            height: parent.width * 0.30;
            x: parent.width * 0.35;
            y: parent.width * 0.35;
            background: (#241608).with-alpha(0.55);
        }
        // 钱缘
        Rectangle {
            width: parent.width * 0.82;
            height: parent.width * 0.82;
            x: parent.width * 0.09;
            y: parent.width * 0.09;
            border-radius: self.width / 2;
            border-width: 1px;
            border-color: root.warm.with-alpha(0.45);
            background: Colors.transparent;
        }
    }

    // 后景：一条红绸软软地飘。
    Path {
        width: 100%;
        height: root.height * 0.7;
        y: root.height * 0.12;
        viewbox-width: 100;
        viewbox-height: 60;
        fit: fill;
        stroke: root.red.with-alpha(0.30);
        stroke-width: 2.4px;
        stroke-line-cap: round;
        commands: "M 6 8 C 28 16 20 30 40 38 C 60 46 66 54 92 50";
    }

    for i in 8: Rectangle {
        width: 1.6px;
        height: 1.6px;
        border-radius: 0.8px;
        x: root.width * SideArt.rnd(i, 181);
        y: Math.mod(SideArt.rnd(i, 183) - root.phase * 0.07, 1.0) * root.height;
        opacity: 0.16 + 0.34 * SideArt.breathe(root.phase, i, 0.8);
        background: root.warm;
    }
}

// ── 27 · 舞狮贺岁 ───────────────────────────────────────────────────────────

component LionHead inherits Rectangle {
    in property <length> size: 100px;
    in property <float> alpha: 1.0;
    in property <color> gold: #e8b04b;
    in property <color> red: #c8402a;

    width: root.size;
    height: root.size;
    background: Colors.transparent;

    // 鬃毛：一圈小圆
    for i in 14: Rectangle {
        width: root.size * 0.24;
        height: self.width;
        border-radius: self.width / 2;
        x: root.size * 0.5 + Math.cos((i * 25.7) * 1deg) * root.size * 0.36 - self.width / 2;
        y: root.size * 0.5 + Math.sin((i * 25.7) * 1deg) * root.size * 0.36 - self.height / 2;
        opacity: (0.26 + 0.12 * Math.mod(i, 2)) * root.alpha;
        background: Math.mod(i, 3) == 0 ? root.red : root.gold;
    }
    // 脸
    Rectangle {
        width: root.size * 0.62;
        height: root.size * 0.58;
        x: (root.size - self.width) / 2;
        y: (root.size - self.height) / 2;
        border-radius: self.width * 0.46;
        background: @radial-gradient(circle,
            root.red.mix(#ffd0a0, 0.55).with-alpha(0.85 * root.alpha) 0%,
            root.red.with-alpha(0.80 * root.alpha) 72%,
            root.red.mix(#3a0a08, 0.5).with-alpha(0.85 * root.alpha) 100%);
    }
    // 大眼
    for i in 2: Rectangle {
        width: root.size * 0.17;
        height: root.size * 0.17;
        border-radius: self.width / 2;
        x: root.size * (i == 0 ? 0.27 : 0.56);
        y: root.size * 0.38;
        background: (#fff6e0).with-alpha(0.92 * root.alpha);
    }
    for i in 2: Rectangle {
        width: root.size * 0.07;
        height: root.size * 0.07;
        border-radius: self.width / 2;
        x: root.size * (i == 0 ? 0.32 : 0.61);
        y: root.size * 0.43;
        background: (#241410).with-alpha(0.90 * root.alpha);
    }
    // 鼻与口
    Rectangle {
        width: root.size * 0.16;
        height: root.size * 0.10;
        x: root.size * 0.42;
        y: root.size * 0.60;
        border-radius: self.width * 0.5;
        background: root.gold.with-alpha(0.80 * root.alpha);
    }
    Rectangle {
        width: root.size * 0.24;
        height: root.size * 0.055;
        x: root.size * 0.38;
        y: root.size * 0.72;
        border-radius: self.height / 2;
        background: (#2a0a08).with-alpha(0.75 * root.alpha);
    }
    // 独角
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fit: fill;
        fill: root.gold.with-alpha(0.85 * root.alpha);
        commands: "M 46 14 C 44 6 50 0 58 2 C 56 8 53 12 46 14 Z";
    }
}

component SceneLion inherits Rectangle {
    in property <int> side: 0;
    in property <float> phase: 0;

    width: 100%;
    height: 100%;
    background: Colors.transparent;

    property <color> gold: Theme.skin.signature;

    // 后景：喜气的一团暖红光。
    Rectangle {
        width: 100%;
        height: root.height * 0.5;
        y: root.height * 0.25;
        background: @radial-gradient(circle,
            (#ff7a52).with-alpha(0.13) 0%,
            Colors.transparent 66%);
    }

    // 两只狮头：一前一后，上上下下。
    for i in 2: LionHead {
        size: root.width * (i == 0 ? 0.88 : 0.60);
        alpha: i == 0 ? 1.0 : 0.62;
        x: root.width * SideArt.mx(root.side, 0.34 + i * 0.28) - self.width / 2
            + Math.sin((root.phase * 360 + i * 110) * 1deg) * root.width * 0.04;
        y: root.height * (0.16 + i * 0.40)
            + Math.sin((root.phase * 360 + i * 160) * 1deg) * root.width * 0.05;
        gold: root.gold;
    }

    // 前景：金红纸屑。
    for i in 10: Rectangle {
        width: (3.0 + 2.0 * SideArt.rnd(i, 185)) * 1px;
        height: self.width * 0.5;
        border-radius: 1px;
        x: root.width * SideArt.rnd(i, 187)
            + Math.sin((root.phase * 360 + i * 97) * 1deg) * root.width * 0.06;
        y: Math.mod(SideArt.rnd(i, 189) + root.phase * (0.10 + 0.08 * SideArt.rnd(i, 191)), 1.0)
            * root.height;
        opacity: 0.20 + 0.36 * SideArt.breathe(root.phase, i, 1.0);
        background: Math.mod(i, 3) == 0 ? (#ffd98a) : (#e8503c);
    }
}

// ── 29 · 雪落红梅 ───────────────────────────────────────────────────────────

component Blossom inherits Rectangle {
    in property <length> size: 26px;
    in property <float> alpha: 1.0;
    in property <color> petal: #ff8f86;

    width: root.size;
    height: root.size;
    background: Colors.transparent;

    for i in 5: Rectangle {
        width: root.size * 0.46;
        height: self.width;
        border-radius: self.width / 2;
        x: root.size * 0.5 + Math.cos((i * 72.0 - 90.0) * 1deg) * root.size * 0.23 - self.width / 2;
        y: root.size * 0.5 + Math.sin((i * 72.0 - 90.0) * 1deg) * root.size * 0.23 - self.height / 2;
        opacity: 0.72 * root.alpha;
        background: root.petal;
    }
    Rectangle {
        width: root.size * 0.22;
        height: self.width;
        border-radius: self.width / 2;
        x: (root.size - self.width) / 2;
        y: (root.size - self.height) / 2;
        background: (#ffe6a0).with-alpha(0.90 * root.alpha);
    }
}

component ScenePlum inherits Rectangle {
    in property <int> side: 0;
    in property <float> phase: 0;

    width: 100%;
    height: 100%;
    background: Colors.transparent;

    property <color> wood: Theme.dark ? (#8a4a3a) : (#5a3226);
    property <color> petal: (#ff8f86);

    // 中景：一条从上方伸下来的梅枝，两条分叉。
    Path {
        width: 100%;
        height: root.height * 0.75;
        viewbox-width: 100;
        viewbox-height: 100;
        fit: fill;
        stroke: root.wood.with-alpha(0.42);
        stroke-width: root.width * 0.035;
        stroke-line-cap: round;
        commands: "M 20 0 C 32 14 28 28 40 42 C 50 54 44 70 56 84 M 40 42 C 56 44 68 38 80 26 M 28 22 C 40 24 52 20 62 14";
    }
    for i in 3: Path {
        width: 100%;
        height: root.height * 0.5;
        x: root.width * (0.10 + i * 0.22);
        y: root.height * (0.12 + i * 0.20);
        viewbox-width: 60;
        viewbox-height: 100;
        fit: fill;
        stroke: root.wood.with-alpha(0.26);
        stroke-width: root.width * 0.016;
        stroke-line-cap: round;
        commands: "M 10 0 C 18 18 12 34 22 50 C 28 60 24 72 30 86";
    }

    // 梅花：沿枝开，大小错落。
    for i in 10: Blossom {
        size: root.width * (0.16 + 0.10 * SideArt.rnd(i, 193));
        alpha: 0.60 + 0.40 * SideArt.rnd(i, 195);
        x: root.width * SideArt.mx(root.side, 0.12 + 0.66 * SideArt.rnd(i, 197)) - self.width / 2;
        y: root.height * (0.06 + 0.56 * SideArt.rnd(i, 199));
        petal: root.petal;
    }

    // 后景：雾与暖光。
    Rectangle {
        width: 100%;
        height: root.height * 0.4;
        y: root.height * 0.06;
        background: @radial-gradient(circle,
            (#ff7a6a).with-alpha(0.10) 0%,
            Colors.transparent 70%);
    }

    // 前景：飘雪 + 落瓣。
    for i in 16: Rectangle {
        width: (1.4 + 1.6 * SideArt.rnd(i, 201)) * 1px;
        height: self.width;
        border-radius: self.width / 2;
        x: Math.mod(SideArt.rnd(i, 203) + root.phase * 0.015, 1.0) * root.width;
        y: Math.mod(SideArt.rnd(i, 205) + root.phase * (0.05 + 0.04 * SideArt.rnd(i, 207)), 1.0)
            * root.height;
        opacity: 0.18 + 0.34 * SideArt.breathe(root.phase, i, 0.6);
        background: #fff2e8;
    }
    for i in 5: Rectangle {
        width: 5px;
        height: 3px;
        border-radius: 2px;
        x: root.width * SideArt.rnd(i, 209)
            + Math.sin((root.phase * 360 + i * 83) * 1deg) * root.width * 0.06;
        y: Math.mod(SideArt.rnd(i, 211) + root.phase * 0.10, 1.0) * root.height;
        opacity: 0.20 + 0.26 * SideArt.breathe(root.phase, i, 0.7);
        background: root.petal;
    }
}
// ── 场景调度 ─────────────────────────────────────────────────────────────────

component SceneStage inherits Rectangle {
    in property <int> side: 0;
    in property <float> phase: 0;

    width: 100%;
    height: 100%;
    background: Colors.transparent;

    if Theme.skin.style == 1 || Theme.skin.style == 11: SceneDragon {
        side: root.side;
        phase: root.phase;
    }
    if Theme.skin.style == 8: SceneDragon {
        side: root.side;
        phase: root.phase;
        relief: true;
    }
    if Theme.skin.style == 2: SceneTech { side: root.side; phase: root.phase; }
    if Theme.skin.style == 3: SceneCyber { side: root.side; phase: root.phase; }
    if Theme.skin.style == 4 || Theme.skin.style == 18: SceneInk { side: root.side; phase: root.phase; }
    if Theme.skin.style == 5: SceneStars { side: root.side; phase: root.phase; }
    if Theme.skin.style == 6: SceneDawn { side: root.side; phase: root.phase; }
    if Theme.skin.style == 7: SceneJade { side: root.side; phase: root.phase; }
    if Theme.skin.style == 9: SceneIce { side: root.side; phase: root.phase; }
    if Theme.skin.style == 10: SceneGold { side: root.side; phase: root.phase; }
    if Theme.skin.style == 12: SceneLantern { side: root.side; phase: root.phase; }
    if Theme.skin.style == 28: SceneLantern { side: root.side; phase: root.phase; many: true; }
    if Theme.skin.style == 13 || Theme.skin.style == 30: SceneCloud { side: root.side; phase: root.phase; }
    if Theme.skin.style == 14: ScenePalace { side: root.side; phase: root.phase; }
    if Theme.skin.style == 15: SceneWall { side: root.side; phase: root.phase; }
    if Theme.skin.style == 16: ScenePaperCut { side: root.side; phase: root.phase; }
    if Theme.skin.style == 17: SceneFireworks { side: root.side; phase: root.phase; }
    if Theme.skin.style == 19: ScenePeony { side: root.side; phase: root.phase; }
    if Theme.skin.style == 20: SceneKoi { side: root.side; phase: root.phase; }
    if Theme.skin.style == 21: ScenePorcelain { side: root.side; phase: root.phase; }
    if Theme.skin.style == 22: SceneOpera { side: root.side; phase: root.phase; }
    if Theme.skin.style == 23: SceneBamboo { side: root.side; phase: root.phase; }
    if Theme.skin.style == 24: SceneFan { side: root.side; phase: root.phase; }
    if Theme.skin.style == 25: SceneBoat { side: root.side; phase: root.phase; }
    if Theme.skin.style == 26: SceneCoin { side: root.side; phase: root.phase; }
    if Theme.skin.style == 27: SceneLion { side: root.side; phase: root.phase; }
    if Theme.skin.style == 29: ScenePlum { side: root.side; phase: root.phase; }
}

/// 一侧的带子：场景 + 遮罩 + 焦点光。
component SideBand inherits Rectangle {
    in property <int> side: 0;
    in property <length> screen-w: 0px;
    in property <length> band-w: 120px;
    in property <float> phase: 0;

    width: 100%;
    height: 100%;
    background: Colors.transparent;
    clip: true;

    // 指针在附近时这一侧亮一点：焦点处稍亮，非焦点弱化。
    property <length> centre-x: root.side == 0 ? root.band-w / 2
        : root.screen-w - root.band-w / 2;
    property <float> nearby: Math.max(0.0, 1.0
        - Math.abs(Theme.cursor-x - root.centre-x) / (root.band-w * 2.6));
    property <float> lift: Theme.side-art-motion ? 0.80 + 0.20 * root.nearby : 0.90;

    // 场景本身（全部主题共用一块画布，按皮肤换景）。
    SceneStage {
        width: 100%;
        height: 100%;
        side: root.side;
        phase: root.phase;
        opacity: root.lift;
    }

    // 焦点处的柔光：指针靠近时从这一侧的外缘渗进来一点皮肤签名色。
    Rectangle {
        width: 100%;
        height: 100%;
        opacity: root.nearby;
        background: @radial-gradient(circle,
            Theme.skin.signature.with-alpha(0.10) 0%,
            Colors.transparent 58%);
    }

    // 向中间渐隐：靠内的一半盖成页面底色，装饰不会压到内容列上，文字
    // 对比度也不变（盖住的是画，不是字）。
    Rectangle {
        x: root.side == 0 ? root.band-w * 0.52 : 0px;
        width: root.band-w * 0.48;
        height: 100%;
        background: root.side == 0
            ? @linear-gradient(90deg,
                Theme.launch-page.with-alpha(0.0) 0%,
                Theme.launch-page.with-alpha(0.72) 62%,
                Theme.launch-page 100%)
            : @linear-gradient(90deg,
                Theme.launch-page 0%,
                Theme.launch-page.with-alpha(0.72) 38%,
                Theme.launch-page.with-alpha(0.0) 100%);
    }

    // 上下和外侧压一点暗角：整幅画落在窗口里，不像是贴上去的。
    Rectangle {
        width: 100%;
        height: 14%;
        y: 0px;
        background: @linear-gradient(180deg,
            Theme.launch-page.with-alpha(0.55) 0%,
            Colors.transparent 100%);
    }

    Rectangle {
        width: 100%;
        height: 16%;
        y: root.height - self.height;
        background: @linear-gradient(0deg,
            Theme.launch-page.with-alpha(0.62) 0%,
            Colors.transparent 100%);
    }

    Rectangle {
        x: root.side == 0 ? 0px : root.band-w - root.band-w * 0.10;
        width: root.band-w * 0.10;
        height: 100%;
        background: root.side == 0
            ? @linear-gradient(90deg, Theme.launch-page.with-alpha(0.30) 0%, Colors.transparent 100%)
            : @linear-gradient(90deg, Colors.transparent 0%, Theme.launch-page.with-alpha(0.30) 100%);
    }
}

/// 两侧装饰的整体容器：两块等宽的立式带子。
export component HomeSideArt inherits Rectangle {
    /// 和背景风景同一相位，0..1 一圈。
    in property <float> phase: 0;
    /// 每侧带宽（由 HomeBackdrop 按内容列两侧的空白算好）。
    in property <length> band: 120px;

    width: 100%;
    height: 100%;
    background: Colors.transparent;
    clip: true;

    for s in 2: SideBand {
        x: s == 0 ? 0px : root.width - root.band;
        width: root.band;
        height: 100%;
        side: s;
        screen-w: root.width;
        band-w: root.band;
        phase: root.phase;
    }
}

