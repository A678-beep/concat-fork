        width: root.width * 0.13;
        height: self.width * 0.55;
        border-radius: self.width / 2;
        background: (#f7f0e0).with-alpha(0.95 * root.alpha);
    }
    Rectangle {
        x: root.width * 0.61;
        y: root.height * 0.44;
        width: root.width * 0.13;
        height: self.width * 0.55;
        border-radius: self.width / 2;
        background: (#f7f0e0).with-alpha(0.95 * root.alpha);
    }
    Rectangle {
        x: root.width * 0.30;
        y: root.height * 0.465;
        width: root.width * 0.05;
        height: self.width;
        border-radius: self.width / 2;
        background: (#201414).with-alpha(0.85 * root.alpha);
    }
    Rectangle {
        x: root.width * 0.65;
        y: root.height * 0.465;
        width: root.width * 0.05;
        height: self.width;
        border-radius: self.width / 2;
        background: (#201414).with-alpha(0.85 * root.alpha);
    }
    // 嘴
    Path {
