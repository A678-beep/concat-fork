        stroke-width: 2.4px;
        stroke-line-cap: round;
        commands: "M 34 78 C 40 84 50 84 56 78";
    }
}

component SceneOpera inherits Rectangle {
    in property <int> side: 0;
    in property <float> phase: 0;

    width: 100%;
