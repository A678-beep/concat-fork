    /// The surface ladder the gallery draws a card's mini window from, on the
    /// base the skin was drawn for. The same arithmetic as `Theme.tone`, with
    /// the spec passed in rather than read off the global.
    public pure function preview-page(spec: SkinSpec) -> color {
        return Skins.preview(spec.base-light ? Light.launch-page : Dark.launch-page, spec, 2.2);
    }

    public pure function preview-panel(spec: SkinSpec) -> color {
        return Skins.preview(spec.base-light ? Light.panel : Dark.panel, spec, 1.0);
    }

    public pure function preview-raised(spec: SkinSpec) -> color {
        return Skins.preview(spec.base-light ? Light.raised : Dark.raised, spec, 1.0);
    }

    public pure function preview-well(spec: SkinSpec) -> color {
        return Skins.preview(spec.base-light ? Light.well : Dark.well, spec, 1.0);
    }

    public pure function preview-line(spec: SkinSpec) -> color {
        return spec.base-light ? Light.line : Dark.line;
    }

    public pure function preview-fg(spec: SkinSpec) -> color {
        return spec.base-light ? Light.fg : Dark.fg;
    }

    public pure function preview-fg-muted(spec: SkinSpec) -> color {
        return spec.base-light ? Light.fg-muted : Dark.fg-muted;
    }

    /// `base` with `spec`'s seed mixed in at the strength of the base it was
    /// drawn for, `boost` times stronger (the page takes a deeper cut than a
    /// panel, so the scenery behind the gutters reads).
    public pure function preview(base: color, spec: SkinSpec, boost: float) -> color {
        let strength = (spec.base-light ? spec.light-strength : spec.dark-strength) * boost;
        return strength <= 0.0 ? base : base.mix(spec.seed, 1.0 - Math.min(0.55, strength));
    }
}
