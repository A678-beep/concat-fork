// The theme skins: the looks Settings > Appearance offers beside the two
// greys the app has always had.
//
// A skin is a *tone*, not a redraw: a hue the surfaces are mixed towards, the
// signature colour its scenery is painted in, a backdrop style, and the
// accent it wears when it is picked. The relationship between the ladder's
// steps, the text's contrasts and every kind's pair is the palette's, kept
// because the skin only ever nudges the surfaces it is allowed to nudge (see
// `Theme.tone`). That is also why a skin can be worn on either base: mix its
// hue into the dark ladder and it is a dark room, into the light ladder and
// it is a bright one, with the contrasts the palette's header promises still
// held in both.
//
// Everything drawn for a skin is procedurally generated vector and particle
// work, drawn by the same GPU the window already renders with: there is no
// video, no GIF and no borrowed artwork anywhere behind these presets. The
// dragon and cloud curls, the star field, the mountain silhouettes and the
// grid are all paths and rectangles built from numbers in this file and in
// `backdrop.slint`.
//
// 0 is Minimal Dark: no hue, no scenery, no timer. It is the default for the
// reason the task card gives - a window nobody is looking at should cost
// nothing - and every other skin is opt-in.
//
// 0.3.3 adds two dozen more ("国潮"), all programmatic as well: gold dragons
// and cloud seas, lanterns, fireworks, ink, koi, porcelain, opera masks,
// bamboo, fans, plum blossom and three pure-metal/glaze looks for business
// cards. They are grouped in the gallery (`group` 0 classic / 1 国潮) and
// every one of them is a still under Low-power mode, like the first eight.

import { Dark } from "dark.slint";
import { Light } from "light.slint";

export struct SkinSpec {
    /// The id it is remembered under in settings.json, lower-cased words.
    id: string,
    /// The name the gallery shows.
    name: string,
    /// One line under the name: what the look is, in plain words.
    hint: string,
    /// The gallery group: 0 is the original eight (经典), 1 is 国潮.
    group: int,
    /// The scenery drawn behind the panes:
    /// 0 plain / 1 dragon-gold / 2 tech-blue / 3 cyber-violet /
    /// 4 teal-ink landscape / 5 deep stars / 6 warm dawn / 7 ink jade /
    /// 8 pure gold dragon / 9 pure cyan / 10 pure gold /
    /// 11 gold dragon cloud / 12 red lantern / 13 xiangyun /
    /// 14 palace silhouette / 15 great wall dusk / 16 paper cut /
    /// 17 fireworks / 18 ink landscape / 19 peony / 20 koi /
    /// 21 blue porcelain / 22 opera mask / 23 bamboo / 24 folding fan /
    /// 25 dragon boat / 26 fu coin / 27 lion dance / 28 lantern corridor /
    /// 29 plum snow / 30 crimson gold cloud.
    style: int,
    /// The base palette the gallery shows this skin on: a look designed on a
    /// dark ground reads wrong on a light one, so the card previews it where
    /// it was drawn rather than where the window happens to be. The window
    /// itself can wear it on either base; the settings page keeps its own
    /// Dark/Light row for that.
    base-light: bool,
    /// The hue mixed into the surfaces, and the strength (0..1) it is mixed
    /// at on each base. 0 leaves the palette exactly as it ships.
    seed: color,
    dark-strength: float,
    light-strength: float,
    /// The colour the scenery's glow, stars, strokes and shimmer are painted
    /// in. It is the skin's signature, not the accent: the accent follows the
    /// user's own choice after the skin has been picked.
    signature: color,
    /// Which of `Theme.accent-names` the skin wears when it is picked.
    accent: int,
}

