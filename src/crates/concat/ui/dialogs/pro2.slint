    }

    Rectangle { vertical-stretch: 1; }
}

// 左侧导航项（与 0.3.7 面板同一形状）。
component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <Glyph> glyph;
    in property <bool> current;

    callback picked();

    height: 42px;
    border-radius: Theme.r;
    background: root.current ? Theme.accent-soft : (touch.has-hover ? Theme.field-hover : transparent);
    border-width: 1px;
    border-color: root.current ? Theme.accent : transparent;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 7px;
        spacing: 8px;

        Icon {
            glyph: root.glyph;
            size: 14px;
            tint: root.current ? Theme.accent : Theme.fg-muted;
        }

        VerticalLayout {
            alignment: center;
            vertical-stretch: 1;

            Text {
                text: root.label;
                color: root.current ? Theme.fg : Theme.fg-muted;
                font-size: Theme.fs-sm;
                font-weight: root.current ? Theme.weight-title : Theme.weight-body;
            }

            if root.note != "": Text {
                text: root.note;
                color: Theme.fg-dim;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// ── 面板 ─────────────────────────────────────────────────────────────

export component Pro2Dialog inherits Modal {
    in property <Pro2Data> data;
    in property <[Pro2Row]> credits-templates;
    in property <[Pro2Row]> assembly-materials;
    in property <[Pro2Row]> assembly-edl;
    in property <[Pro2Row]> assembly-gaps;
    in property <[string]> vfx-effects;
    in property <[string]> vfx-presets;
    in property <[Pro2Row]> vfx-jobs;
    in property <[string]> music-styles;
    in property <[Pro2Row]> music-cues;
    in property <[string]> voice-roles;
    in property <[Pro2Row]> continuity-issues;
    in property <[Pro2Row]> continuity-runs;
    in property <[string]> style-profiles;
    in property <[Pro2Row]> style-metrics;
    in property <[Pro2Row]> assets;
    in property <image> preview;
    in property <bool> has-preview;

    callback action(action: string, index: int, text: string);
    callback tick();

    open: root.data.open;
    title: "影视专业 · 0.4.0";
    glyph: Glyph.film;
    surface-width: 1330px;
    surface-height: 860px;

    Timer {
        interval: 1000ms;
        running: root.data.open;
        triggered => { root.tick(); }
    }

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        // ── 左侧导航 ──
        Rectangle {
            width: 190px;
            background: Theme.well;
            border-radius: Theme.r;
            border-width: 1px;
            border-color: Theme.line;

            VerticalLayout {
                padding: 8px;
                spacing: 3px;

                Text {
                    text: "影视专业 0.4.0";
                    color: Theme.fg;
                    font-size: Theme.fs-lg;
                    font-weight: Theme.weight-display;
                }
                Text {
                    text: "导演台 · 片头片尾 · 实拍装配 · 特效 · 配乐 · 配音 · 连贯性 · 风格";
                    color: Theme.fg-dim;
                    font-size: Theme.fs-xs;
                    wrap: word-wrap;
                }

                Rectangle { height: 6px; }

                Text { text: "导演"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                NavItem {
                    label: "导演台（双屏）";
                    note: "独立窗口 · 实时同步";
                    glyph: Glyph.eye;
                    current: root.data.tab == 0;
                    picked => { root.action("tab", 0, ""); }
                }

                Text { text: "制作"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                NavItem {
                    label: "片头片尾";
                    note: "演职人员表 · 生成 · 导出";
                    glyph: Glyph.film;
                    current: root.data.tab == 1;
                    picked => { root.action("tab", 1, ""); }
                }
                NavItem {
                    label: "实拍装配";
                    note: "素材 + 剧本 → EDL";
                    glyph: Glyph.import;
                    current: root.data.tab == 2;
                    picked => { root.action("tab", 2, ""); }
                }
                NavItem {
                    label: "特效";
                    note: "9 类 / 27 预设";
                    glyph: Glyph.sparkle;
                    current: root.data.tab == 3;
                    picked => { root.action("tab", 3, ""); }
                }
                NavItem {
                    label: "配乐";
                    note: "28 风格 · 按场景配乐";
                    glyph: Glyph.music;
                    current: root.data.tab == 4;
                    picked => { root.action("tab", 4, ""); }
                }
                NavItem {
                    label: "配音";
                    note: "40 角色 · 情感台词";
                    glyph: Glyph.mic;
                    current: root.data.tab == 5;
                    picked => { root.action("tab", 5, ""); }
                }

                Text { text: "检查"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                NavItem {
                    label: "连贯性检查";
                    note: "总分 · 问题 · HTML";
                    glyph: Glyph.check;
                    current: root.data.tab == 6;
                    picked => { root.action("tab", 6, ""); }
                }
                NavItem {
                    label: "风格匹配";
                    note: "参考片 · LUT";
                    glyph: Glyph.link;
                    current: root.data.tab == 7;
                    picked => { root.action("tab", 7, ""); }
                }
                NavItem {
                    label: "素材质量";
                    note: "电影候选 / 商用高清";
                    glyph: Glyph.image;
                    current: root.data.tab == 8;
                    picked => { root.action("tab", 8, ""); }
                }

                Rectangle { vertical-stretch: 1; }

                Text {
                    text: root.data.signed-in ? "已登录星籁账号" : "未登录：生成类接口需先登录（读接口仍可用）";
                    color: root.data.signed-in ? Theme.fg-dim : Theme.accent;
                    font-size: Theme.fs-xs;
                    wrap: word-wrap;
                }
            }
        }

        // ── 右侧内容 ──
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;

            Hint { text: root.data.hint; }

            if root.data.tab == 0: PaneScroll {
                vertical-stretch: 1;
                DirectorPage {
                    data: root.data;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }

            if root.data.tab == 1: PaneScroll {
                vertical-stretch: 1;
                CreditsPage {
                    data: root.data;
                    templates: root.credits-templates;
                    preview: root.preview;
                    has-preview: root.has-preview;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }

            if root.data.tab == 2: PaneScroll {
                vertical-stretch: 1;
                AssemblyPage {
                    data: root.data;
                    materials: root.assembly-materials;
                    edl: root.assembly-edl;
                    gaps: root.assembly-gaps;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }

            if root.data.tab == 3: PaneScroll {
                vertical-stretch: 1;
                VfxPage {
                    data: root.data;
                    effects: root.vfx-effects;
                    presets: root.vfx-presets;
                    jobs: root.vfx-jobs;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }

            if root.data.tab == 4: PaneScroll {
                vertical-stretch: 1;
                MusicPage {
                    data: root.data;
                    styles: root.music-styles;
                    cues: root.music-cues;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }

            if root.data.tab == 5: PaneScroll {
                vertical-stretch: 1;
                VoicePage {
                    data: root.data;
                    roles: root.voice-roles;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }

            if root.data.tab == 6: PaneScroll {
                vertical-stretch: 1;
                ContinuityPage {
                    data: root.data;
                    issues: root.continuity-issues;
                    runs: root.continuity-runs;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }

            if root.data.tab == 7: PaneScroll {
                vertical-stretch: 1;
                StylePage {
                    data: root.data;
                    profiles: root.style-profiles;
                    metrics: root.style-metrics;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }

            if root.data.tab == 8: PaneScroll {
                vertical-stretch: 1;
                QualityPage {
                    data: root.data;
                    assets: root.assets;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }

            StatusBar {
                line: root.data.status-line;
                level: root.data.status-level;
            }
        }
    }
}
