component VoicePage inherits VerticalLayout {
    in property <Pro2Data> data;
    in property <[string]> roles;

    callback act(action: string, index: int, text: string);

    spacing: 8px;

    Card {
        title: "配音导演 · 角色音色 / 情感台词 / 试听";
        Note {
            text: "接口：GET /voice/roles（40 角色）、POST /voice/advise（逐句情感标注）、POST /voice/dub（异步配音）、GET /voice/task/{id}。真实通道当前以 edge-tts 兜底，逐句标注情感实现方式。";
        }

        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 2;
                spacing: 5px;
                Text { text: "角色音色"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                Select {
                    options: root.roles;
                    current: Math.max(0, root.data.vo-role);
                    changed(i) => { root.act("vo-role", i, ""); }
                }
            }
            VerticalLayout {
                width: 300px;
                spacing: 5px;
                Text { text: "台词情感"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                HorizontalLayout {
                    spacing: 4px;
                    for emo[i] in ["平静", "开心", "悲伤", "愤怒", "恐惧", "温柔", "激动", "耳语"]: Chip {
                        label: emo;
                        current: root.data.vo-emotion == i;
                        picked => { root.act("vo-emotion", i, ""); }
                    }
                }
            }
        }

        Field {
            value: root.data.vo-text;
            placeholder: "台词（例：这条街，我走了十年，今晚却觉得陌生。）";
            edited(t) => { root.act("vo-text", 0, t); }
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                label: "标注台词情感";
                clicked => { root.act("vo-advise", 0, ""); }
            }
            Button {
                label: "生成试听（配音）";
                primary: true;
                clicked => { root.act("vo-dub", 0, ""); }
            }
            Button {
                label: "打开试听";
                ghost: true;
                clicked => { root.act("vo-open", 0, ""); }
            }
            Button {
                label: "下载并插入";
                clicked => { root.act("vo-insert", 0, ""); }
            }
            Button {
                label: "网页版兜底";
                ghost: true;
                clicked => { root.act("web", 5, ""); }
            }
        }

        ProgressLine {
            progress: root.data.vo-progress;
            text: root.data.vo-task;
        }
        Note { text: root.data.vo-line; }
        Note { text: root.data.vo-advice; }
    }

    Rectangle { vertical-stretch: 1; }
}

// ── ⑦ 连贯性 ─────────────────────────────────────────────────────────

component ContinuityPage inherits VerticalLayout {
    in property <Pro2Data> data;
    in property <[Pro2Row]> issues;
    in property <[Pro2Row]> runs;

    callback act(action: string, index: int, text: string);

    spacing: 8px;

    Card {
        title: "连贯性与穿帮检查";
        Note {
            text: "接口：POST /continuity/audit（角色一致性 / 跨镜连贯 / 穿帮 / 光照时间）、GET /continuity/run/{id}、GET /continuity/list、HTML 报告。AI/算法辅助判定，结果仅供参考，需人工复核。";
        }

        HorizontalLayout {
            spacing: 8px;
            Field {
                value: root.data.ct-video;
                placeholder: "成片 URL（平台可下载地址）";
                edited(t) => { root.act("ct-video", 0, t); }
            }
            Button {
                label: "一键全面检查（audit）";
                primary: true;
                clicked => { root.act("ct-audit", 0, ""); }
            }
            Button {
                label: "打开 HTML 报告";
                ghost: true;
                clicked => { root.act("ct-report", 0, ""); }
            }
            Button {
                label: "刷新历史";
                ghost: true;
                clicked => { root.act("ct-list", 0, ""); }
            }
            Button {
                label: "网页版兜底";
                ghost: true;
                clicked => { root.act("web", 6, ""); }
            }
        }

        ProgressLine {
            progress: root.data.ct-score != "" ? 100 : (root.data.ct-status == "检查中" ? 40 : 0);
            text: root.data.ct-status;
        }
        Note { text: root.data.ct-line; }
    }

    HorizontalLayout {
        spacing: 10px;

        Card {
            horizontal-stretch: 1;
            title: "检查结果";
            KV { k: "分数"; v: root.data.ct-score; }
            KV { k: "报告"; v: root.data.ct-report; }
            if root.issues.length == 0: Note { text: "还没有结果：先跑一次总检。"; }
            for issue in root.issues: RowLine { entry: issue; }
        }

        Card {
            horizontal-stretch: 1;
            title: "最近检查";
            if root.runs.length == 0: Note { text: "没有历史记录。"; }
            for run in root.runs: RowLine { entry: run; }
        }
    }
}

// ── ⑧ 风格匹配 ───────────────────────────────────────────────────────

component StylePage inherits VerticalLayout {
    in property <Pro2Data> data;
    in property <[string]> profiles;
    in property <[Pro2Row]> metrics;

    callback act(action: string, index: int, text: string);

    spacing: 8px;

    Card {
        title: "导演风格指纹 · 参考片 → 分析 → 应用色彩 → 导出 LUT";
        Note {
            text: "接口：POST /style/analyze（节奏/运动/色彩/质感指纹）、POST /style/apply-color（色彩迁移 + ΔE00 指标）、POST /style/lut（.cube）、GET /style/list。统计迁移，不是 NST；参考片任务结束即删。";
        }

        HorizontalLayout {
            spacing: 8px;
            Field {
                value: root.data.st-ref;
                placeholder: "参考片 URL";
                edited(t) => { root.act("st-ref", 0, t); }
            }
            Field {
                value: root.data.st-target;
                placeholder: "目标片 URL（应用色彩用）";
                edited(t) => { root.act("st-target", 0, t); }
            }
            Field {
                value: root.data.st-strength;
                placeholder: "强度 0.85";
                technical: true;
                width: 120px;
                edited(t) => { root.act("st-strength", 0, t); }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                label: "分析参考片指纹";
                primary: true;
                clicked => { root.act("st-analyze", 0, ""); }
            }
            Button {
                label: "应用色彩";
                clicked => { root.act("st-apply", 0, ""); }
            }
            Button {
                label: "导出 LUT";
                clicked => { root.act("st-lut", 0, ""); }
            }
            Button {
                label: "打开色彩结果";
                ghost: true;
                clicked => { root.act("st-open", 0, ""); }
            }
            Button {
                label: "网页版兜底";
                ghost: true;
                clicked => { root.act("web", 7, ""); }
            }
        }

        Note { text: root.data.st-line; }
        Note { text: root.data.st-labels; }
        Note { text: root.data.st-metrics-line; }
    }

    HorizontalLayout {
        spacing: 10px;

        Card {
            horizontal-stretch: 1;
            title: "色彩指标（ΔE00）";
            if root.metrics.length == 0: Note { text: "应用色彩后这里出前后对比。"; }
            for m in root.metrics: RowLine { entry: m; }
        }

        Card {
            horizontal-stretch: 1;
            title: "已存风格指纹";
            if root.profiles.length == 0: Note { text: "还没有指纹。"; }
            for p[i] in root.profiles: RowLine {
                entry: { label: p, detail: "风格指纹", value: "", level: "" };
                clickable: true;
                action-label: "载入";
                acted => { root.act("st-pick", i, ""); }
            }
            KV { k: "当前指纹"; v: root.data.st-profile; }
            KV { k: "LUT"; v: root.data.st-lut; }
            KV { k: "色彩结果"; v: root.data.st-color; }
        }
    }
}

