component QualityPage inherits VerticalLayout {
    in property <Pro2Data> data;
    in property <[Pro2Row]> assets;

    callback act(action: string, index: int, text: string);

    spacing: 8px;

    Card {
        title: "素材库质量筛选";
        Note {
            text: "接口：GET /assets/search?quality=cinema_candidate|commercial_hd。电影候选 = 分辨率/码率/构图达标，可上大银幕；商用高清 = 满足商用清晰度门槛。徽章来自平台质量审计。";
        }

        HorizontalLayout {
            spacing: 6px;
            for label[i] in ["全部素材", "电影候选 cinema_candidate", "商用高清 commercial_hd"]: Chip {
                label: label;
                current: root.data.ql-filter == i;
                picked => { root.act("ql-filter", i, ""); }
            }
            Button {
                label: "搜索";
                primary: true;
                clicked => { root.act("ql-search", 0, ""); }
            }
            Button {
                label: "网页版素材库";
                ghost: true;
                clicked => { root.act("web", 8, ""); }
            }
        }

        Note { text: root.data.ql-line; }
        Tag { label: root.data.ql-badge; hot: true; }
    }

    Card {
        title: "质量筛选结果";
        if root.assets.length == 0: Note { text: "还没有结果：点「搜索」。"; }
