// 星籁 AI 短剧（0.3.1）：桌面内的多集短剧工作台。
//
// 按剪映 AI 短剧的内部 SOP（结构照，界面原创）做成 5 个阶段，每个阶段都能回头改：
//   ① 剧本框架：题材/集数/每集时长/画幅/风格 + 积分 + 合规 → 生成分集剧本
//   ② 剧本分镜：逐集标题/钩子、逐分镜画面描述/台词，可增删、上移下移
//   ③ 成片资产：角色卡（可增删改）+ 场景卡（来自分镜）+ 音频（音色/BGM）
//   ④ 分镜产物：逐镜配图（站内商用素材可换；AI 图/视频等接口就绪）+ 逐镜状态
//   ⑤ 本集拼接：单集 / 整剧队列 → 成片库 → 全部插入时间轴 / 导出剧本 JSON
//
// 后端 `/aidrama/*` 未就绪时面板常驻「后端联调中」，接口类按钮点下去会如实说明；
// 剧本可以先用本地模板编辑与导出——不做假按钮，也不假装成功。所有动作汇成一条
// action(action, index, text) 交给 Rust。

import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button, Field, Modal, Progress } from "../primitives/modal.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Select } from "../primitives/select.slint";
import { PaneScroll } from "../workspace/pane.slint";

/// AI 短剧的状态。字段由 Rust 写好；输入框的回写走 action 回调。
export struct AiDramaData {
    open: bool,
    /// 0 剧本框架、1 剧本分镜、2 成片资产、3 分镜产物、4 本集拼接。
    step: int,
    busy: bool,
    matching: bool,
    progress: float,
    stage: string,
    message: string,
    account-line: string,
    signed-in: bool,
    /// 内部账号（管理员）免扣。
    admin-exempt: bool,
    /// 后端 `/aidrama/*` 就绪。
    backend-ready: bool,
    backend-line: string,
    // ── ① 剧本框架 ──
    theme-pick: int,
    theme-text: string,
    episodes: int,
    duration: int,
    aspect: int,
    style: int,
    compliance: bool,
    theme-options: [string],
    // ── ② 剧本分镜 ──
    has-script: bool,
    script-summary: string,
    script-local: bool,
    /// 平台剧名 / 一句话卖点 / drama_id（本地模板示例时为空）。
    drama-title: string,
    drama-logline: string,
    drama-id: string,
    /// 平台限制一行。
    limits: string,
    episode-index: int,
    episode-count: int,
    episode-no: int,
    episode-title: string,
    episode-hook: string,
    scene-index: int,
    scene-count: int,
    scene-desc: string,
    scene-line: string,
    scene-asset: string,
    has-asset: bool,
    scene-has-candidates: bool,
    // ── ③ 成片资产 ──
    char-index: int,
    char-count: int,
    char-text: string,
    voice: int,
    bgm: int,
    // ── ④ 分镜产物 ──
    shot-ready: int,
    shot-total: int,
    // ── 计费 / 成片 ──
    estimate: string,
    aspect-line: string,
    output-count: int,
    queue-left: int,
    has-outputs: bool,
    compliance-text: string,
    web: string,
}

/// 一行小字。
component Note inherits Text {
    color: Theme.fg-dim;
    font-size: Theme.fs-xs;
    wrap: word-wrap;
}

/// 多行输入框。
component AreaText inherits Rectangle {
    in property <string> value;
    in property <string> placeholder;
    in property <length> box-height: 64px;
    callback edited(text: string);

    property <string> draft;
    init => { root.draft = root.value; }
    changed value => { if (!input.has-focus) { root.draft = root.value; } }

    min-height: root.box-height;
    max-height: root.box-height;
    background: Theme.field;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Colors.transparent;
    clip: true;

    input := TextInput {
        x: 9px;
        y: 7px;
        width: parent.width - 18px;
        height: parent.height - 14px;
        text <=> root.draft;
        edited => { root.edited(self.text); }
        color: Theme.fg;
        font-size: Theme.fs;
        single-line: false;
        wrap: word-wrap;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-accent;
    }

    if root.draft == "" && !input.has-focus: Text {
        x: 9px;
        y: 7px;
        width: parent.width - 18px;
        text: root.placeholder;
        color: Theme.fg-dim;
        font-size: Theme.fs;
        wrap: word-wrap;
    }
}

/// 一个下拉：上面一行小标题。
component Choice inherits VerticalLayout {
    in property <string> title;
    in property <[string]> options;
    in property <int> current;
    in property <length> field-width: 130px;
    callback changed(index: int);

    spacing: 2px;

    Text { text: root.title; color: Theme.fg-dim; font-size: Theme.fs-xs; }
    Select {
        width: root.field-width;
        options: root.options;
        current: root.current;
        changed(index) => { root.changed(index); }
    }
}

/// 合规确认行：一个勾 + 一句声明。
component ConsentRow inherits Rectangle {
    in property <bool> on;
    in property <string> text;
    callback toggled();

    height: 52px;
    background: Theme.field;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Colors.transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: Theme.r-sm;
                border-width: 1px;
                border-color: root.on ? Theme.accent : Theme.line-strong;
                background: root.on ? Theme.accent : Colors.transparent;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            glyph: Glyph.check;
                            size: 11px;
                            tint: Theme.on-accent;
                            visible: root.on;
                        }
                    }
                }
            }
        }

        label := Text {
            horizontal-stretch: 1;
            text: root.text;
            color: root.on ? Theme.fg : Theme.fg-muted;
            font-size: Theme.fs-xs;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

/// 列表里的一行：整行可点，当前项高亮。
component PickRow inherits Rectangle {
    in property <string> text;
    in property <bool> current;
    callback picked();

    height: 26px;
    border-radius: Theme.r-sm;
    background: root.current ? Theme.accent-soft
        : touch.has-hover ? Theme.field-hover
        : Colors.transparent;

    Text {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.text;
        color: root.current ? Theme.accent : Theme.fg-muted;
        font-size: Theme.fs-sm;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

/// 阶段进度条：五段，当前阶段亮着，已走过的阶段打勾。
component StageBar inherits Rectangle {
    in property <int> step;
    in property <[string]> labels;
    callback picked(index: int);

    height: 34px;
    background: Theme.field;
    border-radius: Theme.r;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;

        for label[index] in root.labels: Rectangle {
            horizontal-stretch: 1;
            border-radius: Theme.r-sm;
            background: index == root.step ? Theme.accent
                : index < root.step ? Theme.accent-soft
                : Colors.transparent;

            HorizontalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: label;
                    color: index == root.step ? Theme.on-accent
                        : index < root.step ? Theme.accent
                        : Theme.fg-dim;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(index); }
            }
        }
    }
}

export component AiDramaDialog inherits Modal {
    in property <AiDramaData> data;
    /// 剧本的分集行。
    in property <[string]> episodes;
    /// 当前集的分镜行。
    in property <[string]> scenes;
    /// ③ 角色卡。
    in property <[string]> characters;
    /// ⑤ 成片库。
    in property <[string]> outputs;
    /// 历史短剧。
    in property <[string]> history;

    /// 面板上的每个动作。
    callback action(action: string, index: int, text: string);

    open: root.data.open;
    title: "AI 短剧";
    glyph: Glyph.film;
    surface-width: 920px;
    surface-height: 740px;

    property <[string]> stages: [
        "① 剧本框架", "② 剧本分镜", "③ 成片资产", "④ 分镜产物", "⑤ 本集拼接",
    ];
    property <[string]> episode-options: [
        "1 集", "2 集", "3 集", "4 集", "5 集",
        "6 集", "7 集", "8 集", "9 集", "10 集",
    ];
    property <[string]> duration-options: ["30 秒", "45 秒", "60 秒"];
    property <[string]> aspect-options: ["9:16 竖屏", "16:9 横屏"];
    property <[string]> style-options: ["写实", "电影感", "国风", "动漫", "悬疑暗调"];
    property <[string]> voice-options: [
        "女声 · 温柔叙事", "女声 · 甜宠轻快", "男声 · 悬疑低音",
        "男声 · 都市沉稳", "旁白 · 纪录片感",
    ];
    property <[string]> bgm-options: [
        "悬疑压迫", "都市轻快", "甜宠温柔", "紧张鼓点", "国风古韵", "不用 BGM",
    ];

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        // ── 账号 / 后端 / 积分 ──
        HorizontalLayout {
            spacing: 8px;

            Text {
                text: root.data.account-line;
                color: root.data.signed-in ? Theme.fg-muted : Theme.warn;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if root.data.admin-exempt: Text {
                text: "内部账号 · 免扣积分";
                color: Theme.accent;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }

            Text {
                text: root.data.backend-ready ? "后端已就绪" : "后端联调中";
                color: root.data.backend-ready ? Theme.accent : Theme.warn;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }

            Button {
                label: "刷新后端";
                ghost: true;
                enabled: !root.data.busy;
                clicked => { root.action("refresh", 0, ""); }
            }
        }

        Text {
            text: root.data.backend-line;
            color: root.data.backend-ready ? Theme.fg-muted : Theme.warn;
            font-size: Theme.fs-xs;
            wrap: word-wrap;
        }

        // ── 五阶段进度条（可回改） ──
        StageBar {
            step: root.data.step;
            labels: root.stages;
            picked(index) => { root.action("step", index, ""); }
        }

        // ═══════ ① 剧本框架 ═══════
        if root.data.step == 0: VerticalLayout {
            spacing: 8px;

            Text {
                text: "先定框架：题材、集数、每集时长、画幅和风格。平台按这些生成分集剧本（含标题/钩子/分镜/台词）。生成本身不扣积分，渲染成片才按集计费；每阶段都能回头改，每阶段最多一次自动修复（后端就绪后由平台执行）。";
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;

                Choice {
                    title: "题材";
                    options: root.data.theme-options;
                    current: root.data.theme-pick;
                    field-width: 150px;
                    changed(index) => { root.action("theme", index, ""); }
                }

                Choice {
                    title: "集数";
                    options: root.episode-options;
                    current: root.data.episodes - 1;
                    field-width: 96px;
                    changed(index) => { root.action("episodes", index, ""); }
                }

                Choice {
                    title: "每集时长";
                    options: root.duration-options;
                    current: root.data.duration;
                    field-width: 104px;
                    changed(index) => { root.action("duration", index, ""); }
                }

                Choice {
                    title: "画幅";
                    options: root.aspect-options;
                    current: root.data.aspect;
                    field-width: 116px;
                    changed(index) => { root.action("aspect", index, ""); }
                }

                Choice {
                    title: "风格";
                    options: root.style-options;
                    current: root.data.style;
                    field-width: 116px;
                    changed(index) => { root.action("style", index, ""); }
                }
            }

            if root.data.theme-pick + 1 >= root.data.theme-options.length: HorizontalLayout {
                spacing: 8px;
                Text { text: "自定义题材"; color: Theme.fg-dim; font-size: Theme.fs-xs; vertical-alignment: center; }
                Field {
                    horizontal-stretch: 1;
                    value: root.data.theme-text;
                    placeholder: "写你的题材，例：小城创业逆袭";
                    edited(text) => { root.action("theme-text", 0, text); }
                }
            }

            // 平台限制（照契约，不臆造）
            Note {
                text: root.data.limits;
            }

            // 积分透明：生成前一行
            Text {
                text: root.data.estimate;
                color: root.data.admin-exempt ? Theme.accent : Theme.fg-muted;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }

            ConsentRow {
                on: root.data.compliance;
                text: "合规确认：" + root.data.compliance-text;
                toggled => { root.action("compliance", 0, ""); }
            }

            HorizontalLayout {
                spacing: 8px;

                Button {
                    label: root.data.busy ? "生成中…" : "平台生成剧本";
                    primary: true;
                    enabled: !root.data.busy;
                    clicked => { root.action("script-platform", 0, ""); }
                }

                Button {
                    label: "本地模板生成剧本（示例）";
                    enabled: !root.data.busy;
                    clicked => { root.action("script-local", 0, ""); }
                }

                Button {
                    label: "AI 工作室积分";
                    ghost: true;
                    clicked => { root.action("goto-studio", 0, ""); }
                }

                Button {
                    label: "网页版（备用）";
                    ghost: true;
                    clicked => { root.action("web", 0, ""); }
                }
            }

            if root.data.has-script: VerticalLayout {
                spacing: 2px;
                Text {
                    text: "《" + root.data.drama-title + "》";
                    color: Theme.fg;
                    font-size: Theme.fs-sm;
                    overflow: elide;
                }
                Note { text: root.data.drama-logline; }
                Note { text: "已有剧本：" + root.data.script-summary + "。点「② 剧本分镜」继续改。"; }
            }

            if root.data.backend-ready && root.history.length > 0: VerticalLayout {
                spacing: 3px;
                Text { text: "历史短剧（平台）"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                PaneScroll {
                    height: 72px;
                    VerticalLayout {
                        alignment: start;
                        for row in root.history: Text {
                            text: row;
                            color: Theme.fg-muted;
                            font-size: Theme.fs-sm;
                            height: 22px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // ═══════ ② 剧本分镜 ═══════
        if root.data.step == 1: VerticalLayout {
            spacing: 7px;

            if !root.data.has-script: VerticalLayout {
                spacing: 8px;
                Text {
                    text: "还没有剧本。回到「① 剧本框架」点「平台生成剧本」；后端联调中时先用「本地模板生成剧本（示例）」——同样可以逐集逐镜编辑，接口就绪后换平台稿。";
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                Button { label: "← 回到剧本框架"; clicked => { root.action("step", 0, ""); } }
            }

            if root.data.has-script: VerticalLayout {
                spacing: 7px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "剧本分镜 · " + root.data.script-summary;
                        color: Theme.fg-muted;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if root.data.script-local: Text {
                        text: "本地模板示例";
                        color: Theme.warn;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;

                    // 左：分集列表
                    VerticalLayout {
                        width: 290px;
                        spacing: 3px;
                        Text { text: "分集（可增删）"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                        PaneScroll {
                            height: 128px;
                            VerticalLayout {
                                alignment: start;
                                for row[index] in root.episodes: PickRow {
                                    text: row;
                                    current: index == root.data.episode-index;
                                    picked => { root.action("episode", index, ""); }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button { label: "＋集"; ghost: true; clicked => { root.action("episode-add", 0, ""); } }
                            Button { label: "删集"; ghost: true; clicked => { root.action("episode-remove", 0, ""); } }
                        }
                    }

                    // 右：当前集
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "第 " + root.data.episode-no + " 集 / 共 " + root.data.episode-count + " 集";
                                color: Theme.fg;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button { label: "上一集"; ghost: true; enabled: root.data.episode-index > 0; clicked => { root.action("episode-prev", 0, ""); } }
                            Button { label: "下一集"; ghost: true; enabled: root.data.episode-index + 1 < root.data.episode-count; clicked => { root.action("episode-next", 0, ""); } }
                        }

                        Text { text: "本集标题"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                        Field {
                            value: root.data.episode-title;
                            placeholder: "例：第 1 集「我不干了」";
                            edited(text) => { root.action("ep-title", 0, text); }
                        }

                        Text { text: "本集钩子（开头抓人的一句话）"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                        Field {
                            value: root.data.episode-hook;
                            placeholder: "例：老板当众羞辱她，她笑了——「这活，我不接了。」";
                            edited(text) => { root.action("ep-hook", 0, text); }
                        }
                    }
                }

                Text {
                    text: "分镜（" + root.data.scene-count + " 个 · 点一行选中；改描述/台词、增删、上移下移）";
                    color: Theme.fg-dim;
                    font-size: Theme.fs-xs;
                }
                PaneScroll {
                    height: 96px;
                    VerticalLayout {
                        alignment: start;
                        for row[index] in root.scenes: PickRow {
                            text: row;
                            current: index == root.data.scene-index;
                            picked => { root.action("scene", index, ""); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    Button { label: "＋分镜"; ghost: true; clicked => { root.action("scene-add", 0, ""); } }
                    Button { label: "删分镜"; ghost: true; clicked => { root.action("scene-remove", 0, ""); } }
                    Button { label: "上移"; ghost: true; clicked => { root.action("scene-up", 0, ""); } }
                    Button { label: "下移"; ghost: true; clicked => { root.action("scene-down", 0, ""); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        label: "下一步：成片资产 →";
                        primary: true;
                        clicked => { root.action("step", 2, ""); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: "画面描述（第 " + (root.data.scene-index + 1) + " 镜）"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                        AreaText {
                            value: root.data.scene-desc;
                            placeholder: "例：雨夜写字楼门口，女主拎着纸箱走出来，台阶下停着一辆黑色轿车。";
                            box-height: 62px;
                            edited(text) => { root.action("scene-desc", 0, text); }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: "台词 / 旁白"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                        AreaText {
                            value: root.data.scene-line;
                            placeholder: "例：这口气，我咽不下。";
                            box-height: 62px;
                            edited(text) => { root.action("scene-line", 0, text); }
                        }
                    }
                }
            }
        }

        // ═══════ ③ 成片资产 ═══════
        if root.data.step == 2: VerticalLayout {
            spacing: 8px;

            if !root.data.has-script: VerticalLayout {
                spacing: 6px;
                Text {
                    text: "还没有剧本。先回「① 剧本框架」生成或本地模板生成一部。";
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                Button { label: "← 回到剧本框架"; clicked => { root.action("step", 0, ""); } }
            }

            if root.data.has-script: VerticalLayout {
                spacing: 8px;

                Text {
                    text: "成片资产组（第 " + root.data.episode-no + " 集）：先把这一集要用的角色、场景和声音定下来，后面逐镜生成就按这份资产走。";
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 12px;

                    // 角色卡
                    VerticalLayout {
                        width: 280px;
                        spacing: 4px;
                        Text { text: "角色卡（" + root.data.char-count + " 张）"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                        PaneScroll {
                            height: 120px;
                            VerticalLayout {
                                alignment: start;
                                for row[index] in root.characters: PickRow {
                                    text: row;
                                    current: index == root.data.char-index;
                                    picked => { root.action("char", index, ""); }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button { label: "＋角色"; ghost: true; clicked => { root.action("char-add", 0, ""); } }
                            Button { label: "删角色"; ghost: true; clicked => { root.action("char-remove", 0, ""); } }
                        }
                        Field {
                            value: root.data.char-text;
                            placeholder: "角色设定：姓名 · 年龄 · 一句话人设";
                            edited(text) => { root.action("char-text", 0, text); }
                        }
                    }

                    // 场景卡 + 音频
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;

                        Text { text: "场景卡（来自分镜，去「② 剧本分镜」改画面描述）"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                        PaneScroll {
                            height: 74px;
                            VerticalLayout {
                                alignment: start;
                                for row[index] in root.scenes: PickRow {
                                    text: row;
                                    current: index == root.data.scene-index;
                                    picked => { root.action("scene", index, ""); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Choice {
                                title: "配音（音色）";
                                options: root.voice-options;
                                current: root.data.voice;
                                field-width: 176px;
                                changed(index) => { root.action("voice", index, ""); }
                            }
                            Choice {
                                title: "BGM";
                                options: root.bgm-options;
                                current: root.data.bgm;
                                field-width: 150px;
                                changed(index) => { root.action("bgm", index, ""); }
                            }
                        }

                        Note {
                            text: "角色卡 / 音色 / BGM 随剧本 JSON 导出；本版平台渲染是单音色（edge-tts）、分镜画面按描述自动生成——音色与 BGM 的选择等平台开放多音色后生效，不在本版假装可用。";
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Button { label: "← 上一步"; ghost: true; clicked => { root.action("step", 1, ""); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        label: "下一步：分镜产物 →";
                        primary: true;
                        clicked => { root.action("step", 3, ""); }
                    }
                }
            }
        }

        // ═══════ ④ 分镜产物 ═══════
        if root.data.step == 3: VerticalLayout {
            spacing: 8px;

            if !root.data.has-script: VerticalLayout {
                spacing: 6px;
                Text {
                    text: "还没有剧本。先回「① 剧本框架」生成剧本，再到「② 剧本分镜」加分镜。";
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                Button { label: "← 回到剧本框架"; clicked => { root.action("step", 0, ""); } }
            }

            if root.data.has-script: VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "第 " + root.data.episode-no + " 集 · 已配图 " + root.data.shot-ready + "/" + root.data.shot-total + " 镜";
                        color: Theme.fg-muted;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        label: root.data.matching ? "匹配中…" : "自动匹配站内素材";
                        primary: true;
                        enabled: !root.data.matching && !root.data.busy;
                        clicked => { root.action("match-assets", 0, ""); }
                    }
                    Button {
                        label: "换一个";
                        enabled: root.data.scene-has-candidates;
                        clicked => { root.action("asset-cycle", 0, ""); }
                    }
                }

                PaneScroll {
                    height: 150px;
                    VerticalLayout {
                        alignment: start;
                        for row[index] in root.scenes: PickRow {
                            text: row;
                            current: index == root.data.scene-index;
                            picked => { root.action("scene", index, ""); }
                        }
                    }
                }

                Note {
                    text: root.data.has-asset
                        ? "当前镜产物：" + root.data.scene-asset + "（站内免费商用素材）"
                        : "当前镜还没有产物：先「自动匹配站内素材」，或直接去本集拼接让平台按描述出片。";
                }
                Note {
                    text: "渲染时平台按分镜描述自动配站内素材并逐镜出片；这里的手动匹配用于创作参考与剧本 JSON 导出，不影响平台渲染（平台实测单集 95–163 秒）。";
                }

                HorizontalLayout {
                    spacing: 8px;
                    Note {
                        text: "分镜产物（每镜画面 + 台词 + 配音）由本集渲染统一生成：平台按分镜逐镜出片，成片带「AI 生成」标注。先在下面把素材配好，再进「⑤ 本集拼接」渲染。";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        label: "下一步：本集拼接 →";
                        primary: true;
                        clicked => { root.action("step", 4, ""); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Button { label: "← 上一步"; ghost: true; clicked => { root.action("step", 2, ""); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        // ═══════ ⑤ 本集拼接 ═══════
        if root.data.step == 4: VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;

                Button {
                    label: "生成当前集";
                    primary: true;
                    enabled: root.data.has-script && !root.data.busy;
                    clicked => { root.action("render-current", 0, ""); }
                }

                Button {
                    label: "生成全部集数（队列）";
                    enabled: root.data.has-script && !root.data.busy && root.data.episode-count > 1;
                    clicked => { root.action("render-all", 0, ""); }
                }

                Button {
                    label: "取消";
                    ghost: true;
                    enabled: root.data.busy;
                    clicked => { root.action("cancel", 0, ""); }
                }

                Rectangle { horizontal-stretch: 1; }

                Button {
                    label: "打开成片目录";
                    ghost: true;
                    clicked => { root.action("open-folder", 0, ""); }
                }
                Button {
                    label: "全部插入时间轴";
                    enabled: root.data.has-outputs && !root.data.busy;
                    clicked => { root.action("insert-all", 0, ""); }
                }
                Button {
                    label: "导出剧本 JSON";
                    ghost: true;
                    enabled: root.data.has-script;
                    clicked => { root.action("export-json", 0, ""); }
                }
                Button {
                    label: "打包下载整剧 ZIP";
                    ghost: true;
                    enabled: root.data.has-script && root.data.drama-id != "" && !root.data.busy;
                    clicked => { root.action("download-zip", 0, ""); }
                }
            }

            Text {
                text: root.data.estimate;
                color: root.data.admin-exempt ? Theme.accent : Theme.fg-muted;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }

            if root.data.busy: VerticalLayout {
                spacing: 4px;
                Progress { value: root.data.progress; live: true; }
                Text { text: root.data.stage; color: Theme.fg-muted; font-size: Theme.fs-sm; }
                if root.data.queue-left > 0: Note {
                    text: "整剧队列还剩 " + root.data.queue-left + " 集；逐集渲染、逐集下载。";
                }
            }

            if !root.data.has-outputs: VerticalLayout {
                spacing: 8px;
                Text {
                    text: "成片库是空的。选「生成当前集」先出一集，或「生成全部集数」整剧排队；每集渲染完自动下载，可一键铺到时间轴。";
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                ConsentRow {
                    on: root.data.compliance;
                    text: "合规确认：" + root.data.compliance-text;
                    toggled => { root.action("compliance", 0, ""); }
                }
            }

            if root.data.has-outputs: VerticalLayout {
                spacing: 4px;
                Text {
                    text: "成片库（" + root.data.output-count + " 集）";
                    color: Theme.fg-dim;
                    font-size: Theme.fs-xs;
                }
                PaneScroll {
                    height: 140px;
                    VerticalLayout {
                        alignment: start;
                        for row in root.outputs: Text {
                            text: row;
                            color: Theme.fg-muted;
                            font-size: Theme.fs-sm;
                            height: 24px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            Note {
                text: "后端联调中时「生成」会如实说明接口未就绪；剧本编辑、资产组、分镜素材、JSON 导出不受影响。";
                visible: !root.data.backend-ready;
            }

            HorizontalLayout {
                spacing: 8px;
                Button { label: "← 回到剧本框架"; ghost: true; clicked => { root.action("step", 0, ""); } }
                Button { label: "打开网页版（备用）"; ghost: true; clicked => { root.action("web", 0, ""); } }
                Rectangle { horizontal-stretch: 1; }
                Note { text: "AI 短剧：桌面为主，网页仅备用。"; vertical-alignment: center; }
            }
        }

        // ── 常驻说明 / 结果行 ──
        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        Text {
            text: root.data.message;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
            visible: root.data.message != "";
        }

        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            Button {
                label: "关闭";
                ghost: true;
                clicked => { root.action("close", 0, ""); }
            }
        }
    }
}
