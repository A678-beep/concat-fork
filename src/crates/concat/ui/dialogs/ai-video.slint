// 星籁 AI 生视频（0.2.22）——AI 面板的第四页。
//
// 文生视频 / 图生视频 / 本地模型（预留）三个 tab。生成走平台 `/aivideo`
// 接口（桌面不打包任何上游 Key）；长视频 = 多段 5 秒续写拼接，界面如实
// 标注「质量与一致性可能下降」。
//
// 所有交互都汇成一条 `action(action, index, text)` 回调交给 Rust，
// 这里不自己判断能不能生成——状态全在 Rust 的 AiVideoPane 里。

import { Theme } from "../theme/theme.slint";
import { Button, Field, Progress } from "../primitives/modal.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Select } from "../primitives/select.slint";

/// 生视频页的状态。字段由 Rust 写好；面板只读。
export struct AiVideoData {
    /// 页内 tab：0 文生视频、1 图生视频、2 本地模型。
    mode: int,
    prompt: string,
    negative: string,
    /// 比例 0 9:16 / 1 16:9 / 2 1:1。
    aspect: int,
    /// 时长档 0 5 秒 / 1 10 秒（2 段续写）。
    duration: int,
    model: int,
    model-note: string,
    models-hint: string,
    /// 本次预计消耗一句话。
    cost: string,
    image-name: string,
    has-image: bool,
    /// 长视频（续写拼接）开关。
    extend: bool,
    /// 长视频目标：0 30 秒、1 60 秒。
    target: int,
    /// 本次几段 + 拼接说明。
    segment-hint: string,
    busy: bool,
    progress: float,
    stage: string,
    message: string,
    last: string,
    has-output: bool,
    output-name: string,
    signed-in: bool,
    account-line: string,
    loading: bool,
    models-error: string,
    gpu-line: string,
    local-fit: string,
    local-fit-ok: bool,
    local-note: string,
}

/// 一行小标题 + 说明。
component Note inherits Text {
    color: Theme.fg-dim;
    font-size: Theme.fs-xs;
    wrap: word-wrap;
}

export component AiVideoPage inherits VerticalLayout {
    in property <AiVideoData> data;
    /// 模型下拉的文字行。
    in property <[string]> model-names;
    /// 本地模型说明行（预留）。
    in property <[string]> local-models;

    /// `action(action, index, text)`：文生/图生/本地模型的所有动作。
    callback action(action: string, index: int, text: string);

    spacing: 8px;

    // ── 顶部：账号 + 模型来源 ──
    HorizontalLayout {
        spacing: 8px;

        Text {
            text: root.data.account-line;
            color: root.data.signed-in ? Theme.fg-muted : Theme.warn;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if !root.data.signed-in: Button {
            label: "去登录";
            primary: true;
            clicked => { root.action("login", 0, ""); }
        }

        Button {
            label: "刷新模型";
            ghost: true;
            clicked => { root.action("refresh-models", 0, ""); }
        }
    }

    Text {
        text: "由星籁平台代调视频模型：桌面端不保存任何上游 API Key；按平台返回的预计费用扣额度，管理员免扣由平台侧处理。";
        color: Theme.fg-dim;
        font-size: Theme.fs-xs;
        wrap: word-wrap;
    }

    // ── 页内 tab ──
    SegmentedControl {
        height: 30px;
        tabs: true;
        options: ["文生视频", "图生视频", "本地模型"];
        current: root.data.mode;
        changed(index) => { root.action("mode", index, ""); }
    }

    // ── 云端生成（文生 / 图生）──
    if root.data.mode < 2: VerticalLayout {
        spacing: 6px;

        Text {
            text: root.data.mode == 0 ? "画面描述（提示词）" : "画面描述（提示词，描述这一镜怎么动）";
            color: Theme.fg;
            font-size: Theme.fs-sm;
        }

        Field {
            placeholder: "例：镜头缓慢推近一杯热咖啡，窗边晨光流动，商业广告质感";
            value: root.data.prompt;
            edited(text) => { root.action("prompt", 0, text); }
        }

        Text {
            text: "负面提示（不想出现的东西；平台当前版本会忽略该字段，仍随请求发送）";
            color: Theme.fg-dim;
            font-size: Theme.fs-xs;
        }

        Field {
            placeholder: "例：模糊、变形、文字水印、多余手指";
            value: root.data.negative;
            edited(text) => { root.action("negative", 0, text); }
        }

        if root.data.mode == 1: VerticalLayout {
            spacing: 4px;

            HorizontalLayout {
                spacing: 8px;

                Button {
                    label: "选择首帧图片";
                    primary: !root.data.has-image;
                    clicked => { root.action("pick-image", 0, ""); }
                }

                Text {
                    text: root.data.has-image ? root.data.image-name : "还没有选首帧图片（JPG/PNG/WebP，≤10MB）";
                    color: root.data.has-image ? Theme.fg : Theme.fg-dim;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if root.data.has-image: Button {
                    label: "清除";
                    ghost: true;
                    clicked => { root.action("clear-image", 0, ""); }
                }
            }

            Note {
                text: "从时间轴取当前帧：在监视器里停在想要的画面，点「导出帧」再选这里的图片即可（本版直接选本地图片）。";
            }
        }

        HorizontalLayout {
            spacing: 8px;

            VerticalLayout {
                spacing: 2px;
                Text { text: "比例"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                Select {
                    width: 92px;
                    options: ["9:16", "16:9", "1:1"];
                    current: root.data.aspect;
                    changed(index) => { root.action("aspect", index, ""); }
                }
            }

            if !root.data.extend: VerticalLayout {
                spacing: 2px;
                Text { text: "时长"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                Select {
                    width: 132px;
                    options: ["5 秒", "10 秒（2 段续写）"];
                    current: root.data.duration;
                    changed(index) => { root.action("duration", index, ""); }
                }
            }

            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: "模型"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                Select {
                    horizontal-stretch: 1;
                    options: root.model-names;
                    current: root.data.model;
                    changed(index) => { root.action("model", index, ""); }
                }
            }
        }

        // 长视频：续写拼接
        HorizontalLayout {
            spacing: 8px;

            Button {
                label: root.data.extend ? "续写拼接：开" : "续写拼接：关";
                primary: root.data.extend;
                ghost: !root.data.extend;
                clicked => { root.action("extend", 0, ""); }
            }

            if root.data.extend: Select {
                width: 110px;
                options: ["30 秒", "60 秒"];
                current: root.data.target;
                changed(index) => { root.action("target", index, ""); }
            }

            Text {
                text: root.data.extend ? "长视频 = 多段 5 秒续写拼接（不是单次生成）" : "长视频？打开「续写拼接」，可拼成 30/60 秒";
                color: Theme.fg-dim;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        Note { text: root.data.segment-hint; }

        Text {
            text: root.data.cost;
            color: root.data.cost == "" ? Theme.fg-dim : Theme.warn;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }

        Note { text: root.data.model-note; }

        if root.data.models-error != "": Text {
            text: "模型列表错误：" + root.data.models-error;
            color: Theme.danger;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;

            Button {
                label: root.data.busy ? "生成中…" : "生成视频";
                primary: true;
                large: true;
                enabled: !root.data.busy;
                clicked => { root.action("generate", 0, ""); }
            }

            if root.data.busy: Button {
                label: "取消";
                danger: true;
                clicked => { root.action("cancel", 0, ""); }
            }

            if root.data.has-output && !root.data.busy: Button {
                label: "插入到播放头";
                clicked => { root.action("insert", 0, ""); }
            }

            Button {
                label: "打开成片目录";
                ghost: true;
                clicked => { root.action("open-folder", 0, ""); }
            }
        }

        if root.data.busy: VerticalLayout {
            spacing: 4px;
            Progress { value: root.data.progress; live: true; }
            Text { text: root.data.stage; color: Theme.fg-muted; font-size: Theme.fs-sm; }
        }

        if root.data.message != "": Text {
            text: root.data.message;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }

        if root.data.has-output: Text {
            text: "最近成片：" + root.data.output-name;
            color: Theme.fg-dim;
            font-size: Theme.fs-xs;
            wrap: word-wrap;
        }
    }

    // ── 本地模型（预留）──
    if root.data.mode == 2: VerticalLayout {
        spacing: 6px;

        Text {
            text: "本机显卡检测";
            color: Theme.fg;
            font-size: Theme.fs-sm;
        }

        Text {
            text: root.data.gpu-line;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }

        Text {
            text: root.data.local-fit;
            color: root.data.local-fit-ok ? Theme.accent : Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }

        for row[index] in root.local-models: HorizontalLayout {
            spacing: 8px;

            Text {
                text: row;
                color: Theme.fg-muted;
                font-size: Theme.fs-xs;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            Button {
                label: "下载";
                enabled: false;
                clicked => { root.action("local-download", index, ""); }
            }

            Button {
                label: "即将开放";
                ghost: true;
                clicked => { root.action("local-download", index, ""); }
            }
        }

        Note { text: root.data.local-note; }

        HorizontalLayout {
            spacing: 8px;

            Button {
                label: "检查本地推理接口（预留）";
                ghost: true;
                clicked => { root.action("local-generate", 0, ""); }
            }

            Text {
                text: "本版本不提供本地模型下载与推理；接口已预留，模型包发布后接入。";
                color: Theme.fg-dim;
                font-size: Theme.fs-xs;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
        }

        if root.data.message != "": Text {
            text: root.data.message;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
    }

    // 平台列表的说明（底部常驻）。
    Text {
        text: root.data.models-hint;
        color: Theme.fg-dim;
        font-size: Theme.fs-xs;
        wrap: word-wrap;
    }
}
