// 星籁 AI 面板：算力选择、本地配音（Piper 插件）、照片数字人、插件管理，
// 以及默认关闭的云端兜底。文案是中文，和云同步面板一样只服务星籁剪辑。
//
// 三样事实决定这张表：本机硬件够不够（顶部一行检测结果与理由）、现在选的
// 运行方式（智能/仅本地/仅云端，分段控件 + 一句常驻说明）、以及要生成什么
// （配音页 / 数字人页 / 插件页）。

import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button, DialogSection, Field, Modal, Progress } from "../primitives/modal.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Select } from "../primitives/select.slint";
import { ResizeBox } from "../primitives/resize-box.slint";
import { Rail } from "../inspector/controls.slint";

/// 音色下拉的一行。
export struct AiVoiceItem {
    id: string,
    name: string,
    detail: string,
    ready: bool,
    cloned: bool,
}

/// 模型中心的一行。
export struct AiPluginItem {
    id: string,
    name: string,
    /// 分类：本地配音 / 语音克隆 / 数字人 / 抠像 / 背景生成。
    category: string,
    /// 一句话说明。
    summary: string,
    /// 效果星级，`★★★★☆`。
    effect: string,
    /// 安装包大小。
    size: string,
    /// 硬件要求：显存/内存。
    requirement: string,
    /// 本机预计耗时。
    speed: string,
    /// 本机适配结论。
    fit: string,
    /// 本机跑得动。
    fit-ok: bool,
    /// 已安装 / 可下载 / 即将上线 / 云端 · 需登录。
    status: string,
    /// 限制或补充说明。
    note: string,
    /// 装在哪。
    path: string,
    installed: bool,
    downloadable: bool,
    complete: bool,
    voices: int,
    version: string,
    /// 云端能力（没有本地包）。
    cloud: bool,
}

/// AI 面板的状态。所有字段由 Rust 写好；面板只读。
export struct AiData {
    open: bool,
    /// 0 配音、1 数字人、2 模型中心。
    tab: int,
    /// 运行方式设置：0 智能、1 仅本地、2 仅云端。
    mode: int,
    /// 实际会走哪边：0 本地、1 云端。
    effective: int,
    /// "本地" 或 "云端"。
    effective-label: string,
    /// 顶部常驻小字：现在用什么、为什么。
    reason: string,
    /// 检测到的硬件，一句话。
    hardware: string,
    /// 档位名："本地可用（较慢）"。
    tier: string,
    /// 耗时预估。
    estimate: string,
    /// 本地 Piper 装好了。
    local-ready: bool,
    /// 本地插件的安装位置。
    local-path: string,
    /// 星籁账号登录着。
    signed-in: bool,
    /// 登录着的账号名。
    account: string,
    /// 登录着的套餐名。
    account-plan: string,
    /// 账号状态一行：`验收商家A改 · 基础版（云端可用）` / `未登录（云端需登录）`。
    account-line: string,
    /// 云端计费说明。
    cloud-cost: string,
    /// 配音文字。
    text: string,
    /// 选中的音色下标。
    voice: int,
    /// 语速 0.8–1.3。
    rate: float,
    /// 正在生成/下载。
    busy: bool,
    /// 进度 0..1。
    progress: float,
    /// 正在做什么。
    stage: string,
    /// 常驻说明/最近一次结果。
    message: string,
    /// 最近一次生成的结果句。
    last: string,
    /// 有可以试听的音频。
    has-audio: bool,
    /// 那条音频的名字。
    audio-name: string,
    /// 照片文件名。
    photo-name: string,
    /// 照片大小。
    photo-size: string,
    has-photo: bool,
    /// Wav2Lip 插件装好且能跑。
    digital-ready: bool,
    /// 两个本地数字人引擎各自装好没有。
    wav2lip-ready: bool,
    sadtalker-ready: bool,
    /// 选中的本地数字人引擎：0 Wav2Lip、1 SadTalker。
    digital-engine: int,
    /// 数字人这件事现在的状态说明。
    digital-status: string,
    /// 本机数字人预计耗时（按选中的引擎，实测口径）。
    avatar-estimate: string,
    /// 数字人的效果预期与限制，如实说明。
    avatar-limit: string,
    /// 首次算力向导开着。
    wizard-open: bool,
    /// 云端确认条开着。
    confirm-open: bool,
    /// 确认条上的字。
    confirm-text: string,
    /// "智能"/"仅本地"/"仅云端"。
    mode-label: string,
}

// 一个小的标签：档位、来源、"本地生成、未上传" 之类。
component Tag inherits Rectangle {
    in property <string> text;
    in property <bool> accent;

    height: 20px;
    width: tag-text.preferred-width + 14px;
    border-radius: Theme.r-xs;
    background: root.accent ? Theme.accent-soft : Theme.field;

    tag-text := Text {
        x: 7px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        color: root.accent ? Theme.fg : Theme.fg-muted;
        font-size: Theme.fs-sm;
        vertical-alignment: center;
    }
}

// 顶部一行：运行方式、登录状态、重新检测。
component ModeBar inherits HorizontalLayout {
    in property <AiData> data;

    callback mode-changed(int);
    callback redetect();

    spacing: 10px;

    Text {
        text: "AI 运行方式";
        color: Theme.fg;
        font-size: Theme.fs;
        vertical-alignment: center;
    }

    SegmentedControl {
        width: 280px;
        options: ["智能", "仅本地", "仅云端"];
        current: root.data.mode;
        changed(index) => { root.mode-changed(index); }
    }

    Tag {
        text: root.data.effective-label;
        accent: true;
    }

    Rectangle { horizontal-stretch: 1; }

    if root.data.signed-in: Text {
        text: "已登录：" + root.data.account;
        color: Theme.fg-muted;
        font-size: Theme.fs-sm;
        vertical-alignment: center;
    }

    if !root.data.signed-in: Text {
        text: "未登录（云端需要登录）";
        color: Theme.fg-dim;
        font-size: Theme.fs-sm;
        vertical-alignment: center;
    }

    Button {
        label: "重新检测";
        ghost: true;
        clicked => { root.redetect(); }
    }
}

// 配音页。
component VoicePage inherits VerticalLayout {
    in property <AiData> data;
    in property <[AiVoiceItem]> voices;
    in property <[string]> voice-names;

    callback text-edited(string);
    callback voice-changed(int);
    callback rate-changed(float);
    callback generate();
    callback preview();
    callback cancel();

    // 输入框与滑块的本地副本：TextInput / Rail 的绑定在用户第一次改它时
    // 会被丢掉，所以这里像朗读面板一样，打开时从数据里播种，之后不再覆盖
    // 正在编辑的那一份。
    property <string> draft;
    property <float> rate-v;
    property <bool> typing;
    changed data => {
        if (!root.typing) {
            root.draft = root.data.text;
        }
        root.rate-v = root.data.rate;
    }
    init => {
        root.draft = root.data.text;
        root.rate-v = root.data.rate;
    }

    spacing: 8px;

    // 文字。
    DialogSection {
        first: true;
        ruled: false;
        title: "配音文字";

        box := ResizeBox {
            content-height: words.preferred-height;
            focused: words.has-focus;

            words := TextInput {
                x: box.pad-x;
                y: box.pad-y;
                width: parent.width - self.x - 2 * box.pad-x;
                height: Math.max(self.preferred-height, box.view-height);
                cursor-position-changed(at) => { box.reveal(at.y, self.font-size * 1.4); }
                text <=> root.draft;
                edited => { root.text-edited(self.text); }
                color: Theme.fg;
                font-size: Theme.fs-lg;
                single-line: false;
                wrap: char-wrap;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.on-accent;
                changed has-focus => { root.typing = self.has-focus; }
            }

            if root.draft == "" && !words.has-focus: Text {
                x: 0;
                y: box.pad-y;
                text: "输入要配音的文字，例如：大家好，欢迎来到星籁剪辑……";
                color: Theme.fg-dim;
                font-size: Theme.fs-lg;
            }
        }

        HorizontalLayout {
            spacing: 6px;

            Text {
                text: "上限 2000 字";
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: "本地配音不需要登录，完全离线";
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }
        }
    }

    // 音色与语速。
    DialogSection {
        ruled: false;
        title: "音色与语速";

        HorizontalLayout {
            spacing: 10px;

            Text {
                text: "音色";
                width: 44px;
                color: Theme.fg-muted;
                font-size: Theme.fs;
                vertical-alignment: center;
            }

            Select {
                horizontal-stretch: 1;
                options: root.voice-names;
                current: root.data.voice;
                placeholder: root.data.local-ready || root.data.effective == 1
                    ? "选择音色" : "先装本地配音插件";
                changed(index) => { root.voice-changed(index); }
            }
        }

        if root.voices.length > 0: Text {
            text: root.data.voice >= 0 && root.data.voice < root.voices.length
                ? root.voices[root.data.voice].detail : "";
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 10px;

            Text {
                text: "语速";
                width: 44px;
                color: Theme.fg-muted;
                font-size: Theme.fs;
                vertical-alignment: center;
            }

            Rail {
                horizontal-stretch: 1;
                value <=> root.rate-v;
                minimum: 0.8;
                maximum: 1.3;
                step: 0.02;
                default-value: 1.0;
                changed(v) => { root.rate-changed(v); }
            }

            Text {
                width: 46px;
                text: root.rate-v + "×";
                color: Theme.fg;
                font-family: Theme.font-technical;
                font-size: Theme.fs;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }

    // 动作与结果。
    HorizontalLayout {
        spacing: 8px;

        Button {
            label: root.data.effective == 1 ? "云端生成配音" : "生成配音并插入";
            primary: true;
            enabled: !root.data.busy && !root.data.confirm-open
                && (root.data.effective == 1 ? root.data.signed-in : root.data.local-ready);
            clicked => { root.generate(); }
        }

        Button {
            label: "试听";
            enabled: root.data.has-audio && !root.data.busy;
            clicked => { root.preview(); }
        }

        if root.data.busy: Button {
            label: "取消";
            ghost: true;
            clicked => { root.cancel(); }
        }

        Rectangle { horizontal-stretch: 1; }

        if root.data.effective == 1 && !root.data.signed-in: Button {
            label: "去登录";
            ghost: true;
            clicked => { root.generate(); }
        }
    }

    if root.data.last != "": Text {
        text: root.data.last;
        color: Theme.fg-muted;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }
}

// 照片数字人页：照片 + 配音（或文案先用本地音色配音）→ 对口型说话视频。
// 本地走 Wav2Lip 插件（完全离线），云端是兜底（会上传、按次扣费）。
// 版面按 AI 面板 660px 的高度排：两段（照片与配音、生成），不往下滚。
component DigitalPage inherits VerticalLayout {
    in property <AiData> data;
    in property <image> photo;

    callback photo-pick();
    callback photo-clear();
    callback text-edited(string);
    callback generate();
    callback cancel();
    callback engine-changed(int);

    // 文案输入框的本地副本：用户第一次改它时绑定会被丢掉，所以打开时从
    // 数据里播种，之后不覆盖正在编辑的那一份。
    property <string> draft;
    property <bool> typing;
    changed data => {
        if (!root.typing) {
            root.draft = root.data.text;
        }
    }
    init => {
        root.draft = root.data.text;
    }

    spacing: 6px;

    // 照片与文案：一块地方放完。
    DialogSection {
        first: true;
        ruled: false;
        title: "照片与配音";

        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                spacing: 6px;

                Rectangle {
                    width: 96px;
                    height: 120px;
                    border-radius: Theme.r;
                    background: Theme.well;
                    clip: true;

                    if root.data.has-photo: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.photo;
                        image-fit: cover;
                    }

                    if !root.data.has-photo: Text {
                        width: parent.width;
                        height: parent.height;
                        text: "还没有照片";
                        color: Theme.fg-dim;
                        font-size: Theme.fs-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;

                    Button {
                        label: root.data.has-photo ? "换一张" : "选照片";
                        enabled: !root.data.busy;
                        clicked => { root.photo-pick(); }
                    }

                    if root.data.has-photo: Button {
                        label: "清掉";
                        ghost: true;
                        enabled: !root.data.busy;
                        clicked => { root.photo-clear(); }
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;

                Text {
                    text: root.data.has-photo
                        ? root.data.photo-name + "（" + root.data.photo-size + "）"
                        : "选一张正脸 JPG/PNG 照片（≤10MB）";
                    color: Theme.fg;
                    font-size: Theme.fs;
                    overflow: elide;
                }

                Text {
                    text: "正脸、五官清楚、光线均匀最好；侧脸、遮挡、多人合照会明显变差。";
                    color: Theme.fg-dim;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }

                box := ResizeBox {
                    box-height: 72px;
                    content-height: words.preferred-height;
                    focused: words.has-focus;

                    words := TextInput {
                        x: box.pad-x;
                        y: box.pad-y;
                        width: parent.width - self.x - 2 * box.pad-x;
                        height: Math.max(self.preferred-height, box.view-height);
                        cursor-position-changed(at) => { box.reveal(at.y, self.font-size * 1.4); }
                        text <=> root.draft;
                        edited => { root.text-edited(self.text); }
                        color: Theme.fg;
                        font-size: Theme.fs;
                        single-line: false;
                        wrap: char-wrap;
                        selection-background-color: Theme.accent;
                        selection-foreground-color: Theme.on-accent;
                        changed has-focus => { root.typing = self.has-focus; }
                    }

                    if root.draft == "" && !words.has-focus: Text {
                        x: 0;
                        y: box.pad-y;
                        text: "输入要念的文案；留空就用最近一次生成的配音";
                        color: Theme.fg-dim;
                        font-size: Theme.fs;
                    }
                }
            }
        }
    }

    // 生成方式与动作。
    DialogSection {
        ruled: false;
        title: "生成";
        hint: root.data.digital-status;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Tag {
                text: root.data.effective == 1 ? "云端生成（会上传）" : "本地生成、未上传";
                accent: root.data.effective == 0;
            }

            Tag {
                text: root.data.digital-engine == 1
                    ? (root.data.sadtalker-ready ? "SadTalker 已装" : "SadTalker 未装")
                    : (root.data.wav2lip-ready ? "Wav2Lip 已装" : "Wav2Lip 未装");
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: root.data.effective == 1
                    ? "约 1–2 分钟/条"
                    : root.data.avatar-estimate;
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.data.digital-status;
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            overflow: elide;
        }

        Text {
            text: root.data.avatar-limit;
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;

            Select {
                width: 196px;
                enabled: !root.data.busy && root.data.effective == 0;
                options: ["Wav2Lip（快）", "SadTalker（头动+眨眼，慢）"];
                current: root.data.digital-engine;
                changed(index) => { root.engine-changed(index); }
            }

            Button {
                label: root.data.effective == 1
                    ? "云端生成数字人片段" : "本地生成数字人并插入";
                primary: true;
                enabled: !root.data.busy && !root.data.confirm-open && root.data.has-photo
                    && (root.data.effective == 1
                        ? root.data.signed-in && root.data.has-audio
                        : (root.data.digital-engine == 1
                            ? root.data.sadtalker-ready : root.data.wav2lip-ready)
                            && (root.data.text != "" || root.data.has-audio));
                clicked => { root.generate(); }
            }

            if root.data.busy: Button {
                label: "取消";
                ghost: true;
                clicked => { root.cancel(); }
            }

            Rectangle { horizontal-stretch: 1; }
        }
    }
}

// 模型中心：能装在本机的 AI 模型一张清单，谁想用就下哪个；没上线的灰着写
// 「即将上线」，点了也不发请求。云端能力（AI 背景生成）单列一行，需登录。
component ModelPage inherits VerticalLayout {
    in property <AiData> data;
    in property <[AiPluginItem]> models;

    callback import-zip();
    callback download(string);
    callback open(string);
    callback remove(string);
    callback refresh();

    spacing: 8px;

    DialogSection {
        first: true;
        ruled: false;
        title: "本地模型中心";
        hint: "本地模型文件大也不要紧：谁想用就下哪个，不想用就走云端（默认关闭、需登录、按次确认）。";

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: "共 " + root.models.length + " 项 · 效果按同类别比较";
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: "「即将上线」的条目点了不会发请求";
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }
        }

        for model[index] in root.models: Rectangle {
            height: 116px;
            border-radius: Theme.r;
            background: Math.mod(index, 2) == 0 ? Theme.field : Theme.well;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 10px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 3px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: model.name;
                            color: Theme.fg;
                            font-size: Theme.fs;
                            font-weight: 600;
                        }

                        Text {
                            text: model.category;
                            color: Theme.accent;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }

                        Text {
                            text: model.effect;
                            color: #fbbf24;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Text {
                            text: model.status;
                            color: model.installed ? Theme.fg-muted
                                : model.downloadable ? Theme.accent : Theme.fg-dim;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: model.summary;
                        color: Theme.fg-muted;
                        font-size: Theme.fs-sm;
                        overflow: elide;
                    }

                    Text {
                        text: "大小 " + model.size + " · " + model.requirement;
                        color: Theme.fg-dim;
                        font-size: Theme.fs-sm;
                        overflow: elide;
                    }

                    Text {
                        text: "预计耗时 " + model.speed;
                        color: Theme.fg-dim;
                        font-size: Theme.fs-sm;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: model.fit;
                            color: model.fit-ok ? Theme.fg-muted : #f87171;
                            font-size: Theme.fs-sm;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: model.note;
                            color: Theme.fg-dim;
                            font-size: Theme.fs-sm;
                            overflow: elide;
                        }
                    }
                }

                VerticalLayout {
                    width: 130px;
                    alignment: center;
                    spacing: 6px;

                    if model.installed: Button {
                        label: "打开目录";
                        ghost: true;
                        clicked => { root.open(model.id); }
                    }

                    if model.installed: Button {
                        label: "删除";
                        danger: true;
                        ghost: true;
                        clicked => { root.remove(model.id); }
                    }

                    if !model.installed && model.cloud: Button {
                        label: "云端 · 需登录";
                        enabled: false;
                    }

                    if !model.installed && !model.cloud && model.downloadable: Button {
                        label: "下载并安装";
                        primary: true;
                        enabled: !root.data.busy;
                        clicked => { root.download(model.id); }
                    }

                    if !model.installed && !model.cloud && !model.downloadable: Button {
                        label: "即将上线";
                        enabled: false;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;

            Button {
                label: "导入插件包…";
                primary: true;
                enabled: !root.data.busy;
                clicked => { root.import-zip(); }
            }

            Button {
                label: "刷新";
                ghost: true;
                enabled: !root.data.busy;
                clicked => { root.refresh(); }
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: "安装位置：" + (root.data.local-path != ""
                    ? root.data.local-path
                    : "%APPDATA%\\app.concat.editor\\ai-plugins\\<插件名>\\");
                color: Theme.fg-dim;
                font-family: Theme.font-technical;
                font-size: Theme.fs-sm;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
}

// 算力向导：第一次用 AI 时弹一次，讲清楚检测结果与两条路。
export component AiWizard inherits Modal {
    in property <AiData> data;

    callback pick-local();
    callback pick-cloud();
    callback dismiss();

    open: root.data.wizard-open;
    title: "算力向导 · 这台机器怎么跑 AI";
    glyph: Glyph.none;
    surface-width: 560px;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        Text {
            text: "检测结果";
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
        }

        Text {
            text: root.data.hardware;
            color: Theme.fg;
            font-size: Theme.fs;
            wrap: word-wrap;
        }

        Text {
            text: "显存为驱动自报口径：独显是专用显存，核显是共享内存。";
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            Tag { text: root.data.tier; accent: true; }
            Tag { text: root.data.effective == 1 ? "建议：云端" : "建议：本地"; }
        }

        Text {
            text: root.data.reason;
            color: Theme.fg-muted;
            font-size: Theme.fs;
            wrap: word-wrap;
        }

        Text {
            text: root.data.estimate;
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        Text {
            text: "选一条路，之后随时能在面板顶部或设置里改：";
            color: Theme.fg;
            font-size: Theme.fs;
        }

        HorizontalLayout {
            spacing: 8px;

            Button {
                label: "用本地（装/导入插件）";
                primary: true;
                clicked => { root.pick-local(); }
            }

            Button {
                label: "用云端（登录）";
                clicked => { root.pick-cloud(); }
            }

            Button {
                label: "稍后决定";
                ghost: true;
                clicked => { root.dismiss(); }
            }
        }

        Text {
            text: "本地：完全离线、不上传、不需登录；云端：需登录星籁账号并按套餐额度计费，每次生成前都会确认。";
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
    }
}

// AI 面板本体。
export component AiDialog inherits Modal {
    in property <AiData> data;
    in property <[AiVoiceItem]> voices;
    in property <[string]> voice-names;
    in property <[AiPluginItem]> plugins;
    in property <image> photo;

    callback tab-changed(int);
    callback text-edited(string);
    callback voice-changed(int);
    callback rate-changed(float);
    callback generate();
    callback preview();
    callback cancel();
    callback mode-changed(int);
    callback redetect();
    callback plugin-import();
    callback plugin-download(string);
    callback plugin-open(string);
    callback plugin-remove(string);
    callback plugin-refresh();
    callback photo-pick();
    callback photo-clear();
    callback confirm-yes();
    callback confirm-no();
    /// 换本地数字人引擎：0 Wav2Lip、1 SadTalker。
    callback engine-changed(int);
    /// 打开星籁账号登录（未登录时的「去登录」）。
    callback login();

    open: root.data.open;
    title: "星籁 AI · 本地优先";
    glyph: Glyph.none;
    surface-width: 780px;
    surface-height: 660px;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        ModeBar {
            data: root.data;
            mode-changed(index) => { root.mode-changed(index); }
            redetect => { root.redetect(); }
        }

        Text {
            text: root.data.reason;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;

            Tag { text: root.data.tier; accent: true; }
            Tag { text: root.data.effective == 1 ? "云端 · 需确认上传" : "本地 · 不上传"; }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.data.hardware;
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        Text {
            text: "显存为驱动自报口径：独显是专用显存，核显是共享内存。";
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            overflow: elide;
        }

        Text {
            text: root.data.estimate;
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            overflow: elide;
        }

        SegmentedControl {
            height: 30px;
            tabs: true;
            options: ["配音", "数字人", "模型"];
            current: root.data.tab;
            changed(index) => { root.tab-changed(index); }
        }

        if root.data.tab == 0: VoicePage {
            data: root.data;
            voices: root.voices;
            voice-names: root.voice-names;
            text-edited(text) => { root.text-edited(text); }
            voice-changed(index) => { root.voice-changed(index); }
            rate-changed(value) => { root.rate-changed(value); }
            generate => { root.generate(); }
            preview => { root.preview(); }
            cancel => { root.cancel(); }
        }

        if root.data.tab == 1: DigitalPage {
            data: root.data;
            photo: root.photo;
            photo-pick => { root.photo-pick(); }
            photo-clear => { root.photo-clear(); }
            text-edited(text) => { root.text-edited(text); }
            engine-changed(index) => { root.engine-changed(index); }
            generate => { root.generate(); }
            cancel => { root.cancel(); }
        }

        if root.data.tab == 2: ModelPage {
            data: root.data;
            models: root.plugins;
            import-zip => { root.plugin-import(); }
            download(id) => { root.plugin-download(id); }
            open(id) => { root.plugin-open(id); }
            remove(id) => { root.plugin-remove(id); }
            refresh => { root.plugin-refresh(); }
        }

        // 进度。
        if root.data.busy: VerticalLayout {
            spacing: 4px;
            Progress {
                value: root.data.progress;
                live: true;
            }
            Text {
                text: root.data.stage;
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
            }
        }

        // 云端确认条：默认不上传任何素材。
        if root.data.confirm-open: Rectangle {
            border-radius: Theme.r;
            background: Theme.accent-soft;
            border-width: 1px;
            border-color: Theme.accent;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Text {
                    text: root.data.confirm-text;
                    color: Theme.fg;
                    font-size: Theme.fs;
                    wrap: word-wrap;
                }

                Text {
                    text: root.data.cloud-cost;
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        label: "确认上传并生成";
                        primary: true;
                        clicked => { root.confirm-yes(); }
                    }
                    Button {
                        label: "取消，不上传";
                        ghost: true;
                        clicked => { root.confirm-no(); }
                    }
                }
            }
        }

        Text {
            text: root.data.message;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }

        // 账号状态：已登录显示名字与套餐（云端可用），未登录给「去登录」。
        // 和首屏右上角的账号 chip 是同一份状态，登录成功后这里自动变。
        Rectangle {
            height: 36px;
            border-radius: Theme.r-sm;
            background: Theme.field;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Icon {
                        glyph: Glyph.circle-play;
                        size: 14px;
                        tint: root.data.signed-in ? Theme.accent : Theme.fg-dim;
                    }
                }

                Text {
                    text: root.data.account-line;
                    color: root.data.signed-in ? Theme.fg : Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                if !root.data.signed-in: Button {
                    label: "去登录";
                    primary: true;
                    clicked => { root.login(); }
                }

                if root.data.signed-in: Button {
                    label: "刷新账号";
                    ghost: true;
                    clicked => { root.login(); }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: "本地生成的内容不上传云端；云端生成会明确提示并逐次确认。";
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Button {
                label: "关闭";
                clicked => { root.closed(); }
            }
        }
    }
}
