// 星籁剪辑 0.5.0 影视专业三期：提示词引擎 / 导演风格库 / 项目资产文件库 /
// AI 审美总监 / 视频反推 / 自愈剪辑 / 补机位 / 节点画布与导演脑。
//
// 与 0.4.0 的二期面板同一种接法：Rust 写 Pro3Data 与几张表，面板上每个
// 手势汇总成一条 action(action, index, text)；网络请求全在 Rust，启动路径
// 上不取数（懒加载）。每页顶部写明这次真实调用的接口，失败给中文原因。
// 经济模式：只走读接口与免费分析接口，不调用付费视频模型。

import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button, Field, Modal, Progress } from "../primitives/modal.slint";
import { PaneScroll } from "../workspace/pane.slint";

// ── 行数据 ───────────────────────────────────────────────────────────

export struct Pro3Row {
    label: string,
    detail: string,
    value: string,
    level: string,
}

export struct Pro3Data {
    open: bool,
    tab: int,
    busy: bool,
    signed-in: bool,
    status-line: string,
    status-level: string,
    hint: string,

    // ① 提示词引擎
    pp-template-label: string,
    pp-model-label: string,
    pp-name: string,
    pp-look: string,
    pp-wardrobe: string,
    pp-location: string,
    pp-time: string,
    pp-weather: string,
    pp-mood: string,
    pp-duration: string,
    pp-aspect: int,
    pp-aspect-label: string,
    pp-language: int,
    pp-language-label: string,
    pp-notes: string,
    pp-line: string,
    pp-quality: string,
    pp-cost: string,
    pp-zh: string,
    pp-en: string,
    pp-model-prompt: string,

    // ② 风格库
    sl-count: string,
    sl-line: string,
    sl-detail: string,
    sl-style-id: string,
    sl-guide: int,
    sl-ratio: int,
    sl-preview-line: string,

    // ③ 项目资产文件库
    ix-project-label: string,
    ix-type-label: string,
    ix-query: string,
    ix-line: string,
    ix-detail: string,

    // ④ AI 审美总监
    ae-source: string,
    ae-sample: int,
    ae-line: string,
    ae-score: string,
    ae-grade: string,
    ae-summary: string,
    ae-report: string,

    // ⑤ 视频反推
    rv-source: string,
    rv-sample: int,
    rv-line: string,
    rv-status: string,
    rv-report: string,
    rv-prompt-zh: string,
    rv-prompt-en: string,

    // ⑥ 自愈剪辑
    hl-source: string,
    hl-line: string,
    hl-run: string,
    hl-report: string,
    hl-counts: string,
    hl-reshoot-line: string,

    // ⑦ 补机位
    mc-source: string,
    mc-mode: int,
    mc-mode-label: string,
    mc-zoom: string,
    mc-line: string,
    mc-output: string,
    mc-ai-line: string,
    mc-poster-line: string,

    // ⑧ 节点画布 / 导演脑
    nc-line: string,
    nc-brain-line: string,
    nc-canvas-web: string,
    nc-brain-web: string,

    // 共用预览
    pv-line: string,
}

component Hint inherits Text {
    color: Theme.fg-muted;
    font-size: Theme.fs-sm;
    wrap: word-wrap;
}

component Note inherits Text {
    color: Theme.fg-dim;
    font-size: Theme.fs-xs;
    wrap: word-wrap;
}

component KV inherits HorizontalLayout {
    in property <string> k;
    in property <string> v;
    in property <color> ink: Theme.fg;

    spacing: 6px;
    height: 22px;
    horizontal-stretch: 1;

    Text {
        text: root.k;
        color: Theme.fg-dim;
        font-size: Theme.fs-sm;
        vertical-alignment: center;
        min-width: 84px;
    }
    Text {
        horizontal-stretch: 1;
        text: root.v;
        color: root.ink;
        font-size: Theme.fs-sm;
        vertical-alignment: center;
        overflow: elide;
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> current: false;
    callback picked();

    height: 26px;
    border-radius: 13px;
    background: root.current ? Theme.accent-soft : (touch.has-hover ? Theme.field-hover : Theme.field);
    border-width: 1px;
    border-color: root.current ? Theme.accent : Theme.line;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            color: root.current ? Theme.accent : Theme.fg-muted;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

component Card inherits Rectangle {
    in property <string> title;

    background: Theme.panel;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: Theme.line;

    VerticalLayout {
        padding: 11px;
        spacing: 7px;
        if root.title != "": Text {
            text: root.title;
            color: Theme.fg;
            font-size: Theme.fs-lg;
            font-weight: Theme.weight-title;
        }
        @children
    }
}

component RowLine inherits Rectangle {
    in property <Pro3Row> entry;
    in property <bool> clickable: false;
    in property <string> action-label: "";
    callback picked();
    callback acted();

    height: 32px;
    border-radius: Theme.r-sm;
    background: touch.has-hover ? Theme.field-hover : Theme.field;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 6px;
        spacing: 8px;

        Text {
            width: 12px;
            text: root.entry.level == "fail" ? "!" : (root.entry.level == "warn" ? "!" : (root.entry.level == "ok" ? "✓" : "·"));
            color: root.entry.level == "fail" ? Theme.danger
                : (root.entry.level == "warn" ? Theme.accent
                : (root.entry.level == "ok" ? Theme.accent : Theme.fg-dim));
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }
        Text {
            text: root.entry.label;
            color: Theme.fg;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            overflow: elide;
            min-width: 90px;
            max-width: 300px;
        }
        Text {
            horizontal-stretch: 1;
            text: root.entry.detail;
            color: Theme.fg-muted;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.entry.value != "": Text {
            text: root.entry.value;
            color: Theme.accent;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
            overflow: elide;
            max-width: 200px;
        }
        if root.action-label != "": Button {
            label: root.action-label;
            ghost: true;
            clicked => { root.acted(); }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.clickable) { root.picked(); } }
    }
}

component AreaText inherits Rectangle {
    in property <string> value;
    in property <string> placeholder;
    in property <length> box-height: 96px;
    callback edited(text: string);

    property <string> draft;
    init => { root.draft = root.value; }
    changed value => { if (!input.has-focus) { root.draft = root.value; } }

    min-height: root.box-height;
    max-height: root.box-height;
    background: Theme.field;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : transparent;
    clip: true;

    input := TextInput {
        x: 9px;
        y: 7px;
        width: parent.width - 18px;
        height: parent.height - 14px;
        text <=> root.draft;
        edited => { root.edited(self.text); }
        color: Theme.fg;
        font-size: Theme.fs-sm;
        single-line: false;
        wrap: word-wrap;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-accent;
    }
    if root.draft == "" && !input.has-focus: Text {
        x: 9px;
        y: 7px;
        width: parent.width - 18px;
        text: root.placeholder;
        color: Theme.fg-dim;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }
}

component StatusBar inherits Rectangle {
    in property <string> line;
    in property <string> level: "info";

    height: root.line == "" ? 0px : 30px;
    visible: root.line != "";
    border-radius: Theme.r-sm;
    background: root.level == "fail" ? Theme.danger-soft
        : (root.level == "warn" ? Theme.field-hover : Theme.field);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            vertical-stretch: 1;
            text: root.line;
            color: root.level == "fail" ? Theme.danger : Theme.fg;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <Glyph> glyph;
    in property <bool> current;
    callback picked();

    height: 38px;
    border-radius: Theme.r-sm;
    background: root.current ? Theme.accent-soft : (touch.has-hover ? Theme.field-hover : transparent);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 7px;
        Icon {
            glyph: root.glyph;
            size: 13px;
            tint: root.current ? Theme.accent : Theme.fg-muted;
        }
        VerticalLayout {
            alignment: center;
            vertical-stretch: 1;
            Text {
                text: root.label;
                color: root.current ? Theme.fg : Theme.fg-muted;
                font-size: Theme.fs-sm;
                font-weight: root.current ? Theme.weight-title : Theme.weight-body;
            }
            Text {
                text: root.note;
                color: Theme.fg-dim;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// ── ① 提示词引擎 ─────────────────────────────────────────────────────

component PromptPage inherits VerticalLayout {
    in property <Pro3Data> data;
    in property <[Pro3Row]> elements;
    in property <[Pro3Row]> costs;
    in property <[Pro3Row]> variants;
    callback act(action: string, index: int, text: string);

    spacing: 8px;

    Card {
        title: "提示词引擎 · 12 要素中英提示词 + 成本估算";
        Note {
            text: "接口：GET /prompt/{health,templates,models,pricing}、POST /prompt/build、POST /prompt/estimate。免费生成提示词与成本；「送生成」在网页版（需登录与积分）。";
        }
        HorizontalLayout {
            spacing: 6px;
            Button { label: "场景模板：" + root.data.pp-template-label; clicked => { root.act("pp-next-template", 0, ""); } }
            Button { label: "模型模板：" + root.data.pp-model-label; clicked => { root.act("pp-next-model", 0, ""); } }
            Button { label: "画幅：" + root.data.pp-aspect-label; clicked => { root.act("pp-next-aspect", 0, ""); } }
            Button { label: "语言：" + root.data.pp-language-label; clicked => { root.act("pp-next-language", 0, ""); } }
            Button { label: "载入模板 / 模型清单"; clicked => { root.act("pp-load", 0, ""); } }
        }
    }

    Card {
        title: "表单（角色 / 场景 / 镜头）";
        HorizontalLayout {
            spacing: 8px;
            Field { value: root.data.pp-name; placeholder: "角色名（原创）"; edited(t) => { root.act("pp-name", 0, t); } }
            Field { value: root.data.pp-look; placeholder: "外形：年龄 / 特征 / 眼神"; edited(t) => { root.act("pp-look", 0, t); } }
            Field { value: root.data.pp-wardrobe; placeholder: "服装：材质 / 颜色 / 时代"; edited(t) => { root.act("pp-wardrobe", 0, t); } }
        }
        HorizontalLayout {
            spacing: 8px;
            Field { value: root.data.pp-location; placeholder: "地点"; edited(t) => { root.act("pp-location", 0, t); } }
            Field { value: root.data.pp-time; placeholder: "时间（黄昏 / 深夜…）"; edited(t) => { root.act("pp-time", 0, t); } }
            Field { value: root.data.pp-weather; placeholder: "天气 / 氛围"; edited(t) => { root.act("pp-weather", 0, t); } }
        }
        HorizontalLayout {
            spacing: 8px;
            Field { value: root.data.pp-mood; placeholder: "情绪（孤独克制 / 紧张不安…）"; edited(t) => { root.act("pp-mood", 0, t); } }
            Field { value: root.data.pp-duration; placeholder: "时长（秒）"; technical: true; edited(t) => { root.act("pp-duration", 0, t); } }
            Button { label: "生成提示词（build）"; primary: true; clicked => { root.act("pp-build", 0, ""); } }
            Button { label: "只估成本"; clicked => { root.act("pp-estimate", 0, ""); } }
        }
        AreaText {
            value: root.data.pp-notes;
            placeholder: "补充备注：构图 / 运镜 / 光线 / 禁止项（选填）";
            box-height: 72px;
            edited(t) => { root.act("pp-notes", 0, t); }
        }
    }

    if root.data.pp-line != "": Card {
        title: "质量自检 / 成本";
        Hint { text: root.data.pp-line; }
        KV { k: "成本"; v: root.data.pp-cost; }
        KV { k: "质量"; v: root.data.pp-quality; }
        for entry in root.costs: RowLine { entry: entry; }
    }

    if root.data.pp-zh != "": Card {
        title: "中文提示词";
        HorizontalLayout {
            Button { label: "复制中文"; clicked => { zh-copy.select-all(); zh-copy.copy(); } }
            Button { label: "复制英文"; clicked => { en-copy.select-all(); en-copy.copy(); } }
        }
        Text { text: root.data.pp-zh; color: Theme.fg; font-size: Theme.fs-sm; wrap: word-wrap; }
        Text { text: root.data.pp-en; color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; }
        Note { text: root.data.pp-model-prompt; }
        Rectangle {
            height: 1px;
            zh-copy := TextInput { x: 0; y: 0; width: 1px; height: 1px; opacity: 0; text: root.data.pp-zh; read-only: true; }
        }
        Rectangle {
            height: 1px;
            en-copy := TextInput { x: 0; y: 0; width: 1px; height: 1px; opacity: 0; text: root.data.pp-en; read-only: true; }
        }
    }

    if root.data.pp-zh != "": Card {
        title: "12 要素（结构化）";
        for entry in root.elements: RowLine { entry: entry; }
    }

    if root.data.pp-zh != "": Card {
        title: "模型模板切换（同一 12 要素，按模型排序）";
        for entry[i] in root.variants: RowLine {
            entry: entry;
            action-label: "用此模板";
            acted => { root.act("pp-use-model", i, ""); }
        }
    }
}

// ── ② 风格库 ─────────────────────────────────────────────────────────

component StylelibPage inherits VerticalLayout {
    in property <Pro3Data> data;
    in property <[Pro3Row]> styles;
    in property <[Pro3Row]> guides;
    in property <image> preview;
    in property <bool> has-preview;
    callback act(action: string, index: int, text: string);

    spacing: 8px;

    Card {
        title: "导演风格库 · 20 风格卡片 + 构图辅助线";
        Note {
            text: "接口：GET /stylelib/list、GET /stylelib/{style_id}、POST /stylelib/composition-guide、GET /stylelib/guide/{id}.png、GET /stylelib/lut/{id}.cube。风格为参考（非授权/联名），不复刻具体画面。";
        }
        HorizontalLayout {
            spacing: 8px;
            Button { label: "载入 20 个风格"; primary: true; clicked => { root.act("sl-load", 0, ""); } }
            Hint { text: root.data.sl-count; vertical-alignment: center; }
        }
    }

    Card {
        title: "风格卡片";
        for entry[i] in root.styles: RowLine {
            entry: entry;
            clickable: true;
            picked => { root.act("sl-pick", i, ""); }
        }
    }

    if root.data.sl-detail != "": Card {
        title: "风格详情 · " + root.data.sl-style-id;
        Hint { text: root.data.sl-detail; }
        HorizontalLayout {
            spacing: 6px;
            Text { text: "构图辅助线"; color: Theme.fg-dim; font-size: Theme.fs-xs; vertical-alignment: center; }
            for entry[i] in root.guides: Chip {
                label: entry.label;
                current: root.data.sl-guide == i;
                picked => { root.act("sl-guide", i, ""); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Text { text: "画幅"; color: Theme.fg-dim; font-size: Theme.fs-xs; vertical-alignment: center; }
            for label[i2] in ["16:9", "9:16", "2.39:1", "1:1"]: Chip {
                label: label;
                current: root.data.sl-ratio == i2;
                picked => { root.act("sl-ratio", i2, ""); }
            }
            Button { label: "生成构图辅助线预览"; primary: true; clicked => { root.act("sl-preview", 0, ""); } }
            Button { label: "下载 LUT"; clicked => { root.act("sl-lut", 0, ""); } }
        }
        if root.has-preview: Image {
            height: 260px;
            source: root.preview;
            image-fit: contain;
        }
        Note { text: root.data.sl-preview-line; }
    }
}

// ── ③ 项目资产文件库 ─────────────────────────────────────────────────

component IndexPage inherits VerticalLayout {
    in property <Pro3Data> data;
    in property <[Pro3Row]> projects;
    in property <[Pro3Row]> tree;
    in property <[Pro3Row]> items;
    callback act(action: string, index: int, text: string);

    spacing: 8px;

    Card {
        title: "项目资产文件库 · 项目 → 类型树 → 条目 → 版本 / 影响 / 导出";
        Note {
            text: "接口：GET /index/projects、/index/tree、/index/search、/index/item/{id}、/index/item/{id}/versions、/index/item/{id}/impact、/index/export/{project_id}。预览链接为服务端 DLP 签名地址。";
        }
        HorizontalLayout {
            spacing: 8px;
            Button { label: "载入项目与类型树"; primary: true; clicked => { root.act("ix-load", 0, ""); } }
            Field {
                value: root.data.ix-query;
                placeholder: "全库搜索：台词 / 镜头 / 角色…";
                edited(t) => { root.act("ix-query", 0, t); }
            }
            Button { label: "搜索"; clicked => { root.act("ix-search", 0, ""); } }
            Button { label: "导出清单 HTML"; clicked => { root.act("ix-export", 0, ""); } }
        }
        KV { k: "当前项目"; v: root.data.ix-project-label; }
        KV { k: "当前类型"; v: root.data.ix-type-label; }
        Hint { text: root.data.ix-line; }
    }

    Card {
        title: "项目";
        for entry[i] in root.projects: RowLine {
            entry: entry;
            clickable: true;
            picked => { root.act("ix-project", i, ""); }
        }
    }

    Card {
        title: "类型树（五阶段）";
        for entry[i] in root.tree: RowLine {
            entry: entry;
            clickable: true;
            picked => { root.act("ix-type", i, ""); }
        }
    }

    if root.items.length > 0: Card {
        title: "条目";
        for entry[i] in root.items: RowLine {
            entry: entry;
            clickable: true;
            picked => { root.act("ix-item", i, ""); }
        }
    }

    if root.data.ix-detail != "": Card {
        title: "条目详情";
        HorizontalLayout {
            spacing: 8px;
            Button { label: "看版本历史"; clicked => { root.act("ix-versions", 0, ""); } }
            Button { label: "影响分析"; clicked => { root.act("ix-impact", 0, ""); } }
            Button { label: "导出清单 HTML"; clicked => { root.act("ix-export", 0, ""); } }
        }
        Hint { text: root.data.ix-detail; }
    }
}

// ── ④ AI 审美总监 ────────────────────────────────────────────────────

component AestheticPage inherits VerticalLayout {
    in property <Pro3Data> data;
    in property <[Pro3Row]> samples;
    in property <[Pro3Row]> cats;
    in property <[Pro3Row]> issues;
    in property <image> preview;
    in property <bool> has-preview;
    callback act(action: string, index: int, text: string);

    spacing: 8px;

    Card {
        title: "AI 审美总监 · 分数 + 分项问题 + HTML 报告";
        Note {
            text: "接口：POST /aesthetic/analyze（video_url 或 sample；本地成片先上传换 URL）、GET /aesthetic/report/{id}。规则 + 启发式（零付费视觉模型），结果需人工复核。";
        }
        HorizontalLayout {
            spacing: 6px;
            Text { text: "内置样片"; color: Theme.fg-dim; font-size: Theme.fs-xs; vertical-alignment: center; }
            for entry[i] in root.samples: Chip {
                label: entry.label;
                current: root.data.ae-sample == i;
                picked => { root.act("ae-sample", i, ""); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Field {
                value: root.data.ae-source;
                placeholder: "片源 URL（平台可下载地址）";
                edited(t) => { root.act("ae-source", 0, t); }
            }
            Button { label: "选本地成片（上传）"; clicked => { root.act("ae-pick", 0, ""); } }
            Button { label: "开始审美分析"; primary: true; clicked => { root.act("ae-analyze", 0, ""); } }
            Button { label: "打开报告"; enabled: root.data.ae-report != ""; clicked => { root.act("ae-report", 0, ""); } }
        }
        if root.has-preview: Image {
            height: 200px;
            source: root.preview;
            image-fit: contain;
        }
        Hint { text: root.data.ae-line; }
        if root.data.ae-score != "": HorizontalLayout {
            spacing: 14px;
            Text { text: root.data.ae-score; color: Theme.accent; font-size: 40px; font-weight: 700; }
            VerticalLayout {
                alignment: center;
                Text { text: "评级：" + root.data.ae-grade; color: Theme.fg; font-size: Theme.fs-lg; }
                Text { text: root.data.ae-summary; color: Theme.fg-muted; font-size: Theme.fs-xs; wrap: word-wrap; }
            }
        }
    }

    if root.cats.length > 0: Card {
        title: "分项得分";
        for entry in root.cats: RowLine { entry: entry; }
    }

    if root.issues.length > 0: Card {
        title: "问题清单";
        for entry in root.issues: RowLine { entry: entry; }
    }
}

// ── ⑤ 视频反推 ───────────────────────────────────────────────────────

component ReversePage inherits VerticalLayout {
    in property <Pro3Data> data;
    in property <[Pro3Row]> samples;
    in property <[Pro3Row]> shots;
    in property <image> preview;
    in property <bool> has-preview;
    callback act(action: string, index: int, text: string);

    spacing: 8px;

    Card {
        title: "视频反推 · 分镜 + 可复制提示词";
        Note {
            text: "接口：POST /reverse/analyze（video_url / sample_id；异步任务）、GET /reverse/job/{id}、GET /reverse/report/{id}。零付费视觉模型：本地 scdet + ASR + 文本 LLM，画面语义需人工复核。";
        }
        HorizontalLayout {
            spacing: 6px;
            Text { text: "内置样片"; color: Theme.fg-dim; font-size: Theme.fs-xs; vertical-alignment: center; }
            for entry[i] in root.samples: Chip {
                label: entry.label;
                current: root.data.rv-sample == i;
                picked => { root.act("rv-sample", i, ""); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Field {
                value: root.data.rv-source;
                placeholder: "本地文件（上传）或视频 URL";
                edited(t) => { root.act("rv-source", 0, t); }
            }
            Button { label: "选本地文件（上传）"; clicked => { root.act("rv-pick", 0, ""); } }
            Button { label: "开始反推（analyze）"; primary: true; clicked => { root.act("rv-analyze", 0, ""); } }
            Button { label: "打开报告"; enabled: root.data.rv-report != ""; clicked => { root.act("rv-report", 0, ""); } }
        }
        if root.has-preview: Image {
            height: 180px;
            source: root.preview;
            image-fit: contain;
        }
        Hint { text: root.data.rv-line; }
        if root.data.rv-status != "": Note { text: "任务状态：" + root.data.rv-status; }
    }

    if root.shots.length > 0: Card {
        title: "分镜（时间 / 景别 / 运镜 / 动作 / 台词）";
        for entry in root.shots: RowLine { entry: entry; }
    }

    if root.data.rv-prompt-zh != "": Card {
        title: "反推提示词（可复制）";
        HorizontalLayout {
            Button { label: "复制中文提示词"; clicked => { rz.select-all(); rz.copy(); } }
            Button { label: "复制英文提示词"; clicked => { re.select-all(); re.copy(); } }
        }
        Text { text: root.data.rv-prompt-zh; color: Theme.fg; font-size: Theme.fs-sm; wrap: word-wrap; }
        Note { text: root.data.rv-prompt-en; }
        Rectangle {
            height: 1px;
            rz := TextInput { x: 0; y: 0; width: 1px; height: 1px; opacity: 0; text: root.data.rv-prompt-zh; read-only: true; }
        }
        Rectangle {
            height: 1px;
            re := TextInput { x: 0; y: 0; width: 1px; height: 1px; opacity: 0; text: root.data.rv-prompt-en; read-only: true; }
        }
    }
}

// ── ⑥ 自愈剪辑 ───────────────────────────────────────────────────────

component HealPage inherits VerticalLayout {
    in property <Pro3Data> data;
    in property <[Pro3Row]> issues;
    in property <[Pro3Row]> plan;
    in property <image> preview;
    in property <bool> has-preview;
    callback act(action: string, index: int, text: string);

    spacing: 8px;

    Card {
        title: "自愈剪辑 · 问题清单 / 修复方案 / 补拍清单";
        Note {
            text: "接口：POST /heal/analyze（video_url）、POST /heal/plan（run_id）、POST /heal/reshoot-list、GET /heal/report/{run_id}。检测为参考值，修复只做技术性校正（调色 / 响度 / 过渡 / 画幅 / 字幕），不改剧情、不换脸。";
        }
        HorizontalLayout {
            spacing: 8px;
            Field {
                value: root.data.hl-source;
                placeholder: "成片 URL（本地文件会先上传）";
                edited(t) => { root.act("hl-source", 0, t); }
            }
            Button { label: "选本地成片（上传）"; clicked => { root.act("hl-pick", 0, ""); } }
            Button { label: "开始自愈分析"; primary: true; clicked => { root.act("hl-analyze", 0, ""); } }
            Button { label: "生成修复方案"; enabled: root.data.hl-run != ""; clicked => { root.act("hl-plan", 0, ""); } }
            Button { label: "补拍清单"; enabled: root.data.hl-run != ""; clicked => { root.act("hl-reshoot", 0, ""); } }
            Button { label: "打开报告"; enabled: root.data.hl-report != ""; clicked => { root.act("hl-report", 0, ""); } }
        }
        if root.has-preview: Image {
            height: 180px;
            source: root.preview;
            image-fit: contain;
        }
        Hint { text: root.data.hl-line; }
        if root.data.hl-counts != "": KV { k: "统计"; v: root.data.hl-counts; }
        if root.data.hl-reshoot-line != "": Note { text: root.data.hl-reshoot-line; }
    }

    if root.issues.length > 0: Card {
        title: "问题清单";
        for entry in root.issues: RowLine { entry: entry; }
    }

    if root.plan.length > 0: Card {
        title: "修复方案 / 补拍项";
        for entry in root.plan: RowLine { entry: entry; }
    }
}

// ── ⑦ 补机位 ─────────────────────────────────────────────────────────

component MulticamPage inherits VerticalLayout {
    in property <Pro3Data> data;
    in property <[Pro3Row]> modes;
    in property <[Pro3Row]> rows;
    in property <image> preview;
    in property <bool> has-preview;
    callback act(action: string, index: int, text: string);

    spacing: 8px;

    Card {
        title: "补机位 · 二次构图 7 模式 + AI 补机位";
        Note {
            text: "接口：GET /multicam/{health,modes}、POST /multicam/reframe（真实 ffmpeg 渲染，免费）、POST /multicam/suggest、GET /multicam/providers。二次构图不是新视角（同素材裁剪 / 变焦 / 镜像 / 重构）；AI 补机位是付费视频生成，本版本只接入口并如实显示余额。片段需平台可访问的 URL（已预填平台 20s 样片）；本地文件直链会被平台下载门禁 403，需先放到平台素材库。";
        }
        HorizontalLayout {
            spacing: 8px;
            Field {
                value: root.data.mc-source;
                placeholder: "片段 URL（需平台可访问；已预填样片）";
                edited(t) => { root.act("mc-source", 0, t); }
            }
            Field {
                value: root.data.mc-zoom;
                placeholder: "参数（推近 0.30 / 裁切 1.35…）";
                technical: true;
                edited(t) => { root.act("mc-zoom", 0, t); }
            }
            Button { label: "载入 7 种模式"; clicked => { root.act("mc-load", 0, ""); } }
            Button { label: "填入平台样片"; clicked => { root.act("mc-sample", 0, ""); } }
            Button { label: "二次构图（reframe）"; primary: true; clicked => { root.act("mc-reframe", 0, ""); } }
        }
        HorizontalLayout {
            spacing: 6px;
            for entry[i] in root.modes: Chip {
                label: entry.label;
                current: root.data.mc-mode == i;
                picked => { root.act("mc-mode", i, ""); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Button { label: "AI 补机位建议（suggest）"; clicked => { root.act("mc-suggest", 0, ""); } }
            Button { label: "AI 补机位（查余额）"; clicked => { root.act("mc-ai", 0, ""); } }
            Button { label: "下载成片"; enabled: root.data.mc-output != ""; clicked => { root.act("mc-download", 0, ""); } }
            Button { label: "插入时间线"; enabled: root.data.mc-output != ""; clicked => { root.act("mc-insert", 0, ""); } }
        }
        if root.has-preview: Image {
            height: 240px;
            source: root.preview;
            image-fit: contain;
        }
        if root.data.mc-line != "": Hint { text: root.data.mc-line; }
        if root.data.mc-ai-line != "": Note { text: root.data.mc-ai-line; }
        if root.data.mc-poster-line != "": Note { text: root.data.mc-poster-line; }
    }

    if root.rows.length > 0: Card {
        title: "结果 / 建议";
        for entry in root.rows: RowLine { entry: entry; }
    }
}

// ── ⑧ 节点画布 / 导演脑 ──────────────────────────────────────────────

component CanvasPage inherits VerticalLayout {
    in property <Pro3Data> data;
    in property <[Pro3Row]> templates;
    in property <[Pro3Row]> styles;
    callback act(action: string, index: int, text: string);

    spacing: 8px;

    Card {
        title: "节点画布 · 导演脑（入口）";
        Note {
            text: "接口：GET /canvas/{health,templates}、GET /brain/{health,styles}。网页版专业工具已按产品线分离升级为桌面面板；这里两个入口打开的是「外部页面」，会跳出浏览器窗口，不是桌面内嵌。";
        }
        HorizontalLayout {
            spacing: 8px;
            Button { label: "载入画布模板与导演脑风格"; primary: true; clicked => { root.act("nc-load", 0, ""); } }
            Button {
                label: "打开节点画布网页版（外部页面）";
                clicked => { root.act("nc-canvas-web", 0, ""); }
            }
            Button {
                label: "打开导演脑接口说明（外部页面）";
                clicked => { root.act("nc-brain-web", 0, ""); }
            }
        }
        Hint { text: root.data.nc-line; }
        Hint { text: root.data.nc-brain-line; }
        Note { text: "节点画布：" + root.data.nc-canvas-web; }
        Note { text: "导演脑：" + root.data.nc-brain-web; }
    }

    Card {
        title: "节点画布模板（GET /api/canvas/templates）";
        for entry in root.templates: RowLine { entry: entry; }
    }

    Card {
        title: "导演脑内置风格（GET /api/brain/styles）";
        for entry in root.styles: RowLine { entry: entry; }
    }
}

// ── 面板 ─────────────────────────────────────────────────────────────

export component Pro3Dialog inherits Modal {
    in property <Pro3Data> data;
    in property <[Pro3Row]> pp-elements;
    in property <[Pro3Row]> pp-costs;
    in property <[Pro3Row]> pp-variants;
    in property <[Pro3Row]> sl-styles;
    in property <[Pro3Row]> sl-guides;
    in property <[Pro3Row]> ix-projects;
    in property <[Pro3Row]> ix-tree;
    in property <[Pro3Row]> ix-items;
    in property <[Pro3Row]> ae-samples;
    in property <[Pro3Row]> ae-cats;
    in property <[Pro3Row]> ae-issues;
    in property <[Pro3Row]> rv-samples;
    in property <[Pro3Row]> rv-shots;
    in property <[Pro3Row]> hl-issues;
    in property <[Pro3Row]> hl-plan;
    in property <[Pro3Row]> mc-modes;
    in property <[Pro3Row]> mc-rows;
    in property <[Pro3Row]> nc-templates;
    in property <[Pro3Row]> nc-styles;
    in property <image> preview;
    in property <bool> has-preview;

    callback action(action: string, index: int, text: string);
    callback tick();

    open: root.data.open;
    title: "影视专业 · 0.5.0";
    glyph: Glyph.film;
    surface-width: 1380px;
    surface-height: 880px;

    Timer {
        interval: 1500ms;
        running: root.data.open;
        triggered => { root.tick(); }
    }

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        // ── 左侧导航 ──
        Rectangle {
            width: 196px;
            background: Theme.well;
            border-radius: Theme.r;
            border-width: 1px;
            border-color: Theme.line;

            VerticalLayout {
                padding: 8px;
                spacing: 3px;

                Text {
                    text: "影视专业 0.5.0";
                    color: Theme.fg;
                    font-size: Theme.fs-lg;
                    font-weight: Theme.weight-display;
                }
                Text {
                    text: "提示词 · 风格库 · 项目库 · 审美 · 反推 · 自愈 · 补机位 · 画布";
                    color: Theme.fg-dim;
                    font-size: Theme.fs-xs;
                    wrap: word-wrap;
                }

                Rectangle { height: 6px; }

                Text { text: "创作"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                NavItem {
                    label: "提示词引擎";
                    note: "12 要素 · 中英 · 成本";
                    glyph: Glyph.sparkle;
                    current: root.data.tab == 0;
                    picked => { root.action("tab", 0, ""); }
                }
                NavItem {
                    label: "导演风格库";
                    note: "20 风格 · 构图辅助线";
                    glyph: Glyph.image;
                    current: root.data.tab == 1;
                    picked => { root.action("tab", 1, ""); }
                }
                NavItem {
                    label: "项目资产文件库";
                    note: "类型树 · 版本 · 影响";
                    glyph: Glyph.folder;
                    current: root.data.tab == 2;
                    picked => { root.action("tab", 2, ""); }
                }

                Text { text: "审片"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                NavItem {
                    label: "AI 审美总监";
                    note: "分数 · 问题 · 报告";
                    glyph: Glyph.check;
                    current: root.data.tab == 3;
                    picked => { root.action("tab", 3, ""); }
                }
                NavItem {
                    label: "视频反推";
                    note: "分镜 · 提示词";
                    glyph: Glyph.eye;
                    current: root.data.tab == 4;
                    picked => { root.action("tab", 4, ""); }
                }
                NavItem {
                    label: "自愈剪辑";
                    note: "问题 · 修复 · 补拍";
                    glyph: Glyph.sparkle;
                    current: root.data.tab == 5;
                    picked => { root.action("tab", 5, ""); }
                }
                NavItem {
                    label: "补机位";
                    note: "二次构图 7 模式";
                    glyph: Glyph.image;
                    current: root.data.tab == 6;
                    picked => { root.action("tab", 6, ""); }
                }

                Text { text: "编排"; color: Theme.fg-dim; font-size: Theme.fs-xs; }
                NavItem {
                    label: "节点画布 / 导演脑";
                    note: "外部页面入口";
                    glyph: Glyph.link;
                    current: root.data.tab == 7;
                    picked => { root.action("tab", 7, ""); }
                }

                Rectangle { vertical-stretch: 1; }

                Text {
                    text: root.data.signed-in ? "已登录星籁账号" : "未登录：读接口仍可用；上传后可分析";
                    color: root.data.signed-in ? Theme.fg-dim : Theme.accent;
                    font-size: Theme.fs-xs;
                    wrap: word-wrap;
                }
            }
        }

        // ── 右侧内容 ──
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;

            Hint { text: root.data.hint; }

            if root.data.tab == 0: PaneScroll {
                vertical-stretch: 1;
                PromptPage {
                    data: root.data;
                    elements: root.pp-elements;
                    costs: root.pp-costs;
                    variants: root.pp-variants;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }
            if root.data.tab == 1: PaneScroll {
                vertical-stretch: 1;
                StylelibPage {
                    data: root.data;
                    styles: root.sl-styles;
                    guides: root.sl-guides;
                    preview: root.preview;
                    has-preview: root.has-preview;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }
            if root.data.tab == 2: PaneScroll {
                vertical-stretch: 1;
                IndexPage {
                    data: root.data;
                    projects: root.ix-projects;
                    tree: root.ix-tree;
                    items: root.ix-items;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }
            if root.data.tab == 3: PaneScroll {
                vertical-stretch: 1;
                AestheticPage {
                    data: root.data;
                    samples: root.ae-samples;
                    cats: root.ae-cats;
                    issues: root.ae-issues;
                    preview: root.preview;
                    has-preview: root.has-preview;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }
            if root.data.tab == 4: PaneScroll {
                vertical-stretch: 1;
                ReversePage {
                    data: root.data;
                    samples: root.rv-samples;
                    shots: root.rv-shots;
                    preview: root.preview;
                    has-preview: root.has-preview;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }
            if root.data.tab == 5: PaneScroll {
                vertical-stretch: 1;
                HealPage {
                    data: root.data;
                    issues: root.hl-issues;
                    plan: root.hl-plan;
                    preview: root.preview;
                    has-preview: root.has-preview;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }
            if root.data.tab == 6: PaneScroll {
                vertical-stretch: 1;
                MulticamPage {
                    data: root.data;
                    modes: root.mc-modes;
                    rows: root.mc-rows;
                    preview: root.preview;
                    has-preview: root.has-preview;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }
            if root.data.tab == 7: PaneScroll {
                vertical-stretch: 1;
                CanvasPage {
                    data: root.data;
                    templates: root.nc-templates;
                    styles: root.nc-styles;
                    act(a, i, t) => { root.action(a, i, t); }
                }
            }

            if root.data.pv-line != "": Note { text: root.data.pv-line; }

            StatusBar {
                line: root.data.status-line;
                level: root.data.status-level;
            }
        }
    }
}
